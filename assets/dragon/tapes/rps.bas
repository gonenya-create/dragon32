10 CLS 2
20 PRINT "ROCK, PAPER, SCISSORS"
30 PRINT "FIRST TO 3 WINS"
40 P=0:C=0
50 INPUT "R, P OR S";M$
60 IF M$<>"R" AND M$<>"P" AND M$<>"S" THEN PRINT "TYPE R, P OR S":GOTO 50
70 K=RND(3)
80 IF K=1 THEN K$="R"
90 IF K=2 THEN K$="P"
100 IF K=3 THEN K$="S"
110 PRINT "I CHOSE ";K$
120 IF M$=K$ THEN PRINT "A DRAW":GOTO 50
130 IF M$="R" AND K$="S" OR M$="P" AND K$="R" OR M$="S" AND K$="P" THEN PRINT "YOU TAKE IT":P=P+1:GOTO 150
140 PRINT "I TAKE IT":C=C+1
150 PRINT "YOU";P;"- ME";C
160 IF P<3 AND C<3 THEN 50
170 IF P=3 THEN PRINT "YOU WON THE GAME!":SOUND 200,4:END
180 PRINT "I WON THE GAME!":SOUND 40,4
190 END
