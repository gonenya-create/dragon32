10 CLS 4
20 PRINT "THE DRAGON'S CAVE"
30 PRINT
40 PRINT "A DARK CAVE. SMOKE COMES OUT."
50 PRINT "1=GO IN  2=WALK AWAY"
60 INPUT C
70 IF C<>1 THEN PRINT "SAFE, BUT NO STORY. THE END.":END
80 PRINT "TWO TUNNELS. LEFT IS WARM,"
90 PRINT "RIGHT IS COLD AND WET."
100 PRINT "1=LEFT  2=RIGHT"
110 INPUT C
120 IF C=2 THEN 300
130 PRINT "A DRAGON SLEEPS ON GOLD."
140 PRINT "1=TAKE GOLD  2=SNEAK PAST"
150 INPUT C
160 IF C=2 THEN 400
170 IF RND(2)=1 THEN PRINT "IT SNORES ON. YOU GOT RICH!":GOTO 900
180 PRINT "IT WAKES UP! FIRE! YOU RUN."
190 PRINT "SINGED, BUT ALIVE. THE END.":END
300 PRINT "AN UNDERGROUND LAKE. A BOAT."
310 PRINT "1=TAKE THE BOAT  2=SWIM"
320 INPUT C
330 IF C=2 THEN PRINT "TOO COLD! BACK OUTSIDE.":GOTO 40
340 PRINT "THE BOAT FLOATS TO A SECRET"
350 PRINT "EXIT FULL OF GEMS!":GOTO 900
400 PRINT "YOU SNEAK PAST AND FIND"
410 PRINT "AN EGG. IT CRACKS OPEN..."
420 PRINT "A BABY DRAGON! A NEW FRIEND."
900 PRINT "*** YOU WIN ***"
910 FOR I=1 TO 8:SOUND 80+I*20,1:NEXT I
920 END
