10 CLS 0
20 PRINT "LUNAR LANDER"
30 PRINT "LAND WITH SPEED UNDER 5."
40 PRINT "EACH TURN, BURN 0-30 FUEL."
50 H=300:V=30:F=150:T=0
60 PRINT "ALT";INT(H+0.9);"SPEED";INT(V);"FUEL";F
70 INPUT "BURN";B
80 IF B<0 OR B>30 THEN PRINT "0 TO 30 ONLY":GOTO 70
90 IF B>F THEN B=F
100 F=F-B:T=T+1
110 V=V+3-B/2:H=H-V
120 IF H>0 THEN 60
130 IF V<5 THEN PRINT "SOFT LANDING IN";T;"TURNS!":GOTO 170
140 IF V<12 THEN PRINT "HARD LANDING. DENTED, ALIVE.":END
150 PRINT "CRASH AT SPEED";INT(V);"!"
160 SOUND 5,10:END
170 FOR I=1 TO 6:SOUND 120+I*20,1:NEXT I
180 END
