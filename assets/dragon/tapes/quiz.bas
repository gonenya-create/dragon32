10 CLS 6
20 PRINT "MATH QUIZ: 10 QUESTIONS"
30 S=0
40 FOR Q=1 TO 10
50 A=RND(12):B=RND(12):R=RND(2)
60 IF R=1 THEN PRINT A;"+";B;"=";:X=A+B
70 IF R=2 THEN PRINT A;"X";B;"=";:X=A*B
80 INPUT C
90 IF C=X THEN PRINT "CORRECT!":S=S+1:SOUND 200,1:GOTO 110
100 PRINT "NO, IT IS";X
110 NEXT Q
120 PRINT "SCORE:";S;"OUT OF 10"
130 IF S=10 THEN PRINT "PERFECT!":FOR I=1 TO 6:SOUND 100+I*25,1:NEXT I
140 END
