                      ; Dragon 1982 BASIC: המפרש. שורות ממוספרות, משתנים, ופקודות: PRINT LET GOTO IF..THEN FOR..NEXT END STOP REM
                      ; LIST RUN NEW CLS. נכתב מאפס.
                      ;
                      ; התוכנית בזיכרון, מ-PROGST: רשומות [קישור 2][מספר שורה 2][טקסט][0], ובסוף קישור 0000.
                      ; בניסוי הזה הטקסט נשמר כמו שהוקלד (בלי קיצור למילים שמורות). המשתנים אחרי התוכנית: [שם 2][ערך 5].
                      
6000                  STRLOW          equ     $6000           ; מכאן ומעלה (עד $7E00): מחרוזות. מתחת: תוכנית, משתנים ומערכים
1E00                  PROGST          equ     $1e00           ; אחרי 4 עמודי הגרפיקה ($0600-$1DFF), כמו במקור
7F00                  FORBASE         equ     $7f00           ; מחסנית ה-FOR (עולה מ-$7F00; מחסנית המעבד יורדת ממנו)
0010                  FORLEN          equ     16              ; [שם 2][עד 5][צעד 5][רשומה 2][טקסט 2]
0090                  PROGEND         equ     $90             ; אחרי הקישור 0000 שבסוף התוכנית
0092                  VARTOP          equ     $92             ; סוף טבלת המשתנים
0094                  CURLN           equ     $94             ; הרשומה שרצה עכשיו (0 = פקודה ישירה)
0096                  FORSP           equ     $96
0098                  LINNUM          equ     $98             ; מספר שורה זמני
009A                  VARPTR          equ     $9a             ; כתובת הערך של המשתנה האחרון
009C                  VNAME           equ     $9c             ; שם המשתנה האחרון (2 תווים)
009E                  TMPP            equ     $9e
00A6                  ARYEND          equ     $a6             ; סוף המערכים (המערכים מ-VARTOP עד ARYEND; ראו stmt2.s)
00A0                  LINPTR          equ     $a0
00A3                  FORNAME         equ     $a3
00A2                  JUMPED          equ     $a2             ; קפיצה (GOTO, RUN): ממשיכים מתחילת פקודה, בלי לבדוק : או סוף שורה
                      
