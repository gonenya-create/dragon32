8062 CC7FFE                           ldd     #$7ffe          ; קורא: גבול ה-RAM
8065 DD74                             std     ENDMEM
8067 CC0C00                           ldd     #$0c00          ; קורא: מצב הגרפיקה בהדלקה — PMODE 0, דף 1, דפים מ-$0600
806A DDB7                             std     SCTOP
806C 8606                             lda     #$06
806E 97BC                             sta     SCRBAS
8070 CC01A9                           ldd     #TEMPST
8073 DD0B                             std     TEMPPT
8075 CC804F                           ldd     #$804f          ; קורא: זרע ה-RND, 80 4F C7 52 59
8078 FD0115                           std     $0115
807B CCC752                           ldd     #$c752
807E FD0117                           std     $0117
8081 8659                             lda     #$59
8083 B70119                           sta     $0119
8086 CC0134                           ldd     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
8089 DDB0                             std     USTBAD
808B 8E0134                           ldx     #USRTAB
808E 338C68                           leau    err_fc,pcr
8091 EF81             1               stu     ,x++
8093 8C0148                           cmpx    #USRTAB+20
8096 25F9                             blo     1B
8098 308D1BDA                         leax    execrts,pcr     ; EXEC בלי כתובת אחרי ההדלקה: אצלנו חוזר מיד (ב-Dragon: פתוח)
809C 9F9D                             stx     EXECJP
809E 1701B0                           lbsr    scrtch
80A1 308D048E                         leax    banner,pcr
80A5 1730C2                           lbsr    puts
80A8 9689             main_ok         lda     CURSOR+1
80AA 841F                             anda    #$1f
80AC 2705                             beq     1F
80AE 860D                             lda     #13
80B0 173024                           lbsr    putc
80B3 308D046D         1               leax    m_ok,pcr
80B7 1730B0                           lbsr    puts
80BA 170407           main            lbsr    getline
80BD 25E9                             bcs     main_ok         ; BREAK
80BF 8E02DD                           ldx     #LINBUF
80C2 170374                           lbsr    skipsp
80C5 27F3                             beq     main            ; שורה ריקה
80C7 8130                             cmpa    #'0
80C9 250E                             blo     1F
80CB 8139                             cmpa    #'9
80CD 220A                             bhi     1F
80CF 1700DE                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80D2 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80D5 6FE2                             clr     ,-s
80D7 20E1                             bra     main
80D9 17019D           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80DC 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80DE 6FC0                             clr     ,u+
80E0 8E01D9                           ldx     #CRB-1
80E3 9FA6                             stx     TXTPTR
80E5 CCFFFF                           ldd     #$ffff
80E8 DD68                             std     CURLIN
80EA 160CBE                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
80ED 20B9             endcon          bra     main_ok
                      
                      ; ---------- שגיאות (mit: ERROR) ----------
80EF CC534E           err_sn          ldd     #'S*256+'N
