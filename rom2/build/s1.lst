                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
ADF1 3031323334353637 KEYMAP          fcc     "01234567"
ADF9 38393A3B2C2D2E2F                 fcc     "89:;,-./"
AE01 4041424344454647                 fcc     "@ABCDEFG"
AE09 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
AE11 5051525354555657                 fcc     "PQRSTUVW"
AE19 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
AE21 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
AE29 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
AE31 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
AE39 3434             keyindex        pshs    b,x,y
AE3B 108EADF1                         ldy     #KEYMAP
AE3F 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
AE42 5F                               clrb                    ; עמודה
