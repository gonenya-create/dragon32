95D1 20E8                             bra     1B
95D3 301F             8               leax    -1,x            ; סוף השורה: על ה-0; if_do מוצא שם פקודה ריקה (gone3), וממשיכים לשורה הבאה
95D5 9FA6             4               stx     TXTPTR          ; TXTPTR = אחרי ה-ELSE; chrgot ב-if_do ממשיך כמו אחרי THEN
95D7 20D5                             bra     if_do
