8234 DD33                             std     DATPTR
8236 CC01A9                           ldd     #TEMPST
8239 DD0B                             std     TEMPPT
823B CC0000                           ldd     #0              ; אין המשך
823E DD2D                             std     OLDTXT
8240 0F08                             clr     SUBFLG
8242 39                               rts
                      
                      ; ---------- כיווץ (mit: CRUNCH, m6502.asm:1785; כללי ה-Dragon: קורא + ספר) ----------
                      ; X = הטקסט (מסתיים ב-0). הפלט ב-CRB, מסתיים ב-0. U = אחרי ה-0
8243 CE01DA           crunch          ldu     #CRB
8246 7F03F8                           clr     CRMODE
8249 A684             cr_lp           lda     ,x
824B 102700A8                         lbeq    cr_end
