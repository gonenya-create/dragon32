                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
81AD 17029D           storeline       lbsr    linget          ; D = מספר השורה
81B0 DD2B                             std     LINNUM
81B2 17028C                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81B5 1700C2                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81B8 1F30                             tfr     u,d
81BA 8301DA                           subd    #CRB
81BD C30004                           addd    #4              ; קישור + מספר + טקסט + 0
81C0 3406                             pshs    d               ; האורך
81C2 DC2B                             ldd     LINNUM
81C4 17005A                           lbsr    fndlin          ; Y = השורה (C=1 אם קיימת)
81C7 2403                             bcc     1F
