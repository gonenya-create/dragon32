00D9                  DPTR            equ     $d9             ; DRAW: התו הבא
00CF                  GPPTR           equ     $cf             ; GET/PUT: הבית שלפני הנתון הבא במערך
00D1                  GPEND           equ     $d1             ; GET/PUT: הכתובת שאחרי המערך
00D4                  GPBIT           equ     $d4             ; GET/PUT: 0 = בתים, $FF = ביטים
00D5                  GPACT           equ     $d5             ; PUT: הפעולה (ביטים 0-1 לביט מערך 0, ביטים 2-3 לביט 1; בכל זוג: 2 = מחיקה, 1 = היפוך)
00D8                  GPFLG           equ     $d8             ; 0 = GET, 1 = PUT
00CB                  GPRADR          equ     $cb             ; תחילת השורה במסך
00CD                  GPRMSK          equ     $cd             ; המסכה של תחילת השורה
                      
