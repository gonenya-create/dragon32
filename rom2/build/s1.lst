818F EC61                             ldd     1,s
8191 108318FF                         cmpd    #6399           ; מעל 63999: ?SN (קורא: קורא מספרי השורות)
8195 22B5                             bhi     err_sn
8197 58                               lslb
8198 49                               rola
8199 ED61                             std     1,s             ; *2
819B 58                               lslb
819C 49                               rola
