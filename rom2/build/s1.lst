8059 97B7                             sta     SCTOP           ; $0C00 (הבית התחתון כבר 0)
805B 44                               lsra
805C 97BC                             sta     SCRBAS          ; $06
805E 97BA                             sta     GSTART          ; הדף הנוכחי: $0600 (קורא 0.2)
8060 CC0310                           ldd     #$0310          ; כתיבה 3, 16 בתים בשורה (הרקע 0: ה-RAM נוקה)
8063 97B2                             sta     GFORE
8065 D7B9                             stb     GROWB
8067 1726FB                           lbsr    gfxrun
806A CC804F                           ldd     #$804f          ; קורא: זרע ה-RND, 80 4F C7 52 59
806D FD0115                           std     $0115
8070 CCC752                           ldd     #$c752
8073 FD0117                           std     $0117
8076 8659                             lda     #$59
8078 B70119                           sta     $0119
807B 8E0134                           ldx     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
807E 9FB0                             stx     USTBAD
8080 338C6F                           leau    err_fc,pcr
8083 C60A                             ldb     #10
8085 EF81             1               stu     ,x++
8087 5A                               decb
8088 26FB                             bne     1B
808A 308D1833                         leax    execrts,pcr     ; EXEC בלי כתובת אחרי ההדלקה: אצלנו חוזר מיד (ב-Dragon: פתוח)
808E 9F9D                             stx     EXECJP
8090 1701A6                           lbsr    scrtch
8093 308D03F4                         leax    banner,pcr      ; הכותרת ומיד אחריה OK (אחרי 13 אין שורה חדשה נוספת)
8097 2006                             bra     mo_puts
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
8099                  endcon
8099 8D36             main_ok         bsr     condcr
809B 308D0407                         leax    m_ok,pcr
809F 173160           mo_puts         lbsr    puts
80A2 17039E           main            lbsr    getline
80A5 25F2                             bcs     main_ok         ; BREAK
80A7 8E02DD                           ldx     #LINBUF
80AA 1701B1                           lbsr    skipsp
80AD 27F3                             beq     main            ; שורה ריקה
80AF 1701B6                           lbsr    isdig
80B2 240A                             bcc     1F
80B4 1700F4                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80B7 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80BA 6FE2                             clr     ,-s
80BC 20E4                             bra     main
80BE 1701B6           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80C1 4F                               clra                    ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80C2 5F                               clrb
80C3 EDC4                             std     ,u
80C5 8E01D9                           ldx     #CRB-1
80C8 9FA6                             stx     TXTPTR
80CA 43                               coma
80CB 53                               comb
80CC DD68                             std     CURLIN          ; $FFFF
80CE 160AB4                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; condcr: שורה חדשה אם הסמן לא בעמודה 0
80D1 9689             condcr          lda     CURSOR+1
80D3 841F                             anda    #$1f
80D5 2611                             bne     prcr
80D7 39                               rts
                      ; prin: " IN n" אם בתוכנית, ושורה חדשה
80D8 DC68             prin            ldd     CURLIN
80DA 4C                               inca                    ; $FFxx = שורה ישירה (מספרי השורות עד 63999)
80DB 270B                             beq     prcr
80DD 4A                               deca
80DE 308D0098                         leax    m_in,pcr
