                      ; Dragon 1982 BASIC — ניסוי שלב 1 (20.10.2026)
                      ;
                      ; מה נבדק: האם הלב של BASIC-M6502 של Microsoft (רישיון MIT, ראו rom2/mit/LICENSE) עובר טוב לשבב 6809,
                      ; ואיך הוא מתאים לסידור הזיכרון של ה-Dragon 32: שמירת שורה מכווצת, המצביעים בכתובות הקבועות, LIST ו-NEW.
                      ;
                      ; יומן מקור (שלב 1):
                      ;   mit  = תרגום ל-6809 של שגרה מ-rom2/mit/m6502.asm (מצוין מספר השורה שם)
                      ;   ספר  = עובדה מהספרים, דרך docs/DRAGON-SPEC-*.md (מפת הזיכרון, טבלת המילים, כללי הכיווץ)
                      ;   קורא = עובדה מהדוח של "הקורא" (Codex) שגונן בדק, בלי קוד
                      ;   שלנו = נכתב כאן
                      ; הכותב (שיחת Dragon) לא ראה את הקוד של ה-Dragon.
                      ;
                      ; Portions of this file are translated from Microsoft BASIC-M6502 (m6502.asm),
                      ; Copyright (c) Microsoft Corporation, licensed under the MIT License (rom2/mit/LICENSE).
                      
8000                                  org     $8000
8000                                  setdp   0
                      
0400                  SCREEN          equ     $0400
0600                  SCREND          equ     $0600
FF00                  PIA0            equ     $ff00
FF20                  PIA1            equ     $ff20
FFC0                  SAM             equ     $ffc0
                      
                      ; ---------- כתובות קבועות של ה-Dragon (ספר: Companion, PRG) ----------
0019                  TXTTAB          equ     $19             ; תחילת התוכנית
001B                  VARTAB          equ     $1b             ; תחילת המשתנים
001D                  ARYTAB          equ     $1d             ; תחילת המערכים
001F                  STREND          equ     $1f             ; סוף המערכים
0021                  STKTOP          equ     $21             ; גבול המחסנית והמחרוזות
0023                  FRETOP          equ     $23
0027                  MEMSIZ          equ     $27
002B                  LINNUM          equ     $2b             ; מספר שורה (קורא: שימוש במקור)
0088                  CURSOR          equ     $88             ; כתובת הסמן (ספר)
008F                  CBLCNT          equ     $8f             ; מונה ההבהוב של הסמן (קורא: 50 בהדלקה)
0112                  TICKS           equ     $0112           ; TIMER (ספר: Inside)
                      
                      ; ---------- משתני הניסוי, באזור שהספרים מסמנים כפנוי ----------
03EA                  KPREV           equ     $03ea           ; 8 בתים
03F2                  KFOUND          equ     $03f2
03F3                  KNEW            equ     $03f3
03F4                  KROW            equ     $03f4
03F5                  KCOL            equ     $03f5
03F6                  LOWTR           equ     $03f6           ; 2 בתים (השם מ-mit)
03F8                  CRMODE          equ     $03f8           ; כיווץ: 0 רגיל, 1 אחרי DATA
03F9                  KPRE            equ     $03f9           ; קידומת המילה שנמצאה: 0 פקודה, $FF פונקציה
03FA                  LEND            equ     $03fa           ; 2 בתים: סוף טווח LIST
03FC                  LASTKEY         equ     $03fc
                      
00F8                  KQPTR           equ     $f8             ; רק לבדיקות: המקש הבא בתור המוקלד (התור עצמו ב-ROM, testq)
00FA                  KQCNT           equ     $fa             ; כמה מקשים נשארו, 2 בתים (באזור הפנוי $EA-$FF, קורא)
02DD                  LINBUF          equ     $02dd           ; מאגר השורה (קורא: BUF ב-$02DD)
00F9                  LINMAX          equ     249
01DA                  CRB             equ     $01da           ; הניסוי בלבד: השורה המכווצת, בחוצץ הקלטת (255 בתים). במקור הכיווץ נעשה
                                                              ; בתוך המאגר; בשלב הקלטת עוברים לשיטה הזו
7F36                  STACKINI        equ     $7f36           ; ספר: STKTOP אחרי ההדלקה
                      
                      ; ---------- הפעלה ----------
8000 1A50             reset           orcc    #$50
8002 B7FFDA                           sta     SAM+26
8005 B7FFDD                           sta     SAM+29
8008 10CE7F36                         lds     #STACKINI
800C 8E0000                           ldx     #0              ; ניקוי ראשון של $0000-$03FF (קורא: "הניקוי הראשוני")
800F 6F80             1               clr     ,x+
8011 8C0400                           cmpx    #$0400
8014 25F9                             blo     1B
