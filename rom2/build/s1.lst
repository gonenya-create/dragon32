81AA 00                               fcb     0
81AB 20494E20         m_in            fcc     " IN "
81AF 00                               fcb     0
                      
                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
81B0 170292           storeline       lbsr    linget          ; D = מספר השורה
81B3 DD2B                             std     LINNUM
81B5                  storel2                                 ; EDIT נכנס כאן: LINNUM מוכן, X = הטקסט
81B5 170281                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81B8 1700BE                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81BB 1F30                             tfr     u,d
81BD 8301DA                           subd    #CRB
81C0 C30004                           addd    #4              ; קישור + מספר + טקסט + 0
81C3 3406                             pshs    d               ; האורך
81C5 DC2B                             ldd     LINNUM
81C7 8D57                             bsr     fndlin          ; Y = השורה (C=1 אם קיימת)
81C9 2402                             bcc     1F
81CB 8D3F                             bsr     dellin          ; קיימת: קודם מוחקים
81CD 7D01DA           1               tst     CRB
81D0 2734                             beq     9F              ; רק מספר: רק מחיקה
                                      ; מזיזים את [Y..VARTAB) למעלה באורך השורה (mit: BLTU)
81D2 9E1B                             ldx     VARTAB
81D4 DC1B                             ldd     VARTAB
81D6 E3E4                             addd    ,s
81D8 3416                             pshs    d,x             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON)
81DA 171769                           lbsr    reason
81DD 3516                             puls    d,x
81DF 1F03                             tfr     d,u
81E1 DD1B                             std     VARTAB
81E3 10BF03F6                         sty     LOWTR
81E7 BC03F6           2               cmpx    LOWTR
81EA 2306                             bls     3F
81EC A682                             lda     ,-x
81EE A7C2                             sta     ,-u
81F0 20F5                             bra     2B
81F2 CCFFFF           3               ldd     #$ffff          ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
81F5 EDA4                             std     ,y
81F7 DC2B                             ldd     LINNUM
81F9 ED22                             std     2,y
81FB 3324                             leau    4,y
81FD 8E01DA                           ldx     #CRB
8200 A680             4               lda     ,x+
8202 A7C0                             sta     ,u+
8204 26FA                             bne     4B
8206 3262             9               leas    2,s
8208 8D33                             bsr     lnkprg
820A 204F                             bra     runc
                      
                      ; dellin: מוחק את השורה ב-Y (mit: m6502.asm:1571-1608)
820C 3476             dellin          pshs    d,x,y,u
820E AEA4                             ldx     ,y              ; השורה הבאה
8210 1F23                             tfr     y,u
8212 9C1B             1               cmpx    VARTAB
8214 2406                             bhs     2F
8216 A680                             lda     ,x+
8218 A7C0                             sta     ,u+
821A 20F6                             bra     1B
821C DF1B             2               stu     VARTAB
821E 35F6                             puls    d,x,y,u,pc
                      
                      ; fndlin: מחפש את השורה D. Y = הרשומה שלה או הראשונה שגדולה ממנה (או סמן הסוף). C=1 אם נמצאה
                      ; (mit: FNDLIN, m6502.asm:1879)
8220 109E19           fndlin          ldy     TXTTAB
8223                  fndlnc
8223 3406             1               pshs    d
8225 ECA4                             ldd     ,y
8227 3506                             puls    d
8229 270C                             beq     8F              ; סוף התוכנית
822B 10A322                           cmpd    2,y
822E 270A                             beq     9F
8230 2505                             blo     8F
8232 10AEA4                           ldy     ,y
8235 20EC                             bra     1B
8237 1CFE             8               andcc   #$fe
8239 39                               rts
823A 1A01             9               orcc    #1
823C 39                               rts
                      
                      ; lnkprg: מחשב מחדש את כל הקישורים. סוף כל שורה = ה-0 שבסופה; סוף התוכנית = קישור $0000
                      ; (mit: LNKPRG/CHEAD, m6502.asm:1642)
823D 9E19             lnkprg          ldx     TXTTAB
823F EC84             1               ldd     ,x
8241 270D                             beq     9F
8243 3104                             leay    4,x
8245 6DA0             2               tst     ,y+
8247 26FC                             bne     2B
8249 10AF84                           sty     ,x
824C 1F21                             tfr     y,x
824E 20EF                             bra     1B
8250 39               9               rts
                      
                      ; scrtch (NEW): שני אפסים בתחילת התוכנית, והמשתנים אחריהם (mit: SCRTCH, m6502.asm:1919)
8251 9E19             scrtch          ldx     TXTTAB
8253 6F84                             clr     ,x
8255 6F01                             clr     1,x
8257 3002                             leax    2,x
8259 9F1B                             stx     VARTAB
                      ; runc: מאפסים משתנים ומערכים (mit: RUNC/CLEARC)
825B DC27             runc            ldd     MEMSIZ
825D DD23                             std     FRETOP
825F DC1B                             ldd     VARTAB
8261 DD1D                             std     ARYTAB
8263 DD1F                             std     STREND
8265 DC19                             ldd     TXTTAB          ; RESTORE
8267 830001                           subd    #1
826A DD33                             std     DATPTR
826C CC01A9                           ldd     #TEMPST
826F DD0B                             std     TEMPPT
8271 CC0000                           ldd     #0              ; אין המשך
8274 DD2D                             std     OLDTXT
8276 0F08                             clr     SUBFLG
8278 39                               rts
                      
                      ; ---------- כיווץ (mit: CRUNCH, m6502.asm:1785; כללי ה-Dragon: קורא + ספר) ----------
                      ; X = הטקסט (מסתיים ב-0). הפלט ב-CRB, מסתיים ב-0. U = אחרי ה-0
8279 CE01DA           crunch          ldu     #CRB
827C 7F03F8                           clr     CRMODE
827F A684             cr_lp           lda     ,x
8281 102700A1                         lbeq    cr_end
8285 8120                             cmpa    #$20            ; רווח נשמר (קורא)
8287 277C                             beq     cr_put
8289 8122                             cmpa    #'"
828B 277F                             beq     cr_str
828D 7D03F8                           tst     CRMODE          ; אחרי DATA: הכול כמו שהוא, עד : שמחוץ למרכאות
8290 2709                             beq     1F
8292 813A                             cmpa    #':
8294 266F                             bne     cr_put
8296 7F03F8                           clr     CRMODE
8299 206A                             bra     cr_put
829B 813F             1               cmpa    #'?             ; ? = PRINT
829D 2606                             bne     2F
829F 8687                             lda     #$87
82A1 3001                             leax    1,x
82A3 2062                             bra     cr_put1
82A5 8127             2               cmpa    #''             ; ' = נקודתיים ו-$83, ואז השאר כמו שהוא (קורא)
82A7 2609                             bne     3F
82A9 3001                             leax    1,x
82AB CC3A83                           ldd     #$3a83
82AE EDC1                             std     ,u++
82B0 206D                             bra     cr_rest
82B2 8130             3               cmpa    #'0             ; ספרות, : ו-; נשמרים ישר (mit: KLOOP1)
82B4 2504                             blo     cr_kw
82B6 813B                             cmpa    #';
82B8 234B                             bls     cr_put
82BA 8D6D             cr_kw           bsr     kwmatch         ; מילה שמורה? C=1, B = הטוקן, KPRE = $FF לפונקציה
82BC 2424                             bcc     cr_name
82BE 7D03F9                           tst     KPRE
82C1 2708                             beq     4F
82C3 86FF                             lda     #$ff            ; פונקציה: $FF ואחריו הטוקן
82C5 A7C0                             sta     ,u+
82C7 E7C0                             stb     ,u+
82C9 20B4                             bra     cr_lp
82CB C184             4               cmpb    #$84            ; ELSE: לפניו נקודתיים, גם אם כבר היו (קורא)
82CD 2604                             bne     5F
82CF 863A                             lda     #':
82D1 A7C0                             sta     ,u+
82D3 E7C0             5               stb     ,u+
82D5 C186                             cmpb    #$86            ; DATA
82D7 2603                             bne     6F
82D9 7C03F8                           inc     CRMODE
82DC C182             6               cmpb    #$82            ; REM: השאר כמו שהוא
82DE 273F                             beq     cr_rest
82E0 209D                             bra     cr_lp
82E2 A684             cr_name         lda     ,x              ; לא מילה שמורה. אות: שם, וכל האותיות והספרות שאחריה נשמרות כמו שהן (קורא)
82E4 8141                             cmpa    #'A
82E6 251D                             blo     cr_put
82E8 815A                             cmpa    #'Z
82EA 2219                             bhi     cr_put
82EC A7C0             7               sta     ,u+
