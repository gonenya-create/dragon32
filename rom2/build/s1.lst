8176 841F                             anda    #$1f
8178 2705                             beq     1F
817A 860D                             lda     #13
817C 172E43                           lbsr    putc
817F 863F             1               lda     #'?
8181 172E3E                           lbsr    putc
8184 3506                             puls    d
8186 172E39                           lbsr    putc
8189 1F98                             tfr     b,a
818B 172E34                           lbsr    putc
818E 308C23                           leax    m_err,pcr
8191 172EC1                           lbsr    puts
8194 DC68                             ldd     CURLIN
8196 1083FFFF                         cmpd    #$ffff
819A 2709                             beq     2F
819C 308C1C                           leax    m_in,pcr
819F 172EB3                           lbsr    puts
81A2 1702E3                           lbsr    prnum
81A5 860D             2               lda     #13
81A7 172E18                           lbsr    putc
81AA 308D0386                         leax    m_ok,pcr
