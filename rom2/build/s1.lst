B726 8C0400           pc_bs           cmpx    #SCREEN
B729 2706                             beq     putc_done
B72B 8660                             lda     #$60
B72D A782                             sta     ,-x
B72F 9F88                             stx     CURSOR
B731 3596             putc_done       puls    a,b,x,pc
                      
                      ; puts: מחרוזת ב-X שמסתיימת ב-0
B733 A680             puts            lda     ,x+
B735 2704                             beq     1F
B737 8DA3                             bsr     putc
B739 20F8                             bra     puts
B73B 39               1               rts
                      
                      
                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
B73C 3031323334353637 KEYMAP          fcc     "01234567"
B744 38393A3B2C2D2E2F                 fcc     "89:;,-./"
B74C 4041424344454647                 fcc     "@ABCDEFG"
B754 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
B75C 5051525354555657                 fcc     "PQRSTUVW"
B764 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
B76C 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
B774 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
B77C 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
B784 3434             keyindex        pshs    b,x,y
B786 108EB73C                         ldy     #KEYMAP
B78A 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
B78D 5F                               clrb                    ; עמודה
