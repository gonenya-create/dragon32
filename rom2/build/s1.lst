81D5 E3E4                             addd    ,s
81D7 3416                             pshs    d,x             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON)
81D9 171690                           lbsr    reason
81DC 3516                             puls    d,x
81DE 1F03                             tfr     d,u
