8048 FD03EE                           std     KPREV+4
804B FD03F0                           std     KPREV+6
                                      ; מצב ההדלקה (ספר): תוכנית ב-$1E01, אפס ב-$1E00, גבולות הזיכרון והמחרוזות
804E 7F1E00                           clr     $1e00
8051 CC1E01                           ldd     #$1e01
8054 DD19                             std     TXTTAB
8056 CC7FFE                           ldd     #$7ffe
