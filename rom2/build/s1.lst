80AD 27F3                             beq     main            ; שורה ריקה
80AF 1701BC                           lbsr    isdig
80B2 240A                             bcc     1F
80B4 1700FA                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80B7 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80BA 6FE2                             clr     ,-s
80BC 20E4                             bra     main
80BE 1701BC           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80C1 4F                               clra                    ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80C2 5F                               clrb
80C3 EDC4                             std     ,u
80C5 8E01D9                           ldx     #CRB-1
80C8 9FA6                             stx     TXTPTR
80CA 43                               coma
80CB 53                               comb
80CC DD68                             std     CURLIN          ; $FFFF
80CE 160ABA                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; condcr: שורה חדשה אם הסמן לא בעמודה 0
80D1 9689             condcr          lda     CURSOR+1
80D3 841F                             anda    #$1f
80D5 2611                             bne     prcr
80D7 39                               rts
                      ; prin: " IN n" אם בתוכנית, ושורה חדשה
80D8 DC68             prin            ldd     CURLIN
