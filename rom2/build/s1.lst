                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
B8F6                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
B8F6 8EFF00                           ldx     #PIA0
B8F9 C634                             ldb     #$34            ; CR: גישה לנתונים; CA2/CB2 פלט נמוך — בוררי הצליל, הצליל והמנוע כבויים (קורא: צליל 0.3)
B8FB 6F01                             clr     1,x             ; CRA: גישה ל-DDR
B8FD 6F84                             clr     ,x              ; DDRA: הכול קלט
B8FF E701                             stb     1,x             ; CRA: חזרה לנתונים
B901 6F03                             clr     3,x
B903 86FF                             lda     #$ff
B905 A702                             sta     2,x             ; DDRB: הכול פלט
B907 E703                             stb     3,x
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
B909 8EFF20                           ldx     #PIA1
B90C 6F01                             clr     1,x
B90E 86FE                             lda     #$fe
B910 A784                             sta     ,x
B912 E701                             stb     1,x
B914 6F84                             clr     ,x              ; $FF20 = 0
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
B916 6F03                             clr     3,x
B918 86F8                             lda     #$f8
B91A A702                             sta     2,x
B91C E703                             stb     3,x
