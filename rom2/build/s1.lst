8260 810A                             cmpa    #10
8262 3582                             puls    a,pc
                      
                      
                      ; ---------- כיווץ (mit: CRUNCH, m6502.asm:1785; כללי ה-Dragon: קורא + ספר) ----------
                      ; X = הטקסט (מסתיים ב-0). הפלט ב-CRB, מסתיים ב-0. U = אחרי ה-0
8264 A680             cr_rest         lda     ,x+             ; השאר כמו שהוא, עד ה-0 (כולל)
8266 A7C0                             sta     ,u+
8268 26FA                             bne     cr_rest
826A 39               cr_ret          rts
826B CE01DA           crunch          ldu     #CRB
826E 7F03F8                           clr     CRMODE
