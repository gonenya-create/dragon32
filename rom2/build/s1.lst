80CE 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80D1 6FE2                             clr     ,-s
80D3 20E1                             bra     main
80D5 1701A2           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80D8 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80DA 6FC0                             clr     ,u+
80DC 8E01D9                           ldx     #CRB-1
80DF 9FA6                             stx     TXTPTR
80E1 CCFFFF                           ldd     #$ffff
80E4 DD68                             std     CURLIN
80E6 160CD4                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
80E9 16FFB8           endcon          lbra    main_ok
                      
