A5FD 5051525354555657                 fcc     "PQRSTUVW"
A605 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
A60D 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
A615 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
A61D 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
