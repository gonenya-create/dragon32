                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
AF0A                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
AF0A 7FFF01                           clr     PIA0+1          ; CRA: גישה ל-DDR
AF0D 7FFF00                           clr     PIA0            ; DDRA: הכול קלט
AF10 8604                             lda     #$04
AF12 B7FF01                           sta     PIA0+1          ; CRA: חזרה לנתונים
AF15 7FFF03                           clr     PIA0+3
AF18 86FF                             lda     #$ff
AF1A B7FF02                           sta     PIA0+2          ; DDRB: הכול פלט
AF1D 8604                             lda     #$04
AF1F B7FF03                           sta     PIA0+3
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
AF22 7FFF21                           clr     PIA1+1
AF25 86FE                             lda     #$fe
AF27 B7FF20                           sta     PIA1
AF2A 8604                             lda     #$04
AF2C B7FF21                           sta     PIA1+1
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
AF2F 7FFF23                           clr     PIA1+3
AF32 86F8                             lda     #$f8
AF34 B7FF22                           sta     PIA1+2
AF37 8604                             lda     #$04
AF39 B7FF23                           sta     PIA1+3
AF3C 7FFF22                           clr     PIA1+2          ; מצב טקסט, ערכת צבעים 0
                                      ; SAM: מצב תצוגה טקסט (V0-V2=0), תחילת המסך ב-$0400 (F1=1)
AF3F B7FFC0                           sta     SAM+0           ; V0=0
AF42 B7FFC2                           sta     SAM+2           ; V1=0
AF45 B7FFC4                           sta     SAM+4           ; V2=0
AF48 B7FFC6                           sta     SAM+6           ; F0=0
AF4B B7FFC9                           sta     SAM+9           ; F1=1
AF4E B7FFCA                           sta     SAM+10          ; F2=0
AF51 B7FFCC                           sta     SAM+12          ; F3=0
AF54 B7FFCE                           sta     SAM+14          ; F4=0
AF57 B7FFD0                           sta     SAM+16          ; F5=0
AF5A B7FFD2                           sta     SAM+18          ; F6=0
AF5D 39                               rts
                      
                      ; ---------- מסך ----------
