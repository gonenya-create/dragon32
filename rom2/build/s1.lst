81A3 8900                             adca    #0
81A5 3262                             leas    2,s
81A7 20D8                             bra     1B
81A9 3586             9               puls    d,pc
                      
                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
81AB 8DD2             storeline       bsr     linget          ; D = מספר השורה
81AD DD2B                             std     LINNUM
81AF                  storel2                                 ; EDIT נכנס כאן: LINNUM מוכן, X = הטקסט
81AF 1700AC                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81B2 1700C2                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81B5 1F30                             tfr     u,d
81B7 8301D6                           subd    #CRB-4          ; קישור + מספר + טקסט + 0
81BA 3406                             pshs    d               ; האורך
81BC DC2B                             ldd     LINNUM
81BE 8D4C                             bsr     fndlin          ; Y = השורה (C=1 אם קיימת)
81C0 2410                             bcc     1F
81C2 AEA4                             ldx     ,y              ; קיימת: קודם מוחקים (mit: m6502.asm:1571-1608). X = השורה הבאה
81C4 1F23                             tfr     y,u
81C6 9C1B             5               cmpx    VARTAB
81C8 2406                             bhs     6F
81CA A680                             lda     ,x+
81CC A7C0                             sta     ,u+
81CE 20F6                             bra     5B
81D0 DF1B             6               stu     VARTAB
81D2 7D01DA           1               tst     CRB
81D5 272F                             beq     9F              ; רק מספר: רק מחיקה
                                      ; מזיזים את [Y..VARTAB) למעלה באורך השורה (mit: BLTU)
81D7 DC1B                             ldd     VARTAB
81D9 E3E4                             addd    ,s
81DB 3426                             pshs    d,y             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON). Y = הגבול התחתון
81DD 17139C                           lbsr    reason
81E0 9E1B                             ldx     VARTAB
81E2 3506                             puls    d
81E4 1F03                             tfr     d,u
81E6 DD1B                             std     VARTAB
81E8 ACE4             2               cmpx    ,s
81EA 2306                             bls     3F
81EC A682                             lda     ,-x
81EE A7C2                             sta     ,-u
81F0 20F6                             bra     2B
81F2 3520             3               puls    y
81F4 10AFA4                           sty     ,y              ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
81F7 DC2B                             ldd     LINNUM
81F9 ED22                             std     2,y
81FB 3324                             leau    4,y
81FD 8E01DA                           ldx     #CRB
8200 A680             4               lda     ,x+
8202 A7C0                             sta     ,u+
8204 26FA                             bne     4B
8206 3262             9               leas    2,s
8208 8D1B                             bsr     lnkprg
820A 2035                             bra     runc
                      
                      ; fndlin: מחפש את השורה D. Y = הרשומה שלה או הראשונה שגדולה ממנה (או סמן הסוף). C=1 אם נמצאה
                      ; (mit: FNDLIN, m6502.asm:1879)
820C 109E19           fndlin          ldy     TXTTAB
820F                  fndlnc
820F 6DA4             1               tst     ,y              ; סוף התוכנית: קישור 0 (קישור אמיתי תמיד מעל $00FF)
8211 270C                             beq     8F
8213 10A322                           cmpd    2,y
8216 270A                             beq     9F
