82A6 2606                             bne     2F
82A8 8687                             lda     #$87
82AA 3001                             leax    1,x
82AC 2065                             bra     cr_put1
82AE 8127             2               cmpa    #''             ; ' = נקודתיים ו-$83, ואז השאר כמו שהוא (קורא)
82B0 2609                             bne     3F
82B2 3001                             leax    1,x
82B4 CC3A83                           ldd     #$3a83
82B7 EDC1                             std     ,u++
82B9 2070                             bra     cr_rest
