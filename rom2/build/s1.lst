                      ; Dragon 1982 BASIC — ניסוי שלב 1ב: חשבון נקודה צפה.
                      ; תרגום ל-6809 של שגרות החשבון של BASIC-M6502 (mit, מספרי השורות ב-rom2/mit/m6502.asm), בפורמט של 5 בתים:
                      ; מעריך, ו-4 בתי מנטיסה שהביט העליון שלהם הוא הסימן (ספר: PRG עמ' 98-99).
                      ; במצבר (FAC/ARG) המנטיסה "פתוחה": הביט העליון תמיד 1, והסימן בבית נפרד (mit: הערה לפני FADDH).
                      ; הכתובות של FAC ו-ARG הן של ה-Dragon (קורא: מפרט הזיכרון, $4F-$61).
                      ;
                      ; Portions translated from Microsoft BASIC-M6502, Copyright (c) Microsoft Corporation, MIT License.
                      
004F                  FACEXP          equ     $4f
0050                  FACHO           equ     $50
0051                  FACMOH          equ     $51
0052                  FACMO           equ     $52
0053                  FACLO           equ     $53
0054                  FACSGN          equ     $54
0055                  SGNFLG          equ     $55
005C                  ARGEXP          equ     $5c
005D                  ARGHO           equ     $5d
005E                  ARGMOH          equ     $5e
005F                  ARGMO           equ     $5f
0060                  ARGLO           equ     $60
0061                  ARGSGN          equ     $61
0062                  ARISGN          equ     $62
0063                  FACOV           equ     $63
0013                  RESHO           equ     $13             ; תוצאת הכפל (קורא: $13-$16)
0014                  RESMOH          equ     $14
0015                  RESMO           equ     $15
0016                  RESLO           equ     $16
005B                  BITS            equ     $5b
0045                  DECCNT          equ     $45             ; קורא: חופף ל-TEMPF2, כמו במקור
0046                  DPTFLG          equ     $46
0047                  TENEXP          equ     $47
0048                  EXPSGN          equ     $48
0064                  FBUFPT          equ     $64             ; 2 בתים
03DA                  FBUFFR          equ     $03da           ; קורא: מאגר הדפסת מספר
                      
                      ; ---------- העברות (mit: CONUPK 5306, MOVFM 5477, MOVMF 5506, MOVFA 5528, MOVAF 5537) ----------
                      ; conupk: המספר הארוז ב-X → ARG, ו-ARISGN = הסימנים שונים?
87CF CE005C           conupk          ldu     #ARGEXP
87D2 8D0C                             bsr     unpk
                      ; arisg: ARISGN = הסימן של ARG xor הסימן של FAC
87D4 9661             arisg           lda     ARGSGN
87D6 9854                             eora    FACSGN
87D8 9762                             sta     ARISGN
87DA 39                               rts
                      ; movfm: המספר הארוז ב-X → FAC
87DB 0F63             movfm           clr     FACOV
87DD CE004F                           ldu     #FACEXP
                      ; unpk: המספר הארוז ב-X → המצבר ב-U (FAC או ARG: מעריך, 4 בתי מנטיסה, סימן)
87E0 EC01             unpk            ldd     1,x
87E2 A745                             sta     5,u
87E4 8A80                             ora     #$80
87E6 ED41                             std     1,u
87E8 EC03                             ldd     3,x
87EA ED43                             std     3,u
87EC A684                             lda     ,x
87EE A7C4                             sta     ,u
87F0 39                               rts
                      ; movmf: FAC → מספר ארוז ב-X. ב-Dragon בלי עיגול כאן: כל פעולה כבר מעגלת (קורא; ב-mit מעגלים כאן)
87F1 DC52             movmf           ldd     FACMO
87F3 ED03                             std     3,x
