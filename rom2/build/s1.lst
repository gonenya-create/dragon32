8283 2755                             beq     cr_put
8285 8122                             cmpa    #'"
8287 2757                             beq     cr_str
8289 7D03F8                           tst     CRMODE          ; אחרי DATA: הכול כמו שהוא, עד : שמחוץ למרכאות
828C 2709                             beq     1F
828E 813A                             cmpa    #':
