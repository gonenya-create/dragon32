8BBF 39               9               rts
8BC0 2703             2               beq     1F
8BC2 1A01                             orcc    #1              ; אות וכו': C=1, Z=0
8BC4 39                               rts
8BC5 1A05             1               orcc    #5              ; סוף פקודה: C=1, Z=1
8BC7 39                               rts
                      
                      ; synchk: התו הנוכחי חייב להיות A. אחרת ?SN. אחר כך מתקדמים
