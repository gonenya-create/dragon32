82BD 2504                             blo     cr_kw
82BF 813B                             cmpa    #';
82C1 234E                             bls     cr_put
82C3 17006F           cr_kw           lbsr    kwmatch         ; מילה שמורה? C=1, B = הטוקן, KPRE = $FF לפונקציה
82C6 2424                             bcc     cr_name
82C8 7D03F9                           tst     KPRE
82CB 2708                             beq     4F
