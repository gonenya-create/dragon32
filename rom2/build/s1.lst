A7FD A782                             sta     ,-x
A7FF 9F88                             stx     CURSOR
A801 3596             putc_done       puls    a,b,x,pc
                      
                      ; puts: מחרוזת ב-X שמסתיימת ב-0
A803 A680             puts            lda     ,x+
A805 2704                             beq     1F
A807 8DA3                             bsr     putc
A809 20F8                             bra     puts
A80B 39               1               rts
                      
                      
                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
A80C 3031323334353637 KEYMAP          fcc     "01234567"
A814 38393A3B2C2D2E2F                 fcc     "89:;,-./"
A81C 4041424344454647                 fcc     "@ABCDEFG"
A824 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
A82C 5051525354555657                 fcc     "PQRSTUVW"
A834 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
A83C 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
A844 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
A84C 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
A854 3434             keyindex        pshs    b,x,y
A856 108EA80C                         ldy     #KEYMAP
A85A 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
A85D 5F                               clrb                    ; עמודה
