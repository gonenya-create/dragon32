8D7E 39                               rts
8D7F 1A05             1               orcc    #5              ; סוף פקודה: C=1, Z=1
8D81 39                               rts
                      
                      ; synchk: התו הנוכחי חייב להיות A. אחרת ?SN. אחר כך מתקדמים
