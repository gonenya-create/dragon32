828D 2604                             bne     2F
828F 8687                             lda     #$87
8291 203B                             bra     cr_put
8293 8127             2               cmpa    #''             ; ' = נקודתיים ו-$83, ואז השאר כמו שהוא (קורא)
8295 2609                             bne     3F
8297 3001                             leax    1,x
8299 CC3A83                           ldd     #$3a83
829C EDC1                             std     ,u++
829E 20C4                             bra     cr_rest
82A0 8130             3               cmpa    #'0             ; ספרות, : ו-; נשמרים ישר (mit: KLOOP1)
