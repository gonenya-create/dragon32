95CD 8184             3               cmpa    #$84            ; ELSE
95CF 26F0                             bne     1B
95D1 0D04                             tst     IFCNT
95D3 2706                             beq     4F
95D5 0A04                             dec     IFCNT
95D7 20E8                             bra     1B
95D9 301F             8               leax    -1,x            ; סוף השורה: על ה-0; if_do מוצא שם פקודה ריקה (gone3), וממשיכים לשורה הבאה
95DB 9FA6             4               stx     TXTPTR          ; TXTPTR = אחרי ה-ELSE; chrgot ב-if_do ממשיך כמו אחרי THEN
95DD 20D5                             bra     if_do
                      ; tkget: הבית הבא ב-X (X מתקדם), בלי מה שבתוך מרכאות ובלי הבית שאחרי $FF (פונקציה). A=0, Z=1: סוף השורה
                      ; (גם RENUM)
