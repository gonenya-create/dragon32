821D A7C0                             sta     ,u+
821F 20F6                             bra     1B
8221 DF1B             2               stu     VARTAB
8223 35F6                             puls    d,x,y,u,pc
                      
                      ; fndlin: מחפש את השורה D. Y = הרשומה שלה או הראשונה שגדולה ממנה (או סמן הסוף). C=1 אם נמצאה
                      ; (mit: FNDLIN, m6502.asm:1879)
8225 109E19           fndlin          ldy     TXTTAB
8228                  fndlnc
8228 3406             1               pshs    d
822A ECA4                             ldd     ,y
822C 3506                             puls    d
822E 270C                             beq     8F              ; סוף התוכנית
8230 10A322                           cmpd    2,y
8233 270A                             beq     9F
