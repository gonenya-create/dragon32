8294 A7C0                             sta     ,u+
8296 E7C0                             stb     ,u+
8298 20AF                             bra     cr_lp
829A C184             4               cmpb    #$84            ; ELSE: לפניו נקודתיים, גם אם כבר היו (קורא)
829C 2604                             bne     5F
829E 863A                             lda     #':
82A0 A7C0                             sta     ,u+
82A2 E7C0             5               stb     ,u+
82A4 C186                             cmpb    #$86            ; DATA
82A6 2603                             bne     6F
82A8 7C03F8                           inc     CRMODE
82AB C182             6               cmpb    #$82            ; REM: השאר כמו שהוא
82AD 2741                             beq     cr_rest
82AF 2098                             bra     cr_lp
82B1 A684             cr_name         lda     ,x              ; לא מילה שמורה. אות: שם, וכל האותיות והספרות שאחריה נשמרות כמו שהן (קורא)
82B3 8141                             cmpa    #'A
82B5 251F                             blo     cr_put
82B7 815A                             cmpa    #'Z
82B9 221B                             bhi     cr_put
