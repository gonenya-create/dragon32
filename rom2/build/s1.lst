                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
A755                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
A755 8EFF00                           ldx     #PIA0
A758 C604                             ldb     #$04            ; CR: גישה לנתונים
A75A 6F01                             clr     1,x             ; CRA: גישה ל-DDR
A75C 6F84                             clr     ,x              ; DDRA: הכול קלט
A75E E701                             stb     1,x             ; CRA: חזרה לנתונים
A760 6F03                             clr     3,x
A762 86FF                             lda     #$ff
A764 A702                             sta     2,x             ; DDRB: הכול פלט
A766 E703                             stb     3,x
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
A768 8EFF20                           ldx     #PIA1
A76B 6F01                             clr     1,x
A76D 86FE                             lda     #$fe
A76F A784                             sta     ,x
A771 E701                             stb     1,x
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
A773 6F03                             clr     3,x
A775 86F8                             lda     #$f8
A777 A702                             sta     2,x
A779 E703                             stb     3,x
                                      ; ממשיכים ב-txtmode: מצב טקסט, ערכת צבעים 0; SAM: מצב 0, המסך ב-$0400
                      ; txtmode: מצב טקסט (קורא: SAMALP). ב-$FF22 נשארים 3 הביטים התחתונים; SAM: מצב 0, המסך ב-$0400
A77B 3412             txtmode         pshs    a,x
A77D B6FF22                           lda     PIA1+2
A780 8407                             anda    #$07
A782 B7FF22                           sta     PIA1+2
A785 8EFFD4                           ldx     #SAM+20 ; לפי הסדר שבמקור: $FFD2 $FFD0 $FFCE $FFCC $FFCA $FFC9 $FFC6 $FFC4 $FFC2 $FFC0
A788 301E             1               leax    -2,x
A78A 8CFFC8                           cmpx    #SAM+8          ; במקום F1=0 ($FFC8): F1=1 ($FFC9)
A78D 2604                             bne     2F
A78F A701                             sta     1,x
A791 2002                             bra     3F
A793 A784             2               sta     ,x
A795 8CFFC0           3               cmpx    #SAM
A798 26EE                             bne     1B
A79A 3592                             puls    a,x,pc
                      ; ---------- מסך ----------
A79C 8E0400           cls             ldx     #SCREEN
                      ; clrto: הסמן ב-X, ומשם עד סוף המסך רווחים (גם scroll)
A79F 9F88             clrto           stx     CURSOR
A7A1 CC6060                           ldd     #$6060          ; רווח (ירוק)
A7A4 ED81             1               std     ,x++
A7A6 8C0600                           cmpx    #SCREND
A7A9 25F9                             blo     1B
A7AB 39                               rts
                      
                      ; putc: התו ב-A למסך במקום הסמן (קורא: docs/DRAGON-SPEC-SCREEN.md, סעיף 3)
                      ; קודם חוזרים למצב טקסט (SAMALP). $20-$3F → $60-$7F; $40-$5F ו-$80-$FF כמו שהם; $60-$7F → $00-$1F (הפוך).
                      ; 13: רווחים עד סוף השורה (כולל התא הנוכחי) ושורה חדשה. 8: תא אחד אחורה ורווח. שאר תווי הבקרה: כלום
A7AC 3416             putc            pshs    a,b,x
A7AE 8DCB                             bsr     txtmode
A7B0 9E88                             ldx     CURSOR
A7B2 810D                             cmpa    #13
A7B4 2732                             beq     pc_cr
A7B6 8108                             cmpa    #8
A7B8 273C                             beq     pc_bs
