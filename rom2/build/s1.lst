0062                  ARISGN          equ     $62
0063                  FACOV           equ     $63
0013                  RESHO           equ     $13             ; תוצאת הכפל (קורא: $13-$16)
0014                  RESMOH          equ     $14
0015                  RESMO           equ     $15
0016                  RESLO           equ     $16
005B                  BITS            equ     $5b
0045                  DECCNT          equ     $45             ; קורא: חופף ל-TEMPF2, כמו במקור
0046                  DPTFLG          equ     $46
0047                  TENEXP          equ     $47
0048                  EXPSGN          equ     $48
0064                  FBUFPT          equ     $64             ; 2 בתים
03DA                  FBUFFR          equ     $03da           ; קורא: מאגר הדפסת מספר
                      
                      ; ---------- העברות (mit: CONUPK 5306, MOVFM 5477, MOVMF 5506, MOVFA 5528, MOVAF 5537) ----------
                      ; conupk: המספר הארוז ב-X → ARG, ו-ARISGN = הסימנים שונים?
8647 CE005C           conupk          ldu     #ARGEXP
864A 8D0C                             bsr     unpk
                      ; arisg: ARISGN = הסימן של ARG xor הסימן של FAC
