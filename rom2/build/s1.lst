                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
81B1 17029F           storeline       lbsr    linget          ; D = מספר השורה
81B4 DD2B                             std     LINNUM
81B6 17028E                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81B9 1700C2                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81BC 1F30                             tfr     u,d
81BE 8301DA                           subd    #CRB
81C1 C30004                           addd    #4              ; קישור + מספר + טקסט + 0
81C4 3406                             pshs    d               ; האורך
81C6 DC2B                             ldd     LINNUM
81C8 17005A                           lbsr    fndlin          ; Y = השורה (C=1 אם קיימת)
81CB 2403                             bcc     1F
81CD 170041                           lbsr    dellin          ; קיימת: קודם מוחקים
81D0 7D01DA           1               tst     CRB
81D3 2734                             beq     9F              ; רק מספר: רק מחיקה
                                      ; מזיזים את [Y..VARTAB) למעלה באורך השורה (mit: BLTU)
81D5 9E1B                             ldx     VARTAB
81D7 DC1B                             ldd     VARTAB
81D9 E3E4                             addd    ,s
81DB 3416                             pshs    d,x             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON)
81DD 171786                           lbsr    reason
81E0 3516                             puls    d,x
81E2 1F03                             tfr     d,u
81E4 DD1B                             std     VARTAB
81E6 10BF03F6                         sty     LOWTR
81EA BC03F6           2               cmpx    LOWTR
81ED 2306                             bls     3F
81EF A682                             lda     ,-x
81F1 A7C2                             sta     ,-u
81F3 20F5                             bra     2B
81F5 CCFFFF           3               ldd     #$ffff          ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
81F8 EDA4                             std     ,y
81FA DC2B                             ldd     LINNUM
81FC ED22                             std     2,y
81FE 3324                             leau    4,y
8200 8E01DA                           ldx     #CRB
8203 A680             4               lda     ,x+
8205 A7C0                             sta     ,u+
8207 26FA                             bne     4B
8209 3262             9               leas    2,s
820B 170034                           lbsr    lnkprg
820E 16004F                           lbra    runc
                      
                      ; dellin: מוחק את השורה ב-Y (mit: m6502.asm:1571-1608)
8211 3476             dellin          pshs    d,x,y,u
8213 AEA4                             ldx     ,y              ; השורה הבאה
8215 1F23                             tfr     y,u
8217 9C1B             1               cmpx    VARTAB
8219 2406                             bhs     2F
