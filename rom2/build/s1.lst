824B 4F                               clra                    ; אין המשך
824C 5F                               clrb
824D DD2D                             std     OLDTXT
824F 0F08                             clr     SUBFLG
8251 39                               rts
                      
8252 A680             skipsp          lda     ,x+
8254 8120                             cmpa    #$20
8256 27FA                             beq     skipsp
8258 301F                             leax    -1,x
825A 4D                               tsta
825B 39                               rts
                      ; isdig: C=1 אם A ספרה
