8078 FD0115                           std     $0115
807B CCC752                           ldd     #$c752
807E FD0117                           std     $0117
8081 8659                             lda     #$59
8083 B70119                           sta     $0119
8086 CC0134                           ldd     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
8089 DDB0                             std     USTBAD
