                      ; Dragon 1982 BASIC — ניסוי שלב 1ב: חשבון נקודה צפה.
                      ; תרגום ל-6809 של שגרות החשבון של BASIC-M6502 (mit, מספרי השורות ב-rom2/mit/m6502.asm), בפורמט של 5 בתים:
                      ; מעריך, ו-4 בתי מנטיסה שהביט העליון שלהם הוא הסימן (ספר: PRG עמ' 98-99).
                      ; במצבר (FAC/ARG) המנטיסה "פתוחה": הביט העליון תמיד 1, והסימן בבית נפרד (mit: הערה לפני FADDH).
                      ; הכתובות של FAC ו-ARG הן של ה-Dragon (קורא: מפרט הזיכרון, $4F-$61).
                      ;
                      ; Portions translated from Microsoft BASIC-M6502, Copyright (c) Microsoft Corporation, MIT License.
                      
004F                  FACEXP          equ     $4f
0050                  FACHO           equ     $50
0051                  FACMOH          equ     $51
0052                  FACMO           equ     $52
0053                  FACLO           equ     $53
0054                  FACSGN          equ     $54
0055                  SGNFLG          equ     $55
005C                  ARGEXP          equ     $5c
005D                  ARGHO           equ     $5d
005E                  ARGMOH          equ     $5e
005F                  ARGMO           equ     $5f
0060                  ARGLO           equ     $60
0061                  ARGSGN          equ     $61
0062                  ARISGN          equ     $62
0063                  FACOV           equ     $63
0013                  RESHO           equ     $13             ; תוצאת הכפל (קורא: $13-$16)
0014                  RESMOH          equ     $14
0015                  RESMO           equ     $15
0016                  RESLO           equ     $16
005B                  BITS            equ     $5b
0045                  DECCNT          equ     $45             ; קורא: חופף ל-TEMPF2, כמו במקור
0046                  DPTFLG          equ     $46
0047                  TENEXP          equ     $47
0048                  EXPSGN          equ     $48
0064                  FBUFPT          equ     $64             ; 2 בתים
03DA                  FBUFFR          equ     $03da           ; קורא: מאגר הדפסת מספר
                      ; בלי מקבילה ידועה ב-Dragon: באזור הניסוי
03FD                  OLDOV           equ     $03fd
03FE                  DIVCNT          equ     $03fe
03FF                  NDIG            equ     $03ff
                      
