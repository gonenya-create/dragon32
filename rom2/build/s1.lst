00CB                  GSAV            equ     $cb             ; PAINT: ה-X השמור
00CD                  GLC             equ     $cd             ; כמה נצבעו שמאלה
00D1                  GREM            equ     $d1             ; כמה נשארו (עם סימן)
00D7                  GDIR            equ     $d7             ; הכיוון: 1, -1, 0
00D8                  GBRD            equ     $d8             ; צבע הגבול, בכל הבית
00DC                  GSSP            equ     $dc             ; המחסנית אחרי השליפה האחרונה
00CF                  GRR             equ     $cf             ; כמה נצבעו ימינה
                      
