809C 9F9D                             stx     EXECJP
809E 1701B5                           lbsr    scrtch
80A1 308D049C                         leax    banner,pcr
80A5 172999                           lbsr    puts
80A8 9689             main_ok         lda     CURSOR+1
80AA 841F                             anda    #$1f
80AC 2705                             beq     1F
80AE 860D                             lda     #13
80B0 1728FB                           lbsr    putc
80B3 308D047B         1               leax    m_ok,pcr
80B7 172987                           lbsr    puts
80BA 170415           main            lbsr    getline
80BD 25E9                             bcs     main_ok         ; BREAK
80BF 8E02DD                           ldx     #LINBUF
80C2 170382                           lbsr    skipsp
80C5 27F3                             beq     main            ; שורה ריקה
80C7 8130                             cmpa    #'0
80C9 250E                             blo     1F
80CB 8139                             cmpa    #'9
80CD 220A                             bhi     1F
80CF 1700DF                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80D2 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80D5 6FE2                             clr     ,-s
80D7 20E1                             bra     main
80D9 1701A2           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80DC 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80DE 6FC0                             clr     ,u+
80E0 8E01D9                           ldx     #CRB-1
80E3 9FA6                             stx     TXTPTR
80E5 CCFFFF                           ldd     #$ffff
80E8 DD68                             std     CURLIN
80EA 160CD5                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
80ED 16FFB8           endcon          lbra    main_ok
                      
                      ; ---------- שגיאות (mit: ERROR) ----------
