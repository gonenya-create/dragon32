                      ; Dragon 1982 BASIC — שלב 3, חלק 2: PRINT USING. לפי הקורא: docs/DRAGON-SPEC-USING.md. נכתב מאפס.
                      
00E0                  USDSC           equ     $e0             ; 2 בתים: מתאר התבנית (קוראים ממנו כל פעם: איסוף מחרוזות יכול להזיז אותה)
00E2                  USPOS           equ     $e2             ; המקום בתבנית
00E3                  USANY           equ     $e3             ; במחזור הזה נצרך ערך?
00E4                  USEND           equ     $e4             ; 0: יש עוד ערכים. 1: הרשימה נגמרה בלי מפריד. 2: עם ; או ,
00E5                  USL             equ     $e5             ; השדה המספרי: המקומות לפני הנקודה (כולל + מוביל, ** $$ **$ ופסיקים)
00E6                  USD             equ     $e6             ; ספרות אחרי הנקודה ($FF: אין נקודה)
00E7                  USFLG           equ     $e7             ; 1 פסיקים, 2 כוכביות, 4 דולר, 8 + מוביל, $10 + נגרר, $20 - נגרר, $40 מעריך
00E8                  USW             equ     $e8             ; רוחב שדה מחרוזת / עזר
                      
