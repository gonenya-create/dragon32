                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
ADE9                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
ADE9 7FFF01                           clr     PIA0+1          ; CRA: גישה ל-DDR
ADEC 7FFF00                           clr     PIA0            ; DDRA: הכול קלט
ADEF 8604                             lda     #$04
ADF1 B7FF01                           sta     PIA0+1          ; CRA: חזרה לנתונים
ADF4 7FFF03                           clr     PIA0+3
ADF7 86FF                             lda     #$ff
ADF9 B7FF02                           sta     PIA0+2          ; DDRB: הכול פלט
ADFC 8604                             lda     #$04
ADFE B7FF03                           sta     PIA0+3
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
AE01 7FFF21                           clr     PIA1+1
AE04 86FE                             lda     #$fe
AE06 B7FF20                           sta     PIA1
AE09 8604                             lda     #$04
AE0B B7FF21                           sta     PIA1+1
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
AE0E 7FFF23                           clr     PIA1+3
AE11 86F8                             lda     #$f8
AE13 B7FF22                           sta     PIA1+2
AE16 8604                             lda     #$04
AE18 B7FF23                           sta     PIA1+3
AE1B 7FFF22                           clr     PIA1+2          ; מצב טקסט, ערכת צבעים 0
                                      ; SAM: מצב תצוגה טקסט (V0-V2=0), תחילת המסך ב-$0400 (F1=1)
AE1E B7FFC0                           sta     SAM+0           ; V0=0
AE21 B7FFC2                           sta     SAM+2           ; V1=0
