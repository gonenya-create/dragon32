811B 2026                             bra     error
811D CC4F44           err_od          ldd     #'O*256+'D
8120 2021                             bra     error
8122 CC4944           err_id          ldd     #'I*256+'D
8125 201C                             bra     error
8127 CC434E           err_cn          ldd     #'C*256+'N
812A 2017                             bra     error
812C CC5546           err_uf          ldd     #'U*256+'F
812F 2012                             bra     error
