8148 2017                             bra     error
814A CC434E           err_cn          ldd     #'C*256+'N
814D 2012                             bra     error
814F CC5546           err_uf          ldd     #'U*256+'F
8152 200D                             bra     error
8154 CC444E           err_dn          ldd     #'D*256+'N
8157 2008                             bra     error
8159 CC4E4F           err_no          ldd     #'N*256+'O
815C 2003                             bra     error
815E CC2F30           err_dv0         ldd     #'/*256+'0
8161 10DE21           error           lds     STKTOP          ; mit: STKINI — מחסנית, זמניים, ואין המשך
8164 6FE2                             clr     ,-s
8166 8E01A9                           ldx     #TEMPST
8169 9F0B                             stx     TEMPPT
816B 8E0000                           ldx     #0
816E 9F2D                             stx     OLDTXT
8170 0F08                             clr     SUBFLG
