                      ; Dragon 1982 BASIC — ניסוי שלב 1 (20.10.2026)
                      ;
                      ; מה נבדק: האם הלב של BASIC-M6502 של Microsoft (רישיון MIT, ראו rom2/mit/LICENSE) עובר טוב לשבב 6809,
                      ; ואיך הוא מתאים לסידור הזיכרון של ה-Dragon 32: שמירת שורה מכווצת, המצביעים בכתובות הקבועות, LIST ו-NEW.
                      ;
                      ; יומן מקור (שלב 1):
                      ;   mit  = תרגום ל-6809 של שגרה מ-rom2/mit/m6502.asm (מצוין מספר השורה שם)
                      ;   ספר  = עובדה מהספרים, דרך docs/DRAGON-SPEC-*.md (מפת הזיכרון, טבלת המילים, כללי הכיווץ)
                      ;   קורא = עובדה מהדוח של "הקורא" (Codex) שגונן בדק, בלי קוד
                      ;   שלנו = נכתב כאן
                      ; הכותב (שיחת Dragon) לא ראה את הקוד של ה-Dragon.
                      ;
                      ; Portions of this file are translated from Microsoft BASIC-M6502 (m6502.asm),
                      ; Copyright (c) Microsoft Corporation, licensed under the MIT License (rom2/mit/LICENSE).
                      
8000                                  org     $8000
8000                                  setdp   0
                      
0400                  SCREEN          equ     $0400
0600                  SCREND          equ     $0600
FF00                  PIA0            equ     $ff00
FF20                  PIA1            equ     $ff20
FFC0                  SAM             equ     $ffc0
                      
                      ; ---------- כתובות קבועות של ה-Dragon (ספר: Companion, PRG) ----------
0019                  TXTTAB          equ     $19             ; תחילת התוכנית
001B                  VARTAB          equ     $1b             ; תחילת המשתנים
001D                  ARYTAB          equ     $1d             ; תחילת המערכים
001F                  STREND          equ     $1f             ; סוף המערכים
0021                  STKTOP          equ     $21             ; גבול המחסנית והמחרוזות
0023                  FRETOP          equ     $23
0027                  MEMSIZ          equ     $27
002B                  LINNUM          equ     $2b             ; מספר שורה (קורא: שימוש במקור)
0088                  CURSOR          equ     $88             ; כתובת הסמן (ספר)
008F                  CBLCNT          equ     $8f             ; מונה ההבהוב של הסמן (קורא: 50 בהדלקה)
0112                  TICKS           equ     $0112           ; TIMER (ספר: Inside)
                      
                      ; ---------- משתני הניסוי, באזור שהספרים מסמנים כפנוי ----------
03EA                  KPREV           equ     $03ea           ; 8 בתים
03F2                  KFOUND          equ     $03f2
03F3                  KNEW            equ     $03f3
03F4                  KROW            equ     $03f4
03F5                  KCOL            equ     $03f5
03F6                  LOWTR           equ     $03f6           ; 2 בתים (השם מ-mit)
03F8                  CRMODE          equ     $03f8           ; כיווץ: 0 רגיל, 1 אחרי DATA
03F9                  KPRE            equ     $03f9           ; קידומת המילה שנמצאה: 0 פקודה, $FF פונקציה
03FA                  LEND            equ     $03fa           ; 2 בתים: סוף טווח LIST
03FC                  LASTKEY         equ     $03fc
                      
00F8                  KQPTR           equ     $f8             ; רק לבדיקות: המקש הבא בתור המוקלד (התור עצמו ב-ROM, testq)
00FA                  KQCNT           equ     $fa             ; כמה מקשים נשארו, 2 בתים (באזור הפנוי $EA-$FF, קורא)
02DD                  LINBUF          equ     $02dd           ; מאגר השורה (קורא: BUF ב-$02DD)
00F9                  LINMAX          equ     249
01DA                  CRB             equ     $01da           ; הניסוי בלבד: השורה המכווצת, בחוצץ הקלטת (255 בתים). במקור הכיווץ נעשה
                                                              ; בתוך המאגר; בשלב הקלטת עוברים לשיטה הזו
7F36                  STACKINI        equ     $7f36           ; ספר: STKTOP אחרי ההדלקה
                      
                      ; ---------- הפעלה ----------
8000 1A50             reset           orcc    #$50
8002 B7FFDA                           sta     SAM+26
8005 B7FFDD                           sta     SAM+29
8008 10CE7F36                         lds     #STACKINI
800C 8E0400                           ldx     #$0400          ; ניקוי ראשון של $0000-$03FF (קורא: "הניקוי הראשוני")
800F 6F82             1               clr     ,-x
8011 3084                             leax    ,x
8013 26FA                             bne     1B
8015 6FE2                             clr     ,-s             ; סמן תחתית למחסנית ה-FOR/GOSUB (קורא: ב-STKTOP-1)
8017 308D0C45                         leax    chrtpl,pcr      ; קריאת התו ל-RAM ($9F-$AA)
801B CE009F                           ldu     #chrget
801E C60C                             ldb     #12
8020 A680             1               lda     ,x+
8022 A7C0                             sta     ,u+
8024 5A                               decb
8025 26F9                             bne     1B
8027 172C11                           lbsr    hw_init         ; DP כבר 0 מההדלקה (והקוד לא משנה אותו)
802A B6FF02                           lda     PIA0+2
802D 8605                             lda     #$05
802F B7FF03                           sta     PIA0+3
8032 1CEF                             andcc   #$ef
8034 8632                             lda     #50
8036 978F                             sta     CBLCNT
8038 172C47                           lbsr    cls
803B 308D2DDB                         leax    testq,pcr       ; תור הבדיקות
803F EC81                             ldd     ,x++
8041 DDFA                             std     KQCNT
8043 9FF8                             stx     KQPTR
                                      ; מצב ההדלקה (ספר): תוכנית ב-$1E01, אפס ב-$1E00, גבולות הזיכרון והמחרוזות
                                      ; (FRETOP ו-TEMPPT: נקבעים ב-scrtch/runc)
8045 8E1E01                           ldx     #$1e01
8048 9F19                             stx     TXTTAB
804A 6F1F                             clr     -1,x
804C CC7FFE                           ldd     #$7ffe          ; קורא: גבול ה-RAM
804F DD27                             std     MEMSIZ
8051 DD74                             std     ENDMEM
8053 C636                             ldb     #$36            ; $7F36
8055 DD21                             std     STKTOP
8057 860C                             lda     #$0c            ; קורא: מצב הגרפיקה בהדלקה — PMODE 0, דף 1, דפים מ-$0600
8059 97B7                             sta     SCTOP           ; $0C00 (הבית התחתון כבר 0)
805B 44                               lsra
805C 97BC                             sta     SCRBAS          ; $06
805E CC804F                           ldd     #$804f          ; קורא: זרע ה-RND, 80 4F C7 52 59
8061 FD0115                           std     $0115
8064 CCC752                           ldd     #$c752
8067 FD0117                           std     $0117
806A 8659                             lda     #$59
806C B70119                           sta     $0119
806F 8E0134                           ldx     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
8072 9FB0                             stx     USTBAD
8074 338C6F                           leau    err_fc,pcr
8077 C60A                             ldb     #10
8079 EF81             1               stu     ,x++
807B 5A                               decb
807C 26FB                             bne     1B
807E 308D191C                         leax    execrts,pcr     ; EXEC בלי כתובת אחרי ההדלקה: אצלנו חוזר מיד (ב-Dragon: פתוח)
8082 9F9D                             stx     EXECJP
8084 1701A6                           lbsr    scrtch
8087 308D03F4                         leax    banner,pcr      ; הכותרת ומיד אחריה OK (אחרי 13 אין שורה חדשה נוספת)
808B 2006                             bra     mo_puts
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
808D                  endcon
808D 8D36             main_ok         bsr     condcr
808F 308D0407                         leax    m_ok,pcr
8093 172C53           mo_puts         lbsr    puts
8096 17039E           main            lbsr    getline
8099 25F2                             bcs     main_ok         ; BREAK
809B 8E02DD                           ldx     #LINBUF
809E 1701B1                           lbsr    skipsp
80A1 27F3                             beq     main            ; שורה ריקה
80A3 1701B6                           lbsr    isdig
80A6 240A                             bcc     1F
80A8 1700F4                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80AB 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80AE 6FE2                             clr     ,-s
80B0 20E4                             bra     main
80B2 1701B6           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80B5 4F                               clra                    ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80B6 5F                               clrb
80B7 EDC4                             std     ,u
80B9 8E01D9                           ldx     #CRB-1
80BC 9FA6                             stx     TXTPTR
80BE 43                               coma
80BF 53                               comb
80C0 DD68                             std     CURLIN          ; $FFFF
80C2 160BF7                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; condcr: שורה חדשה אם הסמן לא בעמודה 0
80C5 9689             condcr          lda     CURSOR+1
80C7 841F                             anda    #$1f
80C9 2611                             bne     prcr
80CB 39                               rts
                      ; prin: " IN n" אם בתוכנית, ושורה חדשה
80CC DC68             prin            ldd     CURLIN
80CE 4C                               inca                    ; $FFxx = שורה ישירה (מספרי השורות עד 63999)
80CF 270B                             beq     prcr
80D1 4A                               deca
80D2 308D0098                         leax    m_in,pcr
80D6 172C10                           lbsr    puts
80D9 170307                           lbsr    prnum
                      ; prcr: שורה חדשה
80DC 860D             prcr            lda     #13
80DE 162BB1                           lbra    putc
                      
