8072 CC7FFE                           ldd     #$7ffe          ; קורא: גבול ה-RAM
8075 DD74                             std     ENDMEM
8077 CC0C00                           ldd     #$0c00          ; קורא: מצב הגרפיקה בהדלקה — PMODE 0, דף 1, דפים מ-$0600
807A DDB7                             std     SCTOP
807C 8606                             lda     #$06
807E 97BC                             sta     SCRBAS
8080 CC01A9                           ldd     #TEMPST
8083 DD0B                             std     TEMPPT
8085 CC804F                           ldd     #$804f          ; קורא: זרע ה-RND, 80 4F C7 52 59
8088 FD0115                           std     $0115
808B CCC752                           ldd     #$c752
808E FD0117                           std     $0117
8091 8659                             lda     #$59
8093 B70119                           sta     $0119
8096 CC0134                           ldd     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
8099 DDB0                             std     USTBAD
809B 8E0134                           ldx     #USRTAB
809E 338C68                           leau    err_fc,pcr
80A1 EF81             1               stu     ,x++
80A3 8C0148                           cmpx    #USRTAB+20
80A6 25F9                             blo     1B
80A8 308D1B5A                         leax    execrts,pcr     ; EXEC בלי כתובת אחרי ההדלקה: אצלנו חוזר מיד (ב-Dragon: פתוח)
80AC 9F9D                             stx     EXECJP
80AE 1701B0                           lbsr    scrtch
80B1 308D048E                         leax    banner,pcr
80B5 173004                           lbsr    puts
80B8 9689             main_ok         lda     CURSOR+1
80BA 841F                             anda    #$1f
80BC 2705                             beq     1F
80BE 860D                             lda     #13
80C0 172F66                           lbsr    putc
80C3 308D046D         1               leax    m_ok,pcr
80C7 172FF2                           lbsr    puts
80CA 170407           main            lbsr    getline
80CD 25E9                             bcs     main_ok         ; BREAK
80CF 8E02DD                           ldx     #LINBUF
80D2 170374                           lbsr    skipsp
80D5 27F3                             beq     main            ; שורה ריקה
80D7 8130                             cmpa    #'0
80D9 250E                             blo     1F
80DB 8139                             cmpa    #'9
80DD 220A                             bhi     1F
80DF 1700DE                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80E2 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80E5 6FE2                             clr     ,-s
80E7 20E1                             bra     main
80E9 17019D           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80EC 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80EE 6FC0                             clr     ,u+
80F0 8E01D9                           ldx     #CRB-1
80F3 9FA6                             stx     TXTPTR
80F5 CCFFFF                           ldd     #$ffff
80F8 DD68                             std     CURLIN
80FA 160CB0                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
80FD 20B9             endcon          bra     main_ok
                      
                      ; ---------- שגיאות (mit: ERROR) ----------
80FF CC534E           err_sn          ldd     #'S*256+'N
