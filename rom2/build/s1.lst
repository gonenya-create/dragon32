                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
81B1 8DD2             storeline       bsr     linget          ; D = מספר השורה
81B3 DD2B                             std     LINNUM
81B5                  storel2                                 ; EDIT נכנס כאן: LINNUM מוכן, X = הטקסט
81B5 1700AC                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81B8 1700C2                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81BB 1F30                             tfr     u,d
81BD 8301D6                           subd    #CRB-4          ; קישור + מספר + טקסט + 0
81C0 3406                             pshs    d               ; האורך
81C2 DC2B                             ldd     LINNUM
81C4 8D4C                             bsr     fndlin          ; Y = השורה (C=1 אם קיימת)
81C6 2410                             bcc     1F
81C8 AEA4                             ldx     ,y              ; קיימת: קודם מוחקים (mit: m6502.asm:1571-1608). X = השורה הבאה
81CA 1F23                             tfr     y,u
81CC 9C1B             5               cmpx    VARTAB
81CE 2406                             bhs     6F
