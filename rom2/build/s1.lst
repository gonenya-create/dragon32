8179 1F98                             tfr     b,a
817B 172F59                           lbsr    putc
817E 308C23                           leax    m_err,pcr
8181 172FE6                           lbsr    puts
8184 DC68                             ldd     CURLIN
8186 1083FFFF                         cmpd    #$ffff
818A 2709                             beq     2F
818C 308C1C                           leax    m_in,pcr
