                      ; Dragon 1982 BASIC — שלב 3, חלק 3: CIRCLE ו-PAINT.
                      ; הכול לפי הקורא: docs/DRAGON-SPEC-GRAPHICS.md (סעיפים 9, 10). נכתב מאפס, על הליבה של mitgfx.s.
                      
00CB                  GCX             equ     $cb             ; CIRCLE: המרכז (אחרי ההקטנה)
