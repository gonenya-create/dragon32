                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
ACF2 3031323334353637 KEYMAP          fcc     "01234567"
ACFA 38393A3B2C2D2E2F                 fcc     "89:;,-./"
AD02 4041424344454647                 fcc     "@ABCDEFG"
AD0A 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
AD12 5051525354555657                 fcc     "PQRSTUVW"
AD1A 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
AD22 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
AD2A 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
AD32 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
AD3A 3434             keyindex        pshs    b,x,y
AD3C 108EACF2                         ldy     #KEYMAP
AD40 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
AD43 5F                               clrb                    ; עמודה
AD44 8601             ki_col          lda     #1
AD46 3404                             pshs    b
AD48 5D                               tstb
AD49 2704                             beq     2F
AD4B 48               1               lsla
AD4C 5A                               decb
AD4D 26FC                             bne     1B
AD4F 43               2               coma
AD50 B7FF02                           sta     PIA0+2
AD53 3504                             puls    b
AD55 B6FF00                           lda     PIA0
AD58 43                               coma
AD59 847F                             anda    #$7f            ; השורות הלחוצות עכשיו
AD5B 8E03EA                           ldx     #KPREV
AD5E 3402                             pshs    a
AD60 A685                             lda     b,x
AD62 43                               coma
AD63 A4E4                             anda    ,s              ; חדש = עכשיו וגם לא קודם
AD65 B703F3                           sta     KNEW
AD68 3502                             puls    a
AD6A A785                             sta     b,x             ; לסריקה הבאה
AD6C C103                             cmpb    #3
AD6E 2508                             blo     3F
AD70 B603F3                           lda     KNEW            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
AD73 843F                             anda    #$3f
AD75 B703F3                           sta     KNEW
AD78 7D03F2           3               tst     KFOUND
AD7B 2623                             bne     ki_next
AD7D B603F3                           lda     KNEW
AD80 271E                             beq     ki_next
AD82 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
AD85 44               4               lsra
AD86 2505                             bcs     5F
AD88 7C03F4                           inc     KROW
AD8B 20F8                             bra     4B
AD8D F703F5           5               stb     KCOL
AD90 B603F4                           lda     KROW
AD93 C608                             ldb     #8
AD95 3D                               mul
AD96 FB03F5                           addb    KCOL
AD99 5C                               incb
AD9A F703F2                           stb     KFOUND
AD9D F603F5                           ldb     KCOL
ADA0 5C               ki_next         incb
ADA1 C108                             cmpb    #8
ADA3 259F                             blo     ki_col
ADA5 F603F2                           ldb     KFOUND
ADA8 2722                             beq     ki_none
ADAA 5A                               decb
ADAB A6A5                             lda     b,y             ; התו
ADAD 271D                             beq     ki_none
ADAF 3402                             pshs    a
ADB1 B603F1                           lda     KPREV+7         ; SHIFT לחוץ? (עמודה 7, שורה 6)
ADB4 8540                             bita    #$40
ADB6 3502                             puls    a
ADB8 2713                             beq     ki_out
ADBA C110                             cmpb    #16
ADBC 2507                             blo     1F
ADBE 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
ADC0 260B                             bne     ki_out
ADC2 4C                               inca
ADC3 2008                             bra     ki_out
ADC5 8EAD2A           1               ldx     #SHIFTED
ADC8 A685                             lda     b,x
ADCA 2001                             bra     ki_out
ADCC 4F               ki_none         clra
ADCD 35B4             ki_out          puls    b,x,y,pc
                      
                      ; inkey: מקש בלי לחכות (INKEY$): מהתור, או מקש שנלחץ עכשיו. אין: A=0
ADCF DCFA             inkey           ldd     KQCNT
ADD1 260D                             bne     gk_pop
ADD3 16FF64                           lbra    keyindex
                      
                      ; getkey: מחכה למקש, מחזיר את התו ב-A. קודם תור הבדיקות (KEYQ), אחר כך המקלדת
ADD6 3414             getkey          pshs    b,x
ADD8 DCFA             gk_loop         ldd     KQCNT
ADDA 2714                             beq     gk_scan
ADDC 8D02                             bsr     gk_pop
ADDE 2017                             bra     gk_got
                      ; gk_pop: התו הבא בתור
ADE0 3414             gk_pop          pshs    b,x
ADE2 9EFA                             ldx     KQCNT
ADE4 301F                             leax    -1,x
ADE6 9FFA                             stx     KQCNT
ADE8 9EF8                             ldx     KQPTR
ADEA A680                             lda     ,x+
ADEC 9FF8                             stx     KQPTR
ADEE 3594                             puls    b,x,pc
                      ; לולאת ההמתנה (קורא): הבהוב (עם השהיה), סריקה, ושוב. מקש: $60 בתא הסמן, ורק אז הוא חוזר
ADF0 8D0D             gk_scan         bsr     blink
ADF2 17FF45                           lbsr    keyindex        ; Z לפי A
ADF5 27E1                             beq     gk_loop
ADF7 9E88             gk_got          ldx     CURSOR
ADF9 C660                             ldb     #$60
ADFB E784                             stb     ,x
ADFD 3594                             puls    b,x,pc
                      ; blink (קורא): CBLCNT יורד; ב-0: ביט $40 בתא הסמן מתהפך, והמונה חוזר ל-50. אחר כך השהיה: 1118 סיבובים של 8 מחזורים
ADFF 3412             blink           pshs    a,x
AE01 0A8F                             dec     CBLCNT
AE03 260C                             bne     1F
AE05 9E88                             ldx     CURSOR
AE07 A684                             lda     ,x
AE09 8840                             eora    #$40
AE0B A784                             sta     ,x
AE0D 8632                             lda     #50
AE0F 978F                             sta     CBLCNT
AE11 8E045E           1               ldx     #$045e
AE14 301F             2               leax    -1,x
AE16 26FC                             bne     2B
AE18 3592                             puls    a,x,pc
AE1A                                  include "testq.s"
AE1A 00               testq           fcb     0
                      
AE1B B6FF02           irq             lda     PIA0+2
AE1E BE0112                           ldx     TICKS
AE21 3001                             leax    1,x
AE23 BF0112                           stx     TICKS
AE26 3B                               rti
                      
BFF2                                  org     $bff2
BFF2 800080008000AE1B                 fdb     reset,reset,reset,irq,reset,reset,reset
     800080008000
