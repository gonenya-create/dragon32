                      ; movfm: המספר הארוז ב-X → FAC
865F 0F63             movfm           clr     FACOV
8661 CE004F                           ldu     #FACEXP
                      ; unpk: המספר הארוז ב-X → המצבר ב-U (FAC או ARG: מעריך, 4 בתי מנטיסה, סימן)
