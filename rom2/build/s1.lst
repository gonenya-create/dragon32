8179 00                               fcb     0
817A 20494E20         m_in            fcc     " IN "
817E 00                               fcb     0
                      
                      ; linget: מספר שורה מ-X ל-D (עד 63999)
817F 4F               linget          clra
8180 5F                               clrb
8181 3406             1               pshs    d
8183 E684                             ldb     ,x
8185 C030                             subb    #'0
8187 C109                             cmpb    #9
8189 221E                             bhi     9F
818B 3001                             leax    1,x
