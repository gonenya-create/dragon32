81D1 9E1B                             ldx     VARTAB
81D3 DC1B                             ldd     VARTAB
81D5 E3E4                             addd    ,s
81D7 3416                             pshs    d,x             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON)
81D9 171747                           lbsr    reason
81DC 3516                             puls    d,x
81DE 1F03                             tfr     d,u
