8C86 39                               rts
8C87 1A05             1               orcc    #5              ; סוף פקודה: C=1, Z=1
8C89 39                               rts
                      
                      ; synchk: התו הנוכחי חייב להיות A. אחרת ?SN. אחר כך מתקדמים
