                      ; Dragon 1982 BASIC — שלב 3, חלק 2: כלי עריכה. TRON/TROFF, DEL, LINE INPUT, RENUM.
                      ; הכול לפי הקורא: docs/DRAGON-SPEC-EDIT.md. נכתב מאפס.
                      
00AF                  TRCFLG          equ     $af             ; קורא: דגל העקיבה ($4F = פועל)
00CF                  RNSTEP          equ     $cf             ; קורא: RENUM — הצעד
00D1                  RNOLD           equ     $d1             ; הסף (השורה הישנה הראשונה שממוספרת)
00D3                  RNPTR           equ     $d3             ; DEL / RENUM: מצביע לשורה
00D5                  RNNEW           equ     $d5             ; המספר החדש הראשון
                      
