80BA 17040B           main            lbsr    getline
80BD 25E9                             bcs     main_ok         ; BREAK
80BF 8E02DD                           ldx     #LINBUF
80C2 170380                           lbsr    skipsp
80C5 27F3                             beq     main            ; שורה ריקה
80C7 8130                             cmpa    #'0
80C9 250E                             blo     1F
80CB 8139                             cmpa    #'9
80CD 220A                             bhi     1F
