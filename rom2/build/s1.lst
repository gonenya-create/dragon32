814F 10DE21           error           lds     STKTOP          ; mit: STKINI — מחסנית, זמניים, ואין המשך
8152 6FE2                             clr     ,-s
8154 3406                             pshs    d               ; שתי האותיות, ואחריהן ה-0 של הסמן: מחרוזת במחסנית
8156 1700F9                           lbsr    rcsub
8159 17FF75                           lbsr    condcr
815C 863F                             lda     #'?
815E 3402                             pshs    a               ; "?XY"
8160 30E4                             leax    ,s
