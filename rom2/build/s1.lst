8018 308D0CF8                         leax    chrtpl,pcr      ; קריאת התו ל-RAM ($9F-$AA)
801C CE009F                           ldu     #chrget
801F C60C                             ldb     #12
8021 A680             1               lda     ,x+
8023 A7C0                             sta     ,u+
