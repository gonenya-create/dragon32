807A FD0117                           std     $0117
807D 8659                             lda     #$59
807F B70119                           sta     $0119
8082 CC0134                           ldd     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
8085 DDB0                             std     USTBAD
8087 8E0134                           ldx     #USRTAB
808A 338C69                           leau    err_fc,pcr
