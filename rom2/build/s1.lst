A7C4 2508                             blo     2F
A7C6 8180                             cmpa    #$80
A7C8 2404                             bhs     2F
A7CA 8B60                             adda    #$60            ; $60-$7F: יחד עם ה-$40 שאחריו, פחות $60
A7CC 8B40             1               adda    #$40
A7CE A780             2               sta     ,x+
A7D0 9F88             pc_adv          stx     CURSOR
A7D2 8C0600                           cmpx    #SCREND
A7D5 252A                             blo     putc_done
                                      ; גלילה: כל השורות עולות אחת, והאחרונה מתנקה
A7D7 8E0400                           ldx     #SCREEN
A7DA EC8820           4               ldd     32,x
A7DD ED81                             std     ,x++
A7DF 8C05E0                           cmpx    #SCREND-32
A7E2 25F6                             blo     4B
A7E4 8DB9                             bsr     clrto
A7E6 2019                             bra     putc_done
A7E8 D689             pc_cr           ldb     CURSOR+1        ; כמה תאים עד סוף השורה (1-32)
A7EA CAE0                             orb     #$e0            ; 32 פחות העמודה
A7EC 50                               negb
A7ED 8660                             lda     #$60
A7EF A780             3               sta     ,x+
