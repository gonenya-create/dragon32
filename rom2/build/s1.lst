                      ; ---------- EDIT n (קורא: docs/DRAGON-SPEC-EDIT.md, סעיף 1) ----------
00D7                  EDLEN           equ     $d7             ; קורא: האורך
00D8                  EDFLG           equ     $d8             ; 1: הפלט של LIST הולך למאגר
