82A6 2606                             bne     2F
82A8 8687                             lda     #$87
82AA 3001                             leax    1,x
82AC 2065                             bra     cr_put1
82AE 8127             2               cmpa    #''             ; ' = נקודתיים ו-$83, ואז השאר כמו שהוא (קורא)
82B0 2609                             bne     3F
82B2 3001                             leax    1,x
82B4 CC3A83                           ldd     #$3a83
82B7 EDC1                             std     ,u++
82B9 2070                             bra     cr_rest
82BB 8130             3               cmpa    #'0             ; ספרות, : ו-; נשמרים ישר (mit: KLOOP1)
82BD 2504                             blo     cr_kw
82BF 813B                             cmpa    #';
82C1 234E                             bls     cr_put
82C3 17006F           cr_kw           lbsr    kwmatch         ; מילה שמורה? C=1, B = הטוקן, KPRE = $FF לפונקציה
82C6 2424                             bcc     cr_name
82C8 7D03F9                           tst     KPRE
82CB 2708                             beq     4F
82CD 86FF                             lda     #$ff            ; פונקציה: $FF ואחריו הטוקן
82CF A7C0                             sta     ,u+
82D1 E7C0                             stb     ,u+
82D3 20AF                             bra     cr_lp
82D5 C184             4               cmpb    #$84            ; ELSE: לפניו נקודתיים, גם אם כבר היו (קורא)
82D7 2604                             bne     5F
82D9 863A                             lda     #':
82DB A7C0                             sta     ,u+
82DD E7C0             5               stb     ,u+
82DF C186                             cmpb    #$86            ; DATA
82E1 2603                             bne     6F
82E3 7C03F8                           inc     CRMODE
