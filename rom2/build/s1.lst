8167 204552524F52     m_err           fcc     " ERROR"
816D 00                               fcb     0
816E 20494E20         m_in            fcc     " IN "
8172 00                               fcb     0
                      
                      ; linget: מספר שורה מ-X ל-D (עד 63999)
8173 4F               linget          clra
8174 5F                               clrb
8175 3406             1               pshs    d
8177 E684                             ldb     ,x
8179 C030                             subb    #'0
817B C109                             cmpb    #9
817D 221E                             bhi     9F
817F 3001                             leax    1,x
8181 3404                             pshs    b
8183 EC61                             ldd     1,s
8185 108318FF                         cmpd    #6399           ; מעל 63999: ?SN (קורא: קורא מספרי השורות)
8189 22B5                             bhi     err_sn
818B 58                               lslb
818C 49                               rola
818D ED61                             std     1,s             ; *2
