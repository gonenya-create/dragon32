                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
ADD9                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
ADD9 7FFF01                           clr     PIA0+1          ; CRA: גישה ל-DDR
ADDC 7FFF00                           clr     PIA0            ; DDRA: הכול קלט
ADDF 8604                             lda     #$04
ADE1 B7FF01                           sta     PIA0+1          ; CRA: חזרה לנתונים
ADE4 7FFF03                           clr     PIA0+3
ADE7 86FF                             lda     #$ff
ADE9 B7FF02                           sta     PIA0+2          ; DDRB: הכול פלט
ADEC 8604                             lda     #$04
ADEE B7FF03                           sta     PIA0+3
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
ADF1 7FFF21                           clr     PIA1+1
ADF4 86FE                             lda     #$fe
ADF6 B7FF20                           sta     PIA1
ADF9 8604                             lda     #$04
ADFB B7FF21                           sta     PIA1+1
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
ADFE 7FFF23                           clr     PIA1+3
AE01 86F8                             lda     #$f8
AE03 B7FF22                           sta     PIA1+2
AE06 8604                             lda     #$04
AE08 B7FF23                           sta     PIA1+3
AE0B 7FFF22                           clr     PIA1+2          ; מצב טקסט, ערכת צבעים 0
                                      ; SAM: מצב תצוגה טקסט (V0-V2=0), תחילת המסך ב-$0400 (F1=1)
AE0E B7FFC0                           sta     SAM+0           ; V0=0
AE11 B7FFC2                           sta     SAM+2           ; V1=0
AE14 B7FFC4                           sta     SAM+4           ; V2=0
AE17 B7FFC6                           sta     SAM+6           ; F0=0
AE1A B7FFC9                           sta     SAM+9           ; F1=1
AE1D B7FFCA                           sta     SAM+10          ; F2=0
AE20 B7FFCC                           sta     SAM+12          ; F3=0
AE23 B7FFCE                           sta     SAM+14          ; F4=0
AE26 B7FFD0                           sta     SAM+16          ; F5=0
AE29 B7FFD2                           sta     SAM+18          ; F6=0
