825C 3002                             leax    2,x
825E 9F1B                             stx     VARTAB
                      ; runc: מאפסים משתנים ומערכים (mit: RUNC/CLEARC)
8260 DC27             runc            ldd     MEMSIZ
8262 DD23                             std     FRETOP
8264 DC1B                             ldd     VARTAB
8266 DD1D                             std     ARYTAB
8268 DD1F                             std     STREND
826A DC19                             ldd     TXTTAB          ; RESTORE
