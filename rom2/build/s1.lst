81F1 CCFFFF           3               ldd     #$ffff          ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
81F4 EDA4                             std     ,y
81F6 DC2B                             ldd     LINNUM
81F8 ED22                             std     2,y
