819E 00                               fcb     0
819F 20494E20         m_in            fcc     " IN "
81A3 00                               fcb     0
                      
                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
81A4 170292           storeline       lbsr    linget          ; D = מספר השורה
81A7 DD2B                             std     LINNUM
81A9                  storel2                                 ; EDIT נכנס כאן: LINNUM מוכן, X = הטקסט
81A9 170281                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81AC 1700BE                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81AF 1F30                             tfr     u,d
81B1 8301DA                           subd    #CRB
81B4 C30004                           addd    #4              ; קישור + מספר + טקסט + 0
81B7 3406                             pshs    d               ; האורך
81B9 DC2B                             ldd     LINNUM
81BB 8D57                             bsr     fndlin          ; Y = השורה (C=1 אם קיימת)
81BD 2402                             bcc     1F
81BF 8D3F                             bsr     dellin          ; קיימת: קודם מוחקים
81C1 7D01DA           1               tst     CRB
81C4 2734                             beq     9F              ; רק מספר: רק מחיקה
                                      ; מזיזים את [Y..VARTAB) למעלה באורך השורה (mit: BLTU)
81C6 9E1B                             ldx     VARTAB
81C8 DC1B                             ldd     VARTAB
81CA E3E4                             addd    ,s
81CC 3416                             pshs    d,x             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON)
81CE 171590                           lbsr    reason
81D1 3516                             puls    d,x
81D3 1F03                             tfr     d,u
81D5 DD1B                             std     VARTAB
81D7 10BF03F6                         sty     LOWTR
81DB BC03F6           2               cmpx    LOWTR
81DE 2306                             bls     3F
81E0 A682                             lda     ,-x
81E2 A7C2                             sta     ,-u
81E4 20F5                             bra     2B
81E6 CCFFFF           3               ldd     #$ffff          ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
81E9 EDA4                             std     ,y
81EB DC2B                             ldd     LINNUM
81ED ED22                             std     2,y
81EF 3324                             leau    4,y
81F1 8E01DA                           ldx     #CRB
81F4 A680             4               lda     ,x+
81F6 A7C0                             sta     ,u+
81F8 26FA                             bne     4B
81FA 3262             9               leas    2,s
81FC 8D33                             bsr     lnkprg
81FE 204F                             bra     runc
                      
                      ; dellin: מוחק את השורה ב-Y (mit: m6502.asm:1571-1608)
8200 3476             dellin          pshs    d,x,y,u
8202 AEA4                             ldx     ,y              ; השורה הבאה
8204 1F23                             tfr     y,u
8206 9C1B             1               cmpx    VARTAB
8208 2406                             bhs     2F
820A A680                             lda     ,x+
820C A7C0                             sta     ,u+
820E 20F6                             bra     1B
8210 DF1B             2               stu     VARTAB
8212 35F6                             puls    d,x,y,u,pc
                      
                      ; fndlin: מחפש את השורה D. Y = הרשומה שלה או הראשונה שגדולה ממנה (או סמן הסוף). C=1 אם נמצאה
                      ; (mit: FNDLIN, m6502.asm:1879)
8214 109E19           fndlin          ldy     TXTTAB
8217                  fndlnc
8217 3406             1               pshs    d
8219 ECA4                             ldd     ,y
821B 3506                             puls    d
821D 270C                             beq     8F              ; סוף התוכנית
821F 10A322                           cmpd    2,y
8222 270A                             beq     9F
