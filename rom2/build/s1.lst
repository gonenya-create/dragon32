824B 3002                             leax    2,x
824D 9F1B                             stx     VARTAB
                      ; runc: מאפסים משתנים ומערכים (mit: RUNC/CLEARC)
824F DC27             runc            ldd     MEMSIZ
8251 DD23                             std     FRETOP
8253 DC1B                             ldd     VARTAB
8255 DD1D                             std     ARYTAB
8257 DD1F                             std     STREND
8259 DC19                             ldd     TXTTAB          ; RESTORE
825B 830001                           subd    #1
825E DD33                             std     DATPTR
8260 CC01A9                           ldd     #TEMPST
