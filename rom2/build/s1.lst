                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
AEDD 3031323334353637 KEYMAP          fcc     "01234567"
AEE5 38393A3B2C2D2E2F                 fcc     "89:;,-./"
AEED 4041424344454647                 fcc     "@ABCDEFG"
AEF5 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
AEFD 5051525354555657                 fcc     "PQRSTUVW"
AF05 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
AF0D 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
