8264 DC1B                             ldd     VARTAB
8266 DD1D                             std     ARYTAB
8268 DD1F                             std     STREND
826A DC19                             ldd     TXTTAB          ; RESTORE
826C 830001                           subd    #1
826F DD33                             std     DATPTR
8271 CC01A9                           ldd     #TEMPST
8274 DD0B                             std     TEMPPT
8276 CC0000                           ldd     #0              ; אין המשך
8279 DD2D                             std     OLDTXT
827B 0F08                             clr     SUBFLG
827D 39                               rts
                      
                      ; ---------- כיווץ (mit: CRUNCH, m6502.asm:1785; כללי ה-Dragon: קורא + ספר) ----------
                      ; X = הטקסט (מסתיים ב-0). הפלט ב-CRB, מסתיים ב-0. U = אחרי ה-0
827E CE01DA           crunch          ldu     #CRB
8281 7F03F8                           clr     CRMODE
8284 A684             cr_lp           lda     ,x
8286 102700A8                         lbeq    cr_end
828A 8120                             cmpa    #$20            ; רווח נשמר (קורא)
828C 10270081                         lbeq    cr_put
8290 8122                             cmpa    #'"
8292 10270082                         lbeq    cr_str
8296 7D03F8                           tst     CRMODE          ; אחרי DATA: הכול כמו שהוא, עד : שמחוץ למרכאות
8299 2709                             beq     1F
829B 813A                             cmpa    #':
829D 2672                             bne     cr_put
829F 7F03F8                           clr     CRMODE
