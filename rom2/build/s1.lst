816A 204552524F52     m_err           fcc     " ERROR"
8170 00                               fcb     0
8171 20494E20         m_in            fcc     " IN "
8175 00                               fcb     0
                      
                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
8176 17029D           storeline       lbsr    linget          ; D = מספר השורה
8179 DD2B                             std     LINNUM
817B 17028C                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
817E 1700C2                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
8181 1F30                             tfr     u,d
8183 8301DA                           subd    #CRB
8186 C30004                           addd    #4              ; קישור + מספר + טקסט + 0
8189 3406                             pshs    d               ; האורך
818B DC2B                             ldd     LINNUM
818D 17005A                           lbsr    fndlin          ; Y = השורה (C=1 אם קיימת)
8190 2403                             bcc     1F
8192 170041                           lbsr    dellin          ; קיימת: קודם מוחקים
8195 7D01DA           1               tst     CRB
8198 2734                             beq     9F              ; רק מספר: רק מחיקה
                                      ; מזיזים את [Y..VARTAB) למעלה באורך השורה (mit: BLTU)
819A 9E1B                             ldx     VARTAB
819C DC1B                             ldd     VARTAB
819E E3E4                             addd    ,s
81A0 3416                             pshs    d,x             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON)
81A2 1715FA                           lbsr    reason
81A5 3516                             puls    d,x
81A7 1F03                             tfr     d,u
81A9 DD1B                             std     VARTAB
81AB 10BF03F6                         sty     LOWTR
81AF BC03F6           2               cmpx    LOWTR
81B2 2306                             bls     3F
81B4 A682                             lda     ,-x
81B6 A7C2                             sta     ,-u
81B8 20F5                             bra     2B
81BA CCFFFF           3               ldd     #$ffff          ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
81BD EDA4                             std     ,y
81BF DC2B                             ldd     LINNUM
81C1 ED22                             std     2,y
81C3 3324                             leau    4,y
81C5 8E01DA                           ldx     #CRB
81C8 A680             4               lda     ,x+
81CA A7C0                             sta     ,u+
81CC 26FA                             bne     4B
81CE 3262             9               leas    2,s
81D0 170034                           lbsr    lnkprg
81D3 16004F                           lbra    runc
                      
                      ; dellin: מוחק את השורה ב-Y (mit: m6502.asm:1571-1608)
81D6 3476             dellin          pshs    d,x,y,u
81D8 AEA4                             ldx     ,y              ; השורה הבאה
81DA 1F23                             tfr     y,u
81DC 9C1B             1               cmpx    VARTAB
81DE 2406                             bhs     2F
81E0 A680                             lda     ,x+
81E2 A7C0                             sta     ,u+
81E4 20F6                             bra     1B
81E6 DF1B             2               stu     VARTAB
81E8 35F6                             puls    d,x,y,u,pc
                      
                      ; fndlin: מחפש את השורה D. Y = הרשומה שלה או הראשונה שגדולה ממנה (או סמן הסוף). C=1 אם נמצאה
                      ; (mit: FNDLIN, m6502.asm:1879)
81EA 109E19           fndlin          ldy     TXTTAB
81ED                  fndlnc
81ED 3406             1               pshs    d
81EF ECA4                             ldd     ,y
81F1 3506                             puls    d
81F3 270C                             beq     8F              ; סוף התוכנית
81F5 10A322                           cmpd    2,y
81F8 270A                             beq     9F
81FA 2505                             blo     8F
81FC 10AEA4                           ldy     ,y
81FF 20EC                             bra     1B
8201 1CFE             8               andcc   #$fe
8203 39                               rts
8204 1A01             9               orcc    #1
8206 39                               rts
                      
                      ; lnkprg: מחשב מחדש את כל הקישורים. סוף כל שורה = ה-0 שבסופה; סוף התוכנית = קישור $0000
                      ; (mit: LNKPRG/CHEAD, m6502.asm:1642)
8207 9E19             lnkprg          ldx     TXTTAB
8209 EC84             1               ldd     ,x
820B 270D                             beq     9F
820D 3104                             leay    4,x
820F 6DA0             2               tst     ,y+
8211 26FC                             bne     2B
8213 10AF84                           sty     ,x
8216 1F21                             tfr     y,x
8218 20EF                             bra     1B
821A 39               9               rts
                      
                      ; scrtch (NEW): שני אפסים בתחילת התוכנית, והמשתנים אחריהם (mit: SCRTCH, m6502.asm:1919)
821B 9E19             scrtch          ldx     TXTTAB
821D 6F84                             clr     ,x
821F 6F01                             clr     1,x
8221 3002                             leax    2,x
8223 9F1B                             stx     VARTAB
                      ; runc: מאפסים משתנים ומערכים (mit: RUNC/CLEARC)
8225 DC27             runc            ldd     MEMSIZ
8227 DD23                             std     FRETOP
8229 DC1B                             ldd     VARTAB
822B DD1D                             std     ARYTAB
