809A 10CE7F36                         lds     #STACKINI       ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
809E 6FE2                             clr     ,-s
80A0 20E0                             bra     main
80A2 170192           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80A5 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
