0040                  TEMPF1          equ     $40             ; קורא: אזורי עבודה של 5 בתים
0045                  TEMPF2          equ     $45
004A                  TEMPF3          equ     $4a
0001                  INTEGR          equ     $01             ; קורא: הבית הנמוך של INT (זוגיות), חופף ל-CHARAC
000A                  TANSGN          equ     $0a             ; קורא: הסימן של הטנגנס
0055                  DEGREE          equ     $55             ; קורא: חופף ל-SGNFLG
