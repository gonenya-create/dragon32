8060 DD74                             std     ENDMEM
8062 CC0C00                           ldd     #$0c00          ; קורא: מצב הגרפיקה בהדלקה — PMODE 0, דף 1, דפים מ-$0600
8065 DDB7                             std     SCTOP
8067 8606                             lda     #$06
8069 97BC                             sta     SCRBAS
806B CC01A9                           ldd     #TEMPST
806E DD0B                             std     TEMPPT
8070 CC804F                           ldd     #$804f          ; קורא: זרע ה-RND, 80 4F C7 52 59
8073 FD0115                           std     $0115
8076 CCC752                           ldd     #$c752
8079 FD0117                           std     $0117
807C 8659                             lda     #$59
807E B70119                           sta     $0119
8081 CC0134                           ldd     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
8084 DDB0                             std     USTBAD
8086 8E0134                           ldx     #USRTAB
8089 338D0082                         leau    err_fc,pcr
808D EF81             1               stu     ,x++
808F 8C0148                           cmpx    #USRTAB+20
8092 25F9                             blo     1B
8094 308D1A85                         leax    execrts,pcr     ; EXEC בלי כתובת אחרי ההדלקה: אצלנו חוזר מיד (ב-Dragon: פתוח)
8098 9F9D                             stx     EXECJP
809A 1701A8                           lbsr    scrtch
809D 308D0493                         leax    banner,pcr
80A1 172E2F                           lbsr    puts
80A4 8D3C             main_ok         bsr     condcr
80A6 308D047B                         leax    m_ok,pcr
80AA 172E26                           lbsr    puts
80AD 170415           main            lbsr    getline
80B0 25F2                             bcs     main_ok         ; BREAK
80B2 8E02DD                           ldx     #LINBUF
80B5 170375                           lbsr    skipsp
80B8 27F3                             beq     main            ; שורה ריקה
80BA 8130                             cmpa    #'0
80BC 250E                             blo     1F
80BE 8139                             cmpa    #'9
80C0 220A                             bhi     1F
80C2 1700DF                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80C5 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80C8 6FE2                             clr     ,-s
80CA 20E1                             bra     main
80CC 17019E           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80CF 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80D1 6FC0                             clr     ,u+
80D3 8E01D9                           ldx     #CRB-1
80D6 9FA6                             stx     TXTPTR
80D8 CCFFFF                           ldd     #$ffff
80DB DD68                             std     CURLIN
80DD 160C90                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
80E0 20C2             endcon          bra     main_ok
                      ; condcr: שורה חדשה אם הסמן לא בעמודה 0
80E2 9689             condcr          lda     CURSOR+1
80E4 841F                             anda    #$1f
80E6 2705                             beq     1F
80E8 860D                             lda     #13
80EA 162D53                           lbra    putc
80ED 39               1               rts
                      ; prin: " IN n" אם בתוכנית, ושורה חדשה
80EE DC68             prin            ldd     CURLIN
80F0 1083FFFF                         cmpd    #$ffff
80F4 270A                             beq     2F
80F6 308D00A5                         leax    m_in,pcr
80FA 172DD6                           lbsr    puts
80FD 17036C                           lbsr    prnum
8100 860D             2               lda     #13
8102 162D3B                           lbra    putc
                      
