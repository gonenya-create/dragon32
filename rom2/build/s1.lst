0013                  RESHO           equ     $13             ; תוצאת הכפל (קורא: $13-$16)
0014                  RESMOH          equ     $14
0015                  RESMO           equ     $15
0016                  RESLO           equ     $16
005B                  BITS            equ     $5b
0045                  DECCNT          equ     $45             ; קורא: חופף ל-TEMPF2, כמו במקור
0046                  DPTFLG          equ     $46
0047                  TENEXP          equ     $47
0048                  EXPSGN          equ     $48
0064                  FBUFPT          equ     $64             ; 2 בתים
