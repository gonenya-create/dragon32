8CA7 2502                             blo     9F
8CA9 1CFA                             andcc   #$fa            ; ספרה: C=0, Z=0
8CAB 39               9               rts
8CAC 2703             2               beq     1F
8CAE 1A01                             orcc    #1              ; אות וכו': C=1, Z=0
8CB0 39                               rts
8CB1 1A05             1               orcc    #5              ; סוף פקודה: C=1, Z=1
8CB3 39                               rts
                      
                      ; synchk: התו הנוכחי חייב להיות A. אחרת ?SN. אחר כך מתקדמים
                      ; chkrp / chkcom / chklp: ')' / ',' / '(' חייבים להיות כאן (כמו SYNRPR/SYNCOM במקור)
8CB4 8629             chkrp           lda     #')
8CB6 8C                               fcb     $8c             ; cmpx #: מדלג על ה-lda הבא (בית אחד במקום bra)
