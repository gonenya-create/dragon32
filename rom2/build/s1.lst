80D2 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80D5 6FE2                             clr     ,-s
80D7 20E1                             bra     main
80D9 1701A2           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80DC 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80DE 6FC0                             clr     ,u+
80E0 8E01D9                           ldx     #CRB-1
80E3 9FA6                             stx     TXTPTR
80E5 CCFFFF                           ldd     #$ffff
80E8 DD68                             std     CURLIN
80EA 160CC8                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
80ED 16FFB8           endcon          lbra    main_ok
                      
                      ; ---------- שגיאות (mit: ERROR) ----------
