8235 270D                             beq     9F
8237 3104                             leay    4,x
8239 6DA0             2               tst     ,y+
823B 26FC                             bne     2B
823D 10AF84                           sty     ,x
8240 1F21                             tfr     y,x
8242 20EF                             bra     1B
8244 39               9               rts
                      
                      ; scrtch (NEW): שני אפסים בתחילת התוכנית, והמשתנים אחריהם (mit: SCRTCH, m6502.asm:1919)
8245 9E19             scrtch          ldx     TXTTAB
8247 6F84                             clr     ,x
