8134 200D                             bra     error
8136 CC4E4F           err_no          ldd     #'N*256+'O
8139 2008                             bra     error
813B CC2F30           err_dv0         ldd     #'/*256+'0
813E 2003                             bra     error
8140 CC534E           err_sn          ldd     #'S*256+'N
8143 10DE21           error           lds     STKTOP          ; mit: STKINI — מחסנית, זמניים, ואין המשך
8146 6FE2                             clr     ,-s
8148 3406                             pshs    d               ; שתי האותיות, ואחריהן ה-0 של הסמן: מחרוזת במחסנית
814A 1700F9                           lbsr    rcsub
814D 17FF75                           lbsr    condcr
8150 863F                             lda     #'?
8152 3402                             pshs    a               ; "?XY"
8154 30E4                             leax    ,s
8156 172B90                           lbsr    puts
8159 3263                             leas    3,s
815B 308C09                           leax    m_err,pcr
815E 172B88                           lbsr    puts
