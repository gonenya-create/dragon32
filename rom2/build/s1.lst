821D 270D                             beq     9F
821F 3104                             leay    4,x
8221 6DA0             2               tst     ,y+
8223 26FC                             bne     2B
8225 10AF84                           sty     ,x
8228 1F21                             tfr     y,x
822A 20EF                             bra     1B
