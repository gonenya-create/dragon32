                      ; Dragon 1982 BASIC — שלב 2, חלק 3: פקודות בקרה.
                      ; תרגום ל-6809 של BASIC-M6502 (mit: IF 2465, ONGOTO 2480, GOSUB 2373, RETURN 2420, DATA/DATAN 2445,
                      ; READ/INPUT/INLOOP 2905-3105, RESTOR 2196, STOP/END/CONT 2227-2268, DEF/FNDOER 4162-4240, PEEK/POKE 4808).
                      ; התאמות ל-Dragon (קורא: מפרט הזיכרון): רשומת GOSUB של 5 בתים עם $BD, ELSE עם מונה IF מקוננים (IFCNT),
                      ; הכתובות הקבועות של DATA/INPUT/CONT, ושגיאות RG OD ID CN UF.
                      ; התנהגויות שהספרים לא קובעים (הודעות INPUT, ENTER ריק, BREAK בתוך INPUT): כמו ב-mit, ופתוחות לבדיקה
                      ; במחשב אמיתי (docs/DRAGON-STAGE1.md).
                      ;
                      ; Portions translated from Microsoft BASIC-M6502, Copyright (c) Microsoft Corporation, MIT License.
                      
0004                  IFCNT           equ     $04             ; קורא: עומק IF בחיפוש ELSE
0008                  SUBFLG          equ     $08             ; קורא: מצב אינדקסים
0009                  INPFLG          equ     $09             ; קורא: 0 = INPUT, $80 = READ
0029                  OLDLIN          equ     $29             ; קורא: השורה להמשך
002B                  VARTXT          equ     $2b             ; קורא: חופף ל-LINNUM
002D                  OLDTXT          equ     $2d             ; קורא: המקום להמשך (0 = אין)
002F                  TXTBEG          equ     $2f             ; קורא: תחילת הפקודה, לחזרה אחרי קלט שגוי
0031                  DATLIN          equ     $31             ; ספר: שורת ה-DATA
0033                  DATPTR          equ     $33             ; ספר: מצביע ה-DATA
0035                  INPPTR          equ     $35             ; ספר: מצביע הקלט
004B                  DEFPNT          equ     $4b             ; קורא: הפונקציה המוגדרת
0087                  IKEYIM          equ     $87             ; מקש שנלחץ בזמן ריצה, בשביל INKEY$
009D                  EXECJP          equ     $9d             ; קורא: היעד של EXEC
02DC                  BUFMIN          equ     LINBUF-1        ; קורא: INPUT כותב כאן פסיק
                      
                      ; ---------- IF ... THEN / GOTO ... ELSE (mit: IF) ----------
959F 17F9A1           if              lbsr    frmevl
95A2 17FB8B                           lbsr    chknum          ; תנאי של מחרוזת: ?TM (ב-Dragon: פתוח)
95A5 9DA5                             jsr     <chrgot
95A7 8181                             cmpa    #$81            ; IF X GO TO / GO SUB: בלי THEN
95A9 2705                             beq     1F
95AB 86BF                             lda     #$bf            ; THEN
95AD 17F5B3                           lbsr    synchk
95B0 0D4F             1               tst     FACEXP          ; 0 = שקר, כל השאר אמת
95B2 2709                             beq     if_no
95B4 9DA5             if_do           jsr     <chrgot
95B6 1024F6D3                         lbcc    goto1           ; מספר: GOTO
95BA 16F5DB                           lbra    gone3           ; פקודה
                      ; שקר: מחפשים ELSE באותה רמה — כל IF בדרך מוסיף רמה, וכל ELSE סוגר אחת. אין: מדלגים על השורה
95BD 0F04             if_no           clr     IFCNT
95BF 9EA6                             ldx     TXTPTR
95C1 8D1C             1               bsr     tkget           ; בלי מרכאות ובלי הבית שאחרי $FF
95C3 2714                             beq     8F
95C5 8185                             cmpa    #$85            ; IF
95C7 2604                             bne     3F
