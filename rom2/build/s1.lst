8269 813F             1               cmpa    #'?             ; ? = PRINT
826B 2606                             bne     2F
826D 8687                             lda     #$87
826F 3001                             leax    1,x
8271 2065                             bra     cr_put1
8273 8127             2               cmpa    #''             ; ' = נקודתיים ו-$83, ואז השאר כמו שהוא (קורא)
8275 2609                             bne     3F
8277 3001                             leax    1,x
8279 CC3A83                           ldd     #$3a83
827C EDC1                             std     ,u++
827E 2070                             bra     cr_rest
8280 8130             3               cmpa    #'0             ; ספרות, : ו-; נשמרים ישר (mit: KLOOP1)
8282 2504                             blo     cr_kw
8284 813B                             cmpa    #';
8286 234E                             bls     cr_put
8288 17006F           cr_kw           lbsr    kwmatch         ; מילה שמורה? C=1, B = הטוקן, KPRE = $FF לפונקציה
828B 2424                             bcc     cr_name
828D 7D03F9                           tst     KPRE
8290 2708                             beq     4F
