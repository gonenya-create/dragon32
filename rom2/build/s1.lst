00D4                  USF             equ     $d4     ; תו המילוי (רווח או *)
02DD                  USDG            equ     LINBUF          ; תשע הספרות
02ED                  UST             equ     LINBUF+16       ; החלק השלם (עם פסיקים)
031D                  USO             equ     LINBUF+64       ; הפלט שלפני הנקודה
                      
