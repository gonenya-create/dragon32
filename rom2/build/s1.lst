8025 26F9                             bne     1B
8027 1729F7                           lbsr    hw_init         ; DP כבר 0 מההדלקה (והקוד לא משנה אותו)
802A B6FF02                           lda     PIA0+2
802D 8605                             lda     #$05
802F B7FF03                           sta     PIA0+3
8032 1CEF                             andcc   #$ef
8034 8632                             lda     #50
8036 978F                             sta     CBLCNT
8038 172A2D                           lbsr    cls
803B 308D2BC1                         leax    testq,pcr       ; תור הבדיקות
803F EC81                             ldd     ,x++
8041 DDFA                             std     KQCNT
8043 9FF8                             stx     KQPTR
                                      ; מצב ההדלקה (ספר): תוכנית ב-$1E01, אפס ב-$1E00, גבולות הזיכרון והמחרוזות
                                      ; (FRETOP ו-TEMPPT: נקבעים ב-scrtch/runc)
8045 8E1E01                           ldx     #$1e01
8048 9F19                             stx     TXTTAB
804A 6F1F                             clr     -1,x
804C CC7FFE                           ldd     #$7ffe          ; קורא: גבול ה-RAM
804F DD27                             std     MEMSIZ
