                      ; Dragon 1982 BASIC — ניסוי שלב 1 (20.10.2026)
                      ;
                      ; מה נבדק: האם הלב של BASIC-M6502 של Microsoft (רישיון MIT, ראו rom2/mit/LICENSE) עובר טוב לשבב 6809,
                      ; ואיך הוא מתאים לסידור הזיכרון של ה-Dragon 32: שמירת שורה מכווצת, המצביעים בכתובות הקבועות, LIST ו-NEW.
                      ;
                      ; יומן מקור (שלב 1):
                      ;   mit  = תרגום ל-6809 של שגרה מ-rom2/mit/m6502.asm (מצוין מספר השורה שם)
                      ;   ספר  = עובדה מהספרים, דרך docs/DRAGON-SPEC-*.md (מפת הזיכרון, טבלת המילים, כללי הכיווץ)
                      ;   קורא = עובדה מהדוח של "הקורא" (Codex) שגונן בדק, בלי קוד
                      ;   שלנו = נכתב כאן
                      ; הכותב (שיחת Dragon) לא ראה את הקוד של ה-Dragon.
                      ;
                      ; Portions of this file are translated from Microsoft BASIC-M6502 (m6502.asm),
                      ; Copyright (c) Microsoft Corporation, licensed under the MIT License (rom2/mit/LICENSE).
                      
8000                                  org     $8000
8000                                  setdp   0
                      
0400                  SCREEN          equ     $0400
0600                  SCREND          equ     $0600
FF00                  PIA0            equ     $ff00
FF20                  PIA1            equ     $ff20
FFC0                  SAM             equ     $ffc0
                      
                      ; ---------- כתובות קבועות של ה-Dragon (ספר: Companion, PRG) ----------
0019                  TXTTAB          equ     $19             ; תחילת התוכנית
001B                  VARTAB          equ     $1b             ; תחילת המשתנים
001D                  ARYTAB          equ     $1d             ; תחילת המערכים
001F                  STREND          equ     $1f             ; סוף המערכים
0021                  STKTOP          equ     $21             ; גבול המחסנית והמחרוזות
0023                  FRETOP          equ     $23
0027                  MEMSIZ          equ     $27
002B                  LINNUM          equ     $2b             ; מספר שורה (קורא: שימוש במקור)
0088                  CURSOR          equ     $88             ; כתובת הסמן (ספר)
0112                  TICKS           equ     $0112           ; TIMER (ספר: Inside)
                      
                      ; ---------- משתני הניסוי, באזור שהספרים מסמנים כפנוי ----------
03EA                  KPREV           equ     $03ea           ; 8 בתים
03F2                  KFOUND          equ     $03f2
03F3                  KNEW            equ     $03f3
03F4                  KROW            equ     $03f4
03F5                  KCOL            equ     $03f5
03F6                  LOWTR           equ     $03f6           ; 2 בתים (השם מ-mit)
03F8                  CRMODE          equ     $03f8           ; כיווץ: 0 רגיל, 1 אחרי DATA
03F9                  KPRE            equ     $03f9           ; קידומת המילה שנמצאה: 0 פקודה, $FF פונקציה
03FA                  LEND            equ     $03fa           ; 2 בתים: סוף טווח LIST
03FC                  LASTKEY         equ     $03fc
                      
00F8                  KQPTR           equ     $f8             ; רק לבדיקות: המקש הבא בתור המוקלד (התור עצמו ב-ROM, testq)
00FA                  KQCNT           equ     $fa             ; כמה מקשים נשארו (2 הבתים ו-1 באזור הפנוי $EA-$FF, קורא)
02DD                  LINBUF          equ     $02dd           ; מאגר השורה (קורא: BUF ב-$02DD)
00F9                  LINMAX          equ     249
01DA                  CRB             equ     $01da           ; הניסוי בלבד: השורה המכווצת, בחוצץ הקלטת (255 בתים). במקור הכיווץ נעשה
                                                              ; בתוך המאגר; בשלב הקלטת עוברים לשיטה הזו
7F36                  STACKINI        equ     $7f36           ; ספר: STKTOP אחרי ההדלקה
                      
                      ; ---------- הפעלה ----------
8000 1A50             reset           orcc    #$50
8002 B7FFDA                           sta     SAM+26
8005 B7FFDD                           sta     SAM+29
8008 10CE7F36                         lds     #STACKINI
800C 6FE2                             clr     ,-s             ; סמן תחתית למחסנית ה-FOR/GOSUB (קורא: ב-STKTOP-1)
800E 4F                               clra
800F 1F8B                             tfr     a,dp
8011 171C4A                           lbsr    hw_init
8014 CC0000                           ldd     #0
8017 FD0112                           std     TICKS
801A B6FF02                           lda     PIA0+2
801D 8605                             lda     #$05
801F B7FF03                           sta     PIA0+3
8022 1CEF                             andcc   #$ef
8024 171C7E                           lbsr    cls
8027 308D1E07                         leax    testq,pcr       ; תור הבדיקות
802B E680                             ldb     ,x+
802D D7FA                             stb     KQCNT
802F 9FF8                             stx     KQPTR
8031 CC0000                           ldd     #0
8034 FD03EA                           std     KPREV
8037 FD03EC                           std     KPREV+2
803A FD03EE                           std     KPREV+4
803D FD03F0                           std     KPREV+6
                                      ; מצב ההדלקה (ספר): תוכנית ב-$1E01, אפס ב-$1E00, גבולות הזיכרון והמחרוזות
8040 7F1E00                           clr     $1e00
8043 CC1E01                           ldd     #$1e01
8046 DD19                             std     TXTTAB
8048 CC7FFE                           ldd     #$7ffe
804B DD27                             std     MEMSIZ
804D DD23                             std     FRETOP
804F CC7F36                           ldd     #$7f36
8052 DD21                             std     STKTOP
8054 CC7FFE                           ldd     #$7ffe          ; קורא: גבול ה-RAM
8057 DD74                             std     ENDMEM
8059 CC0C00                           ldd     #$0c00          ; קורא: מצב הגרפיקה בהדלקה — PMODE 0, דף 1, דפים מ-$0600
805C DDB7                             std     SCTOP
805E 8606                             lda     #$06
8060 97BC                             sta     SCRBAS
8062 CC01A9                           ldd     #TEMPST
8065 DD0B                             std     TEMPPT
8067 308D1A64                         leax    execrts,pcr     ; EXEC בלי כתובת אחרי ההדלקה: אצלנו חוזר מיד (ב-Dragon: פתוח)
806B 9F9D                             stx     EXECJP
806D 1701AB                           lbsr    scrtch
8070 308D0494                         leax    banner,pcr
8074 171C9D                           lbsr    puts
8077 9689             main_ok         lda     CURSOR+1
8079 841F                             anda    #$1f
807B 2705                             beq     1F
807D 860D                             lda     #13
807F 171C36                           lbsr    putc
8082 308D0473         1               leax    m_ok,pcr
8086 171C8B                           lbsr    puts
8089 170401           main            lbsr    getline
808C 25E9                             bcs     main_ok         ; BREAK
808E 8E02DD                           ldx     #LINBUF
8091 170376                           lbsr    skipsp
8094 27F3                             beq     main            ; שורה ריקה
8096 8130                             cmpa    #'0
8098 250E                             blo     1F
809A 8139                             cmpa    #'9
809C 220A                             bhi     1F
809E 1700D5                           lbsr    storeline       ; שורה עם מספר: נשמרת, בלי OK (כמו במקור)
80A1 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
80A4 6FE2                             clr     ,-s
80A6 20E1                             bra     main
80A8 170198           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
80AB 6FC0                             clr     ,u+             ; אחרי השורה: קישור 0000, כמו סוף תוכנית
80AD 6FC0                             clr     ,u+
80AF 8E01D9                           ldx     #CRB-1
80B2 9FA6                             stx     TXTPTR
80B4 CCFFFF                           ldd     #$ffff
80B7 DD68                             std     CURLIN
80B9 160CA9                           lbra    gone            ; המחסנית נשארת: רשומות FOR/GOSUB שמורות עד CONT (mit)
                      
                      ; endcon: סוף התוכנית או סוף השורה הישירה (mit: ENDCON). המחסנית לא מתאפסת
80BC 16FFB8           endcon          lbra    main_ok
                      
                      ; ---------- שגיאות (mit: ERROR) ----------
80BF CC534E           err_sn          ldd     #'S*256+'N
