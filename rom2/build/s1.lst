8000                                  org     $8000
8000                                  setdp   0
                      
0400                  SCREEN          equ     $0400
0600                  SCREND          equ     $0600
FF00                  PIA0            equ     $ff00
FF20                  PIA1            equ     $ff20
FFC0                  SAM             equ     $ffc0
                      
                      ; ---------- כתובות קבועות של ה-Dragon (ספר: Companion, PRG) ----------
0019                  TXTTAB          equ     $19             ; תחילת התוכנית
001B                  VARTAB          equ     $1b             ; תחילת המשתנים
001D                  ARYTAB          equ     $1d             ; תחילת המערכים
001F                  STREND          equ     $1f             ; סוף המערכים
0021                  STKTOP          equ     $21             ; גבול המחסנית והמחרוזות
0023                  FRETOP          equ     $23
0027                  MEMSIZ          equ     $27
002B                  LINNUM          equ     $2b             ; מספר שורה (קורא: שימוש במקור)
0088                  CURSOR          equ     $88             ; כתובת הסמן (ספר)
0112                  TICKS           equ     $0112           ; TIMER (ספר: Inside)
                      
                      ; ---------- משתני הניסוי, באזור שהספרים מסמנים כפנוי ----------
03EA                  KPREV           equ     $03ea           ; 8 בתים
03F2                  KFOUND          equ     $03f2
03F3                  KNEW            equ     $03f3
03F4                  KROW            equ     $03f4
03F5                  KCOL            equ     $03f5
03F6                  LOWTR           equ     $03f6           ; 2 בתים (השם מ-mit)
03F8                  CRMODE          equ     $03f8           ; כיווץ: 0 רגיל, 1 אחרי DATA
03F9                  KPRE            equ     $03f9           ; קידומת המילה שנמצאה: 0 פקודה, $FF פונקציה
03FA                  LEND            equ     $03fa           ; 2 בתים: סוף טווח LIST
03FC                  LASTKEY         equ     $03fc
                      
7A00                  KEYQ            equ     $7a00           ; רק לבדיקות: תור מקשים מוקלדים. בניסוי מחוץ לאזורים הקבועים של ה-Dragon
02DD                  LINBUF          equ     $02dd           ; מאגר השורה (קורא: BUF ב-$02DD)
00F9                  LINMAX          equ     249
7B00                  CRB             equ     $7b00           ; הניסוי בלבד: השורה המכווצת. במקור הכיווץ נעשה בתוך המאגר
7F36                  STACKINI        equ     $7f36           ; ספר: STKTOP אחרי ההדלקה
                      
