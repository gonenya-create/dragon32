                      ; Dragon 1982 BASIC — שלב 3, חלק 3: גרפיקה.
                      ; הכול לפי הקורא: docs/DRAGON-SPEC-GRAPHICS.md (עובדות בלבד, בלי קוד). נכתב מאפס.
                      ; כאן: הליבה (קואורדינטות, צבעים, נקודה), PMODE, SCREEN, PCLS, COLOR, PSET, PRESET, PPOINT, LINE, PCOPY.
                      
00B2                  GFORE           equ     $b2             ; צבע הכתיבה, פנימי 0-3 (קורא 0.1)
00B3                  GBACK           equ     $b3             ; צבע הרקע
00B4                  GACT            equ     $b4             ; הצבע של הפעולה הנוכחית
00B5                  GACTB           equ     $b5             ; אותו צבע בכל הבית (פי $55)
00B6                  GMODE           equ     $b6             ; PMODE 0-4
00B7                  GEND            equ     SCTOP           ; $B7: סוף הדף (רק הבית הגבוה נכתב)
00B9                  GROWB           equ     $b9             ; בתים בשורה, 16 או 32
00BA                  GSTART          equ     $ba             ; תחילת הדף (רק הבית הגבוה נכתב)
00BD                  GX              equ     $bd             ; נקודה 1 (2 בתים כל אחד)
00BF                  GY              equ     $bf
00C1                  GCSS            equ     $c1             ; ערכת הצבעים: 0 או 8
00C2                  GSETF           equ     $c2             ; 1: PSET (צבע הכתיבה), 0: PRESET (הרקע)
00C3                  GX2             equ     $c3             ; נקודה 2
00C5                  GY2             equ     $c5
00C7                  GLX             equ     $c7             ; הנקודה האחרונה, לפני ההקטנה (LINE -(x,y), DRAW)
00C9                  GLY             equ     $c9
00D3                  GMAXX           equ     $d3             ; הנקודה הגבוהה ביותר אחרי ההקטנה (CIRCLE, PAINT)
00D5                  GMAXY           equ     $d5
00DB                  GCHG            equ     $db             ; PAINT: כל נקודה שמשנה בית מדליקה כאן ביטים
00E8                  GANGLE          equ     $e8             ; DRAW: הזווית 0-3
00E9                  GSCALE          equ     $e9             ; DRAW: קנה המידה 0-62
                      
                      ; gfxrun: בהדלקה ובכל RUN (קורא 0.2): הנקודה האחרונה (128,96), זווית וקנה מידה 0
