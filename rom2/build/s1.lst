8275 8120                             cmpa    #$20            ; רווח נשמר (קורא)
8277 2755                             beq     cr_put
8279 8122                             cmpa    #'"
827B 2757                             beq     cr_str
827D 7D03F8                           tst     CRMODE          ; אחרי DATA: הכול כמו שהוא, עד : שמחוץ למרכאות
8280 2709                             beq     1F
