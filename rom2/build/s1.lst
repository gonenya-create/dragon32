8055 FD03EC                           std     KPREV+2
8058 FD03EE                           std     KPREV+4
805B FD03F0                           std     KPREV+6
                                      ; מצב ההדלקה (ספר): תוכנית ב-$1E01, אפס ב-$1E00, גבולות הזיכרון והמחרוזות
805E 7F1E00                           clr     $1e00
8061 CC1E01                           ldd     #$1e01
8064 DD19                             std     TXTTAB
8066 CC7FFE                           ldd     #$7ffe
8069 DD27                             std     MEMSIZ
806B DD23                             std     FRETOP
806D CC7F36                           ldd     #$7f36
