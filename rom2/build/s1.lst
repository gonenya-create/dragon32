8144 CC444E           err_dn          ldd     #'D*256+'N
8147 2008                             bra     error
8149 CC4E4F           err_no          ldd     #'N*256+'O
814C 2003                             bra     error
814E CC2F30           err_dv0         ldd     #'/*256+'0
8151 10DE21           error           lds     STKTOP          ; mit: STKINI — מחסנית, זמניים, ואין המשך
8154 6FE2                             clr     ,-s
8156 8E01A9                           ldx     #TEMPST
8159 9F0B                             stx     TEMPPT
