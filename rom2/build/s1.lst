                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
AFC2                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
AFC2 7FFF01                           clr     PIA0+1          ; CRA: גישה ל-DDR
AFC5 7FFF00                           clr     PIA0            ; DDRA: הכול קלט
AFC8 8604                             lda     #$04
AFCA B7FF01                           sta     PIA0+1          ; CRA: חזרה לנתונים
AFCD 7FFF03                           clr     PIA0+3
AFD0 86FF                             lda     #$ff
AFD2 B7FF02                           sta     PIA0+2          ; DDRB: הכול פלט
AFD5 8604                             lda     #$04
AFD7 B7FF03                           sta     PIA0+3
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
AFDA 7FFF21                           clr     PIA1+1
AFDD 86FE                             lda     #$fe
AFDF B7FF20                           sta     PIA1
AFE2 8604                             lda     #$04
AFE4 B7FF21                           sta     PIA1+1
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
AFE7 7FFF23                           clr     PIA1+3
AFEA 86F8                             lda     #$f8
AFEC B7FF22                           sta     PIA1+2
AFEF 8604                             lda     #$04
AFF1 B7FF23                           sta     PIA1+3
AFF4 7FFF22                           clr     PIA1+2          ; מצב טקסט, ערכת צבעים 0
                                      ; SAM: מצב תצוגה טקסט (V0-V2=0), תחילת המסך ב-$0400 (F1=1)
AFF7 B7FFC0                           sta     SAM+0           ; V0=0
AFFA B7FFC2                           sta     SAM+2           ; V1=0
AFFD B7FFC4                           sta     SAM+4           ; V2=0
B000 B7FFC6                           sta     SAM+6           ; F0=0
