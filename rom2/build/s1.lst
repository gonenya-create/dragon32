82CF A7C0                             sta     ,u+
82D1 E7C0                             stb     ,u+
82D3 20AF                             bra     cr_lp
82D5 C184             4               cmpb    #$84            ; ELSE: לפניו נקודתיים, גם אם כבר היו (קורא)
82D7 2604                             bne     5F
82D9 863A                             lda     #':
82DB A7C0                             sta     ,u+
82DD E7C0             5               stb     ,u+
82DF C186                             cmpb    #$86            ; DATA
82E1 2603                             bne     6F
