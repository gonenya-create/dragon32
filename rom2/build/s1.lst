8B94 2502                             blo     9F
8B96 1CFA                             andcc   #$fa            ; ספרה: C=0, Z=0
8B98 39               9               rts
8B99 2703             2               beq     1F
8B9B 1A01                             orcc    #1              ; אות וכו': C=1, Z=0
8B9D 39                               rts
8B9E 1A05             1               orcc    #5              ; סוף פקודה: C=1, Z=1
8BA0 39                               rts
                      
                      ; synchk: התו הנוכחי חייב להיות A. אחרת ?SN. אחר כך מתקדמים
