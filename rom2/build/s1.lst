81B1 16FF16                           lbra    main
81B4 204552524F52     m_err           fcc     " ERROR"
81BA 00                               fcb     0
81BB 20494E20         m_in            fcc     " IN "
81BF 00                               fcb     0
                      
                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
81C0 170292           storeline       lbsr    linget          ; D = מספר השורה
81C3 DD2B                             std     LINNUM
81C5                  storel2                                 ; EDIT נכנס כאן: LINNUM מוכן, X = הטקסט
81C5 170281                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81C8 1700BE                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81CB 1F30                             tfr     u,d
81CD 8301DA                           subd    #CRB
81D0 C30004                           addd    #4              ; קישור + מספר + טקסט + 0
81D3 3406                             pshs    d               ; האורך
81D5 DC2B                             ldd     LINNUM
81D7 8D57                             bsr     fndlin          ; Y = השורה (C=1 אם קיימת)
81D9 2402                             bcc     1F
81DB 8D3F                             bsr     dellin          ; קיימת: קודם מוחקים
81DD 7D01DA           1               tst     CRB
81E0 2734                             beq     9F              ; רק מספר: רק מחיקה
                                      ; מזיזים את [Y..VARTAB) למעלה באורך השורה (mit: BLTU)
81E2 9E1B                             ldx     VARTAB
81E4 DC1B                             ldd     VARTAB
81E6 E3E4                             addd    ,s
81E8 3416                             pshs    d,x             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON)
81EA 1716DC                           lbsr    reason
81ED 3516                             puls    d,x
81EF 1F03                             tfr     d,u
81F1 DD1B                             std     VARTAB
81F3 10BF03F6                         sty     LOWTR
81F7 BC03F6           2               cmpx    LOWTR
81FA 2306                             bls     3F
81FC A682                             lda     ,-x
81FE A7C2                             sta     ,-u
8200 20F5                             bra     2B
8202 CCFFFF           3               ldd     #$ffff          ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
8205 EDA4                             std     ,y
8207 DC2B                             ldd     LINNUM
8209 ED22                             std     2,y
820B 3324                             leau    4,y
820D 8E01DA                           ldx     #CRB
8210 A680             4               lda     ,x+
8212 A7C0                             sta     ,u+
8214 26FA                             bne     4B
8216 3262             9               leas    2,s
8218 8D33                             bsr     lnkprg
821A 204F                             bra     runc
                      
                      ; dellin: מוחק את השורה ב-Y (mit: m6502.asm:1571-1608)
821C 3476             dellin          pshs    d,x,y,u
821E AEA4                             ldx     ,y              ; השורה הבאה
8220 1F23                             tfr     y,u
8222 9C1B             1               cmpx    VARTAB
8224 2406                             bhs     2F
8226 A680                             lda     ,x+
8228 A7C0                             sta     ,u+
822A 20F6                             bra     1B
822C DF1B             2               stu     VARTAB
822E 35F6                             puls    d,x,y,u,pc
                      
                      ; fndlin: מחפש את השורה D. Y = הרשומה שלה או הראשונה שגדולה ממנה (או סמן הסוף). C=1 אם נמצאה
                      ; (mit: FNDLIN, m6502.asm:1879)
8230 109E19           fndlin          ldy     TXTTAB
8233                  fndlnc
8233 3406             1               pshs    d
8235 ECA4                             ldd     ,y
8237 3506                             puls    d
8239 270C                             beq     8F              ; סוף התוכנית
823B 10A322                           cmpd    2,y
823E 270A                             beq     9F
8240 2505                             blo     8F
8242 10AEA4                           ldy     ,y
8245 20EC                             bra     1B
8247 1CFE             8               andcc   #$fe
8249 39                               rts
824A 1A01             9               orcc    #1
824C 39                               rts
                      
                      ; lnkprg: מחשב מחדש את כל הקישורים. סוף כל שורה = ה-0 שבסופה; סוף התוכנית = קישור $0000
                      ; (mit: LNKPRG/CHEAD, m6502.asm:1642)
824D 9E19             lnkprg          ldx     TXTTAB
824F EC84             1               ldd     ,x
8251 270D                             beq     9F
8253 3104                             leay    4,x
8255 6DA0             2               tst     ,y+
8257 26FC                             bne     2B
8259 10AF84                           sty     ,x
825C 1F21                             tfr     y,x
825E 20EF                             bra     1B
8260 39               9               rts
                      
                      ; scrtch (NEW): שני אפסים בתחילת התוכנית, והמשתנים אחריהם (mit: SCRTCH, m6502.asm:1919)
8261 9E19             scrtch          ldx     TXTTAB
8263 6F84                             clr     ,x
8265 6F01                             clr     1,x
8267 3002                             leax    2,x
8269 9F1B                             stx     VARTAB
                      ; runc: מאפסים משתנים ומערכים (mit: RUNC/CLEARC)
826B DC27             runc            ldd     MEMSIZ
826D DD23                             std     FRETOP
826F DC1B                             ldd     VARTAB
8271 DD1D                             std     ARYTAB
8273 DD1F                             std     STREND
8275 DC19                             ldd     TXTTAB          ; RESTORE
8277 830001                           subd    #1
827A DD33                             std     DATPTR
827C CC01A9                           ldd     #TEMPST
827F DD0B                             std     TEMPPT
8281 CC0000                           ldd     #0              ; אין המשך
8284 DD2D                             std     OLDTXT
8286 0F08                             clr     SUBFLG
8288 39                               rts
                      
                      ; ---------- כיווץ (mit: CRUNCH, m6502.asm:1785; כללי ה-Dragon: קורא + ספר) ----------
                      ; X = הטקסט (מסתיים ב-0). הפלט ב-CRB, מסתיים ב-0. U = אחרי ה-0
8289 CE01DA           crunch          ldu     #CRB
828C 7F03F8                           clr     CRMODE
828F A684             cr_lp           lda     ,x
8291 102700A1                         lbeq    cr_end
8295 8120                             cmpa    #$20            ; רווח נשמר (קורא)
8297 277C                             beq     cr_put
8299 8122                             cmpa    #'"
829B 277F                             beq     cr_str
829D 7D03F8                           tst     CRMODE          ; אחרי DATA: הכול כמו שהוא, עד : שמחוץ למרכאות
82A0 2709                             beq     1F
82A2 813A                             cmpa    #':
82A4 266F                             bne     cr_put
82A6 7F03F8                           clr     CRMODE
82A9 206A                             bra     cr_put
82AB 813F             1               cmpa    #'?             ; ? = PRINT
82AD 2606                             bne     2F
82AF 8687                             lda     #$87
82B1 3001                             leax    1,x
82B3 2062                             bra     cr_put1
82B5 8127             2               cmpa    #''             ; ' = נקודתיים ו-$83, ואז השאר כמו שהוא (קורא)
82B7 2609                             bne     3F
82B9 3001                             leax    1,x
82BB CC3A83                           ldd     #$3a83
82BE EDC1                             std     ,u++
82C0 206D                             bra     cr_rest
82C2 8130             3               cmpa    #'0             ; ספרות, : ו-; נשמרים ישר (mit: KLOOP1)
82C4 2504                             blo     cr_kw
82C6 813B                             cmpa    #';
82C8 234B                             bls     cr_put
82CA 8D6D             cr_kw           bsr     kwmatch         ; מילה שמורה? C=1, B = הטוקן, KPRE = $FF לפונקציה
82CC 2424                             bcc     cr_name
82CE 7D03F9                           tst     KPRE
82D1 2708                             beq     4F
82D3 86FF                             lda     #$ff            ; פונקציה: $FF ואחריו הטוקן
82D5 A7C0                             sta     ,u+
82D7 E7C0                             stb     ,u+
82D9 20B4                             bra     cr_lp
82DB C184             4               cmpb    #$84            ; ELSE: לפניו נקודתיים, גם אם כבר היו (קורא)
82DD 2604                             bne     5F
82DF 863A                             lda     #':
82E1 A7C0                             sta     ,u+
82E3 E7C0             5               stb     ,u+
82E5 C186                             cmpb    #$86            ; DATA
82E7 2603                             bne     6F
82E9 7C03F8                           inc     CRMODE
82EC C182             6               cmpb    #$82            ; REM: השאר כמו שהוא
