824B 3002                             leax    2,x
824D 9F1B                             stx     VARTAB
                      ; runc: מאפסים משתנים ומערכים (mit: RUNC/CLEARC)
824F DC27             runc            ldd     MEMSIZ
8251 DD23                             std     FRETOP
8253 DC1B                             ldd     VARTAB
8255 DD1D                             std     ARYTAB
8257 DD1F                             std     STREND
8259 DC19                             ldd     TXTTAB          ; RESTORE
825B 830001                           subd    #1
825E DD33                             std     DATPTR
8260 CC01A9                           ldd     #TEMPST
8263 DD0B                             std     TEMPPT
8265 CC0000                           ldd     #0              ; אין המשך
8268 DD2D                             std     OLDTXT
826A 0F08                             clr     SUBFLG
826C 39                               rts
                      
                      ; ---------- כיווץ (mit: CRUNCH, m6502.asm:1785; כללי ה-Dragon: קורא + ספר) ----------
                      ; X = הטקסט (מסתיים ב-0). הפלט ב-CRB, מסתיים ב-0. U = אחרי ה-0
826D CE01DA           crunch          ldu     #CRB
8270 7F03F8                           clr     CRMODE
8273 A684             cr_lp           lda     ,x
8275 102700A1                         lbeq    cr_end
8279 8120                             cmpa    #$20            ; רווח נשמר (קורא)
827B 277C                             beq     cr_put
827D 8122                             cmpa    #'"
827F 277F                             beq     cr_str
8281 7D03F8                           tst     CRMODE          ; אחרי DATA: הכול כמו שהוא, עד : שמחוץ למרכאות
8284 2709                             beq     1F
8286 813A                             cmpa    #':
8288 266F                             bne     cr_put
828A 7F03F8                           clr     CRMODE
828D 206A                             bra     cr_put
828F 813F             1               cmpa    #'?             ; ? = PRINT
8291 2606                             bne     2F
8293 8687                             lda     #$87
8295 3001                             leax    1,x
8297 2062                             bra     cr_put1
8299 8127             2               cmpa    #''             ; ' = נקודתיים ו-$83, ואז השאר כמו שהוא (קורא)
829B 2609                             bne     3F
829D 3001                             leax    1,x
829F CC3A83                           ldd     #$3a83
82A2 EDC1                             std     ,u++
82A4 206D                             bra     cr_rest
82A6 8130             3               cmpa    #'0             ; ספרות, : ו-; נשמרים ישר (mit: KLOOP1)
82A8 2504                             blo     cr_kw
82AA 813B                             cmpa    #';
82AC 234B                             bls     cr_put
82AE 8D6D             cr_kw           bsr     kwmatch         ; מילה שמורה? C=1, B = הטוקן, KPRE = $FF לפונקציה
82B0 2424                             bcc     cr_name
82B2 7D03F9                           tst     KPRE
82B5 2708                             beq     4F
82B7 86FF                             lda     #$ff            ; פונקציה: $FF ואחריו הטוקן
82B9 A7C0                             sta     ,u+
82BB E7C0                             stb     ,u+
82BD 20B4                             bra     cr_lp
82BF C184             4               cmpb    #$84            ; ELSE: לפניו נקודתיים, גם אם כבר היו (קורא)
82C1 2604                             bne     5F
82C3 863A                             lda     #':
82C5 A7C0                             sta     ,u+
82C7 E7C0             5               stb     ,u+
82C9 C186                             cmpb    #$86            ; DATA
82CB 2603                             bne     6F
82CD 7C03F8                           inc     CRMODE
82D0 C182             6               cmpb    #$82            ; REM: השאר כמו שהוא
82D2 273F                             beq     cr_rest
82D4 209D                             bra     cr_lp
82D6 A684             cr_name         lda     ,x              ; לא מילה שמורה. אות: שם, וכל האותיות והספרות שאחריה נשמרות כמו שהן (קורא)
82D8 8141                             cmpa    #'A
82DA 251D                             blo     cr_put
82DC 815A                             cmpa    #'Z
