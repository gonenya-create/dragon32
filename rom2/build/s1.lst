8193 E361                             addd    1,s             ; *10
8195 EBE0                             addb    ,s+
8197 8900                             adca    #0
8199 3262                             leas    2,s
819B 20D8                             bra     1B
819D 3586             9               puls    d,pc
                      
                      ; ---------- שמירת שורה (mit: MAIN1/NODEL/STOLOP, m6502.asm:1567-1641) ----------
819F 8DD2             storeline       bsr     linget          ; D = מספר השורה
81A1 DD2B                             std     LINNUM
81A3                  storel2                                 ; EDIT נכנס כאן: LINNUM מוכן, X = הטקסט
81A3 1700AC                           lbsr    skipsp          ; רווחים אחרי המספר לא נשמרים (mit: CHRGET מדלג עליהם)
81A6 1700C2                           lbsr    crunch          ; X = הטקסט → CRB; U = הסוף (אחרי ה-0)
81A9 1F30                             tfr     u,d
81AB 8301D6                           subd    #CRB-4          ; קישור + מספר + טקסט + 0
81AE 3406                             pshs    d               ; האורך
81B0 DC2B                             ldd     LINNUM
81B2 8D4C                             bsr     fndlin          ; Y = השורה (C=1 אם קיימת)
81B4 2410                             bcc     1F
81B6 AEA4                             ldx     ,y              ; קיימת: קודם מוחקים (mit: m6502.asm:1571-1608). X = השורה הבאה
81B8 1F23                             tfr     y,u
81BA 9C1B             5               cmpx    VARTAB
81BC 2406                             bhs     6F
81BE A680                             lda     ,x+
81C0 A7C0                             sta     ,u+
81C2 20F6                             bra     5B
81C4 DF1B             6               stu     VARTAB
81C6 7D01DA           1               tst     CRB
81C9 272F                             beq     9F              ; רק מספר: רק מחיקה
                                      ; מזיזים את [Y..VARTAB) למעלה באורך השורה (mit: BLTU)
81CB DC1B                             ldd     VARTAB
81CD E3E4                             addd    ,s
81CF 3426                             pshs    d,y             ; יש מקום? אחרת ?OM לפני שמזיזים משהו (mit: REASON). Y = הגבול התחתון
81D1 1714DB                           lbsr    reason
81D4 9E1B                             ldx     VARTAB
81D6 3506                             puls    d
81D8 1F03                             tfr     d,u
81DA DD1B                             std     VARTAB
81DC ACE4             2               cmpx    ,s
81DE 2306                             bls     3F
81E0 A682                             lda     ,-x
81E2 A7C2                             sta     ,-u
81E4 20F6                             bra     2B
81E6 3520             3               puls    y
81E8 10AFA4                           sty     ,y              ; קישור זמני שאינו אפס; lnkprg מחשב את האמיתי
81EB DC2B                             ldd     LINNUM
81ED ED22                             std     2,y
81EF 3324                             leau    4,y
81F1 8E01DA                           ldx     #CRB
81F4 A680             4               lda     ,x+
81F6 A7C0                             sta     ,u+
81F8 26FA                             bne     4B
81FA 3262             9               leas    2,s
81FC 8D1B                             bsr     lnkprg
81FE 2035                             bra     runc
                      
                      ; fndlin: מחפש את השורה D. Y = הרשומה שלה או הראשונה שגדולה ממנה (או סמן הסוף). C=1 אם נמצאה
                      ; (mit: FNDLIN, m6502.asm:1879)
8200 109E19           fndlin          ldy     TXTTAB
8203                  fndlnc
8203 6DA4             1               tst     ,y              ; סוף התוכנית: קישור 0 (קישור אמיתי תמיד מעל $00FF)
8205 270C                             beq     8F
8207 10A322                           cmpd    2,y
820A 270A                             beq     9F
820C 2505                             blo     8F
820E 10AEA4                           ldy     ,y
8211 20F0                             bra     1B
8213 1CFE             8               andcc   #$fe
8215 39                               rts
8216 1A01             9               orcc    #1
8218 39                               rts
                      
                      ; lnkprg: מחשב מחדש את כל הקישורים. סוף כל שורה = ה-0 שבסופה; סוף התוכנית = קישור $0000
                      ; (mit: LNKPRG/CHEAD, m6502.asm:1642)
8219 9E19             lnkprg          ldx     TXTTAB
