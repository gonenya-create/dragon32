8043 EC81                             ldd     ,x++
8045 DDFA                             std     KQCNT
8047 9FF8                             stx     KQPTR
                                      ; מצב ההדלקה (ספר): תוכנית ב-$1E01, אפס ב-$1E00, גבולות הזיכרון והמחרוזות
8049 7F1E00                           clr     $1e00
804C CC1E01                           ldd     #$1e01
804F DD19                             std     TXTTAB
8051 CC7FFE                           ldd     #$7ffe
