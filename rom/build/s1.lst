BDED 301E             1               leax    -2,x
BDEF 8CFFC8                           cmpx    #SAM+8          ; במקום F1=0 ($FFC8): F1=1 ($FFC9)
BDF2 2603                             bne     2F
BDF4 A701                             sta     1,x
BDF6 8C                               fcb     $8c             ; cmpx #: מדלג על השורה הבאה
BDF7 A784             2               sta     ,x
BDF9 8CFFC0                           cmpx    #SAM
BDFC 26EF                             bne     1B
BDFE 3592                             puls    a,x,pc
                      ; noserv: המדפסת (בהמשך) וכניסות התקשורת שאין ב-Dragon 32
BE00 39               noserv          rts
                      ; ---------- מסך ----------
BE01 8E0400           cls             ldx     #SCREEN
                      ; clrto: הסמן ב-X, ומשם עד סוף המסך רווחים (גם scroll). clrxd: אותו דבר עם התא שב-D (CLS n)
BE04 CC6060           clrto           ldd     #$6060          ; רווח (ירוק)
BE07 9F88             clrxd           stx     CURSOR
BE09 ED81             1               std     ,x++
BE0B 8C0600                           cmpx    #SCREND
BE0E 25F9                             blo     1B
