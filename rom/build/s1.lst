                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BEAE 3031323334353637 KEYMAP          fcc     "01234567"
BEB6 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BEBE 4041424344454647                 fcc     "@ABCDEFG"
BEC6 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BECE 5051525354555657                 fcc     "PQRSTUVW"
BED6 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BEDE 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BEE6 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
BEEE 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
                      ; הטבלה ($0151-$0159) שומרת את מה שנקרא מ-PIA0 כמו במקור: מקש לחוץ = 0, וביט 7 דולק (29.10). תוכנות קוראות אותה ישר:
                      ; SAS (Peaksoft) בודק PEEK(341)=223 לחץ למעלה, והטוען של Cricket כותב לשם $FF ו-$BF
BEF6 3414             keyindex        pshs    b,x
BEF8 8E0152                           ldx     #KPREV          ; KALL ($0151) צמוד לפניו: גישה דרך X חוסכת שני בתים (28.10)
BEFB 4F                               clra                    ; כל העמודות למטה, קריאה אחת. בלי שינוי מהפעם הקודמת: יוצאים מהר (קורא 2.10)
BEFC B7FF02                           sta     PIA0+2          ; כתיבה בלי קריאה: CLR קורא קודם את $FF02, והקריאה מוחקת את דגל פסיקת השדה (Phantom Slayer קפא). אותם 7 מחזורים
BEFF B6FF00                           lda     PIA0
BF02 8A80                             ora     #$80            ; כמו במקור: מה שנקרא, וביט 7 דולק
BF04 A11F                             cmpa    -1,x            ; KALL
BF06 2771                             beq     ki_none
BF08 A71F                             sta     -1,x
BF0A 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
BF0D CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BF10 B7FF02           ki_col          sta     PIA0+2
BF13 3402                             pshs    a               ; המסכה
BF15 A685                             lda     b,x             ; הקודם
BF17 3402                             pshs    a
BF19 B6FF00                           lda     PIA0
BF1C 8A80                             ora     #$80
BF1E A785                             sta     b,x             ; לסריקה הבאה, כמו במקור (לחוץ = 0)
BF20 43                               coma                    ; השורות הלחוצות עכשיו = 1 (ביט 7 = 0)
BF21 A4E0                             anda    ,s+             ; חדש = עכשיו וגם לא קודם (בקודם, לא לחוץ = 1)
BF23 C103                             cmpb    #3
BF25 2502                             blo     3F
BF27 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF29 B703F3           3               sta     KNEW
BF2C 7D03F2                           tst     KFOUND
BF2F 261A                             bne     ki_next
BF31 4D                               tsta
BF32 2717                             beq     ki_next
BF34 F703F5                           stb     KCOL
BF37 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
BF3A 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF3B 44               4               lsra
BF3C 2507                             bcs     5F
BF3E 7C03F4                           inc     KROW
BF41 CB08                             addb    #8
BF43 20F6                             bra     4B
BF45 F703F2           5               stb     KFOUND
BF48 F603F5                           ldb     KCOL
BF4B 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF4D 48                               lsla
BF4E 4C                               inca
BF4F 5C                               incb
BF50 C108                             cmpb    #8
BF52 25BC                             blo     ki_col
BF54 F603F2                           ldb     KFOUND
BF57 2720                             beq     ki_none
BF59 5A                               decb
BF5A A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C = 0 כשהוא לחוץ (לחוץ = 0 בטבלה)
BF5C 48                               lsla
BF5D 48                               lsla
BF5E 8EBEAE                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF61 A685                             lda     b,x             ; התו
BF63 2714                             beq     ki_none
BF65 2513                             bcs     ki_out          ; בלי SHIFT
BF67 C110                             cmpb    #16
BF69 2507                             blo     1F
BF6B 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF6D 260B                             bne     ki_out
BF6F 4C                               inca
BF70 2008                             bra     ki_out
BF72 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF75 A685                             lda     b,x
BF77 2001                             bra     ki_out
BF79 4F               ki_none         clra
