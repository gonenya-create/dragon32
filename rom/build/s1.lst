9797 E661                             ldb     1,s             ; גבוה*נמוך
9799 2004                             bra     2F
979B 96F5             1               lda     CURTOL+1        ; נמוך*גבוה
979D E6E4                             ldb     ,s
979F 3D               2               mul
97A0 4D                               tsta
97A1 26E7                             bne     ary_om
97A3 E7E4                             stb     ,s
97A5 96F5                             lda     CURTOL+1
97A7 E661                             ldb     1,s
