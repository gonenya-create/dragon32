98E7 A644                             lda     4,u
98E9 3402                             pshs    a
98EB 10AE42                           ldy     2,u
98EE ECC4                             ldd     ,u
98F0 3426                             pshs    y,d
98F2 EC84                             ldd     ,x              ; הגוף
98F4 9EA6                             ldx     TXTPTR
