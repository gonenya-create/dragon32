8CE3 39                               rts
8CE4 1A05             1               orcc    #5              ; סוף פקודה: C=1, Z=1
8CE6 39                               rts
                      
                      ; synchk: התו הנוכחי חייב להיות A. אחרת ?SN. אחר כך מתקדמים
                      ; chkrp / chkcom / chklp: ')' / ',' / '(' חייבים להיות כאן (כמו SYNRPR/SYNCOM במקור)
8CE7 8629             chkrp           lda     #')
8CE9 8C                               fcb     $8c             ; cmpx #: מדלג על ה-lda הבא (בית אחד במקום bra)
