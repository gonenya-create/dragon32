BF8D A784                             sta     ,x
BF8F 8632                             lda     #50
BF91 978F                             sta     CBLCNT
BF93 8E045E           1               ldx     #$045e
BF96 301F             2               leax    -1,x
BF98 26FC                             bne     2B
BF9A 3592                             puls    a,x,pc
