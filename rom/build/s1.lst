BF1F CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BF22 B7FF02           ki_col          sta     PIA0+2
BF25 3402                             pshs    a               ; המסכה
BF27 A685                             lda     b,x             ; הקודם
BF29 3402                             pshs    a
BF2B B6FF00                           lda     PIA0
BF2E 43                               coma
BF2F 847F                             anda    #$7f            ; השורות הלחוצות עכשיו
BF31 A785                             sta     b,x             ; לסריקה הבאה
BF33 A8E0                             eora    ,s+
BF35 A485                             anda    b,x             ; חדש = עכשיו וגם לא קודם
BF37 C103                             cmpb    #3
BF39 2502                             blo     3F
BF3B 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF3D B703F3           3               sta     KNEW
BF40 7D03F2                           tst     KFOUND
BF43 261A                             bne     ki_next
BF45 4D                               tsta
BF46 2717                             beq     ki_next
BF48 F703F5                           stb     KCOL
BF4B 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
BF4E 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF4F 44               4               lsra
BF50 2507                             bcs     5F
BF52 7C03F4                           inc     KROW
BF55 CB08                             addb    #8
BF57 20F6                             bra     4B
BF59 F703F2           5               stb     KFOUND
