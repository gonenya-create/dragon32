                      ; ary_new: בונים רשומה ב-STREND (mit: NOTFDD)
971A 9FF6             ary_new         stx     ARYREC
971C DC37                             ldd     VARNAM
971E ED84                             std     ,x
9720 3105                             leay    5,x             ; הגדלים
