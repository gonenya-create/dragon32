                      ; Dragon 1982 BASIC — שלב 3, חלק 5: קלטת. צעד 2: פקודות הקבצים (CSAVE, CLOAD, CSAVEM, CLOADM, SKIPF, MOTOR).
                      ; הכול לפי הקורא: docs/DRAGON-SPEC-TAPE.md, סעיפים 2-3 (עובדות בלבד, בלי קוד). נכתב מאפס.
                      ; צעד 3: ההתקנים, קובצי נתונים (OPEN, CLOSE, PRINT #, INPUT #, EOF) וקובצי ASCII (סעיפים 3.3-3.13, 4).
                      
006A                  DEVCFW          equ     $6a             ; פרמטרי ההתקן (קורא: מדפסת 1.6, 7.2): רוחב שדה הפסיק
006B                  DEVLCF          equ     $6b             ; תחילת שדה הפסיק האחרון
006C                  DEVPOS          equ     $6c             ; המקום בשורה
006D                  DEVWID          equ     $6d             ; רוחב השורה (0 = אין סוף)
006E                  SPCIO           equ     $6e             ; קלט-פלט מיוחד: $FF כשההתקן הוא הקלטת (קורא 4.4)
006F                  DEVNUM          equ     $6f             ; ההתקן: 0 מסך/מקלדת, $FF קלטת, $FE מדפסת
0070                  EOFFLG          equ     $70             ; סוף קובץ: נדלק כשהחוצץ ריק בקריאת תו
0079                  CBFCNT          equ     $79             ; כמה תווים בחוצץ הקלטת
007A                  CBFPTR          equ     $7a             ; 2 בתים: התו הבא בחוצץ (קריאה)
0078                  FSTATE          equ     $78             ; הקובץ: 0 סגור, 1 פתוח לקריאה, 2 פתוח לכתיבה
01D1                  FNLEN           equ     $01d1           ; אורך השם שבפקודה (0 = בלי שם)
01D2                  FNAME           equ     $01d2           ; 8 בתים: השם
01DA                  TBUF            equ     $01da           ; חוצץ הקלטת (255 בתים); 15 הראשונים הם גם הכותרת
01E2                  HTYPE           equ     $01e2           ; בכותרת: סוג הקובץ (0 תוכנית, 1 נתונים, 2 קוד מכונה)
01E3                  HASCII          equ     $01e3           ; 0 בינארי, $FF ASCII
01E4                  HGAP            equ     $01e4           ; 0 רציף, $FF עם פערים
01E5                  HEXEC           equ     $01e5           ; 2 בתים: כתובת הביצוע
01E7                  HLOAD           equ     $01e7           ; 2 בתים: כתובת הטעינה
                      
