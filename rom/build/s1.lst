8EF5 20DA                             bra     snerr
8EF7 81BA             1               cmpa    #$ba
8EF9 2308                             bls     2F
8EFB 81CD                             cmpa    #$cd            ; מילים של מתאר 0 שאינן פקודה (TO, THEN, TAB( ...): ?SN
8EFD 23D2                             bls     snerr
8EFF 6E9F012D                         jmp     [DESC1+3]       ; מעבר למתאר 0: דרך $012D, עם A = הטוקן ו-TXTPTR עליו (קורא: מדפסת 7.5)
8F03 48               2               lsla                    ; (טוקן-$80)*2
8F04 FE0123                           ldu     $0123           ; טבלת הכתובות של מתאר 0, מה-RAM (כמו במקור: הרחבה יכולה להחליף אותה; קורא 8.2)
8F07 EEC6                             ldu     a,u
