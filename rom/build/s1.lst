9826 2709                             beq     if_no
9828 9DA5             if_do           jsr     <chrgot
982A 1025F733                         lbcs    goto1           ; מספר: GOTO
982E 16F6A3                           lbra    gone3           ; פקודה
                      ; שקר: מחפשים ELSE באותה רמה — כל IF בדרך מוסיף רמה, וכל ELSE סוגר אחת. אין: מדלגים על השורה
9831 0F04             if_no           clr     IFCNT
9833 9EA6                             ldx     TXTPTR
