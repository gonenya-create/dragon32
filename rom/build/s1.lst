BE23 8140                             cmpa    #$40
BE25 250A                             blo     1F
BE27 8160                             cmpa    #$60
BE29 2508                             blo     2F
BE2B 8180                             cmpa    #$80
BE2D 2404                             bhs     2F
BE2F 8B60                             adda    #$60            ; $60-$7F: יחד עם ה-$40 שאחריו, פחות $60
BE31 8B40             1               adda    #$40
BE33 A780             2               sta     ,x+
BE35 9F88             pc_adv          stx     CURSOR
BE37 8C0600                           cmpx    #SCREND
BE3A 252A                             blo     putc_done
                                      ; גלילה: כל השורות עולות אחת, והאחרונה מתנקה
BE3C 8E0400                           ldx     #SCREEN
BE3F EC8820           4               ldd     32,x
BE42 ED81                             std     ,x++
BE44 8C05E0                           cmpx    #SCREND-32
BE47 25F6                             blo     4B
BE49 8DB9                             bsr     clrto
BE4B 2019                             bra     putc_done
BE4D D689             pc_cr           ldb     CURSOR+1        ; כמה תאים עד סוף השורה (1-32)
BE4F CAE0                             orb     #$e0            ; 32 פחות העמודה
BE51 50                               negb
BE52 8660                             lda     #$60
BE54 A780             3               sta     ,x+
