                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
BDE2                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
BDE2 8EFF00                           ldx     #PIA0
BDE5 2003                             bra     isl_bde7_e      ;@isl
BDE7                                  fill    $ff,$bde7-*     ;@isl
BDE7 7EB8B2                           jmp     tsync   ;@isl
BDEA                  isl_bde7_e      ;@isl
BDEA C634                             ldb     #$34            ; CR: גישה לנתונים; CA2/CB2 פלט נמוך — בוררי הצליל, הצליל והמנוע כבויים (קורא: צליל 0.3)
BDEC 4F                               clra
BDED 8D17                             bsr     piaddr          ; DDRA: הכול קלט
BDEF 86FF                             lda     #$ff
BDF1 8D11                             bsr     piaddr2         ; DDRB: הכול פלט
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
BDF3 30881E                           leax    PIA1-PIA0-2,x
BDF6 86FE                             lda     #$fe
BDF8 8D0C                             bsr     piaddr
BDFA 6F84                             clr     ,x              ; $FF20 = 0
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
BDFC 86F8                             lda     #$f8
BDFE 8D04                             bsr     piaddr2
BE00 8D0B                             bsr     txtmode         ; מצב טקסט, ערכת צבעים 0; SAM: מצב 0, המסך ב-$0400
BE02 6EA4                             jmp     ,y              ; חוזרים דרך Y (קורא: ממשקים, הכניסה ב-$8000)
                      ; piaddr: CR (1,x) לגישה ל-DDR, DDR (,x) = A, ו-CR = B. piaddr2: אותו דבר לצד B (X עולה ב-2)
BE04 3002             piaddr2         leax    2,x
BE06 6F01             piaddr          clr     1,x
BE08 A784                             sta     ,x
BE0A E701                             stb     1,x
BE0C 39                               rts
                      ; txtmode: מצב טקסט (קורא: SAMALP). ב-$FF22 נשארים 3 הביטים התחתונים; SAM: מצב 0, המסך ב-$0400
BE0D 3412             txtmode         pshs    a,x
BE0F B6FF22                           lda     PIA1+2
BE12 8407                             anda    #$07
BE14 B7FF22                           sta     PIA1+2
BE17 8EFFD4                           ldx     #SAM+20 ; לפי הסדר שבמקור: $FFD2 $FFD0 $FFCE $FFCC $FFCA $FFC9 $FFC6 $FFC4 $FFC2 $FFC0
BE1A 301E             1               leax    -2,x
BE1C 8CFFC8                           cmpx    #SAM+8          ; במקום F1=0 ($FFC8): F1=1 ($FFC9)
BE1F 2603                             bne     2F
BE21 A701                             sta     1,x
BE23 8C                               fcb     $8c             ; cmpx #: מדלג על השורה הבאה
BE24 A784             2               sta     ,x
BE26 8CFFC0                           cmpx    #SAM
BE29 26EF                             bne     1B
BE2B 3592                             puls    a,x,pc
                      ; noserv: המדפסת (בהמשך) וכניסות התקשורת שאין ב-Dragon 32
BE2D 39               noserv          rts
                      ; ---------- מסך ----------
BE2E 8E0400           cls             ldx     #SCREEN
                      ; clrto: הסמן ב-X, ומשם עד סוף המסך רווחים (גם scroll). clrxd: אותו דבר עם התא שב-D (CLS n)
BE31 CC6060           clrto           ldd     #$6060          ; רווח (ירוק)
BE34 9F88             clrxd           stx     CURSOR
BE36 ED81             1               std     ,x++
BE38 8C0600                           cmpx    #SCREND
BE3B 25F9                             blo     1B
BE3D 39                               rts
                      
                      ; putc: התו ב-A למסך במקום הסמן (קורא: docs/DRAGON-SPEC-SCREEN.md, סעיף 3)
                      ; קודם חוזרים למצב טקסט (SAMALP). $20-$3F → $60-$7F; $40-$5F ו-$80-$FF כמו שהם; $60-$7F → $00-$1F (הפוך).
                      ; 13: רווחים עד סוף השורה (כולל התא הנוכחי) ושורה חדשה. 8: תא אחד אחורה ורווח. שאר תווי הבקרה: כלום
BE3E 3416             putc            pshs    a,b,x
BE40 8DCB                             bsr     txtmode
BE42 9E88                             ldx     CURSOR
BE44 810D                             cmpa    #13
BE46 2732                             beq     pc_cr
BE48 8108                             cmpa    #8
BE4A 273C                             beq     pc_bs
BE4C 8120                             cmpa    #$20
BE4E 2543                             blo     putc_done
BE50 8140                             cmpa    #$40
BE52 250A                             blo     1F
BE54 8160                             cmpa    #$60
BE56 2508                             blo     2F
BE58 8180                             cmpa    #$80
BE5A 2404                             bhs     2F
BE5C 8B60                             adda    #$60            ; $60-$7F: יחד עם ה-$40 שאחריו, פחות $60
BE5E 8B40             1               adda    #$40
BE60 A780             2               sta     ,x+
BE62 9F88             pc_adv          stx     CURSOR
BE64 8C0600                           cmpx    #SCREND
BE67 252A                             blo     putc_done
                                      ; גלילה: כל השורות עולות אחת, והאחרונה מתנקה
BE69 8E0400                           ldx     #SCREEN
BE6C EC8820           4               ldd     32,x
BE6F ED81                             std     ,x++
BE71 8C05E0                           cmpx    #SCREND-32
BE74 25F6                             blo     4B
BE76 8DB9                             bsr     clrto
BE78 2019                             bra     putc_done
BE7A D689             pc_cr           ldb     CURSOR+1        ; כמה תאים עד סוף השורה (1-32)
BE7C CAE0                             orb     #$e0            ; 32 פחות העמודה
BE7E 50                               negb
BE7F 8660                             lda     #$60
BE81 A780             3               sta     ,x+
