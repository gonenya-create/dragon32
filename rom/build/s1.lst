97B0 3262                             leas    2,s
97B2 39                               rts
                      ; reason: D = כתובת חדשה לסוף האזור. חייבים להישאר 58 בתים מתחת למחסנית (קורא: הרזרבה), אחרת ?OM
                      ; (S אחרי pshs, פחות 4 של כתובות החזרה, מול D+58: כמו S מול D+62)
97B3 C3003E           reason          addd    #62
97B6 25D2                             bcs     ary_om
97B8 3406                             pshs    d
97BA 1F40                             tfr     s,d
97BC 10A3E1                           cmpd    ,s++
97BF 23C9                             bls     ary_om
97C1 39                               rts
                      
                      ; DIM שם(גדלים)[,שם(גדלים)...] (mit: DIM)
97C2 9D9F             1               jsr     <chrget
97C4 C602             dim             ldb     #2
97C6 17F934                           lbsr    ptrget
