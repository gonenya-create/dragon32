9822 2706                             beq     9F
9824 8122                             cmpa    #'"
9826 26F8                             bne     2B
9828 20E6                             bra     tkget
982A 39               9               rts
                      
                      ; ---------- ON n GO TO / GO SUB (mit: ONGOTO) ----------
982B 17FBBB           on              lbsr    evbyte          ; B = 0-255
982E 8681                             lda     #$81            ; GO (synchk לא נוגע ב-B)
9830 17F521                           lbsr    synchk
9833 80BC                             suba    #$bc            ; TO = 0, SUB = 1
9835 8101                             cmpa    #1
9837 1022E998                         lbhi    err_sn
983B 3406                             pshs    d               ; [0] = TO/SUB, [1] = n
983D 6A61             2               dec     1,s
983F 260B                             bne     3F
9841 9D9F                             jsr     <chrget         ; זה המספר שנבחר
9843 6DE1                             tst     ,s++            ; TO?
9845 1027F664                         lbeq    goto1
9849 16F64C                           lbra    gosub1
984C 9D9F             3               jsr     <chrget         ; מדלגים על מספר
984E 17F67A                           lbsr    lineget
9851 9DA5                             jsr     <chrgot
9853 812C                             cmpa    #',
9855 27E6                             beq     2B
9857 3586                             puls    d,pc            ; אין כזה ברשימה (או 0): ממשיכים אחרי הפקודה
                      
                      ; ---------- RETURN (mit: RETURN) ----------
                      ; מחפשים את רשומת ה-GOSUB העליונה; רשומות FOR שמעליה נמחקות. אין: ?RG
9859 3062             return          leax    2,s             ; מעל: החזרה ל-gone
985B A684             1               lda     ,x
985D 8180                             cmpa    #$80
985F 2605                             bne     2F
9861 308812                           leax    18,x
9864 20F5                             bra     1B
9866 81BD             2               cmpa    #$bd
9868 1026E96A                         lbne    err_rg
986C EC01                             ldd     1,x
986E DD68                             std     CURLIN
9870 EC03                             ldd     3,x
9872 DDA6                             std     TXTPTR
9874 3205                             leas    5,x             ; הרשומה; כתובת החזרה שמתחתיה (קורא) היא תמיד זו של gone, ודרכה ל-newstt
                                                      ; ממשיכים ב-data: עד סוף הפקודה שקראה (GOSUB או ON)
                      
                      ; ---------- DATA, RESTORE ----------
                      ; data: עד סוף הפקודה, בלי לעצור על נקודתיים בתוך מרכאות (mit: DATA/DATAN)
9876 17F7FD           data            lbsr    stmend
9879 9FA6                             stx     TXTPTR
