                      ; puts: מחרוזת ב-X שמסתיימת ב-0
BE68 A680             puts            lda     ,x+             ; להתקן שב-DEVNUM
BE6A 2705                             beq     1F
BE6C 17FCD2                           lbsr    chrout
BE6F 20F7                             bra     puts
BE71 39               1               rts
                      
                      
                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BE72 3031323334353637 KEYMAP          fcc     "01234567"
BE7A 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BE82 4041424344454647                 fcc     "@ABCDEFG"
BE8A 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BE92 5051525354555657                 fcc     "PQRSTUVW"
BE9A 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BEA2 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BEAA 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
BEB2 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
BEBA 3414             keyindex        pshs    b,x
BEBC 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
BEBF 8E03EA                           ldx     #KPREV
BEC2 CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BEC5 B7FF02           ki_col          sta     PIA0+2
BEC8 3402                             pshs    a               ; המסכה
