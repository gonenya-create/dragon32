984B 20E8                             bra     1B
984D 301F             8               leax    -1,x            ; סוף השורה: על ה-0; if_do מוצא שם פקודה ריקה (gone3), וממשיכים לשורה הבאה
984F 9FA6             4               stx     TXTPTR          ; TXTPTR = אחרי ה-ELSE; chrgot ב-if_do ממשיך כמו אחרי THEN
9851 20D5                             bra     if_do
                      ; tkget: הבית הבא ב-X (X מתקדם), בלי מה שבתוך מרכאות ובלי הבית שאחרי $FF (פונקציה). A=0, Z=1: סוף השורה
                      ; (גם RENUM)
