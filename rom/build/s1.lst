8856 0F63                             clr     FACOV
8858 39                               rts
                      ; movfa: ARG → FAC
8859 DC5C             movfa           ldd     ARGEXP
885B DD4F                             std     FACEXP
885D DC5E                             ldd     ARGMOH
885F DD51                             std     FACMOH
