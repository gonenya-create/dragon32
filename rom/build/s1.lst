                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BE9C 3031323334353637 KEYMAP          fcc     "01234567"
BEA4 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BEAC 4041424344454647                 fcc     "@ABCDEFG"
BEB4 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BEBC 5051525354555657                 fcc     "PQRSTUVW"
BEC4 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BECC 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BED4 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
BEDC 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
BEE4 3414             keyindex        pshs    b,x
BEE6 7FFF02                           clr     PIA0+2          ; כל העמודות למטה, קריאה אחת. בלי שינוי מהפעם הקודמת: יוצאים מהר (קורא 2.10)
BEE9 B6FF00                           lda     PIA0
BEEC 43                               coma
BEED 847F                             anda    #$7f
BEEF B10151                           cmpa    KALL
BEF2 2777                             beq     ki_none
BEF4 B70151                           sta     KALL
BEF7 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
BEFA 8E0152                           ldx     #KPREV
BEFD CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BF00 B7FF02           ki_col          sta     PIA0+2
BF03 3402                             pshs    a               ; המסכה
BF05 A685                             lda     b,x             ; הקודם
BF07 3402                             pshs    a
BF09 B6FF00                           lda     PIA0
BF0C 43                               coma
BF0D 847F                             anda    #$7f            ; השורות הלחוצות עכשיו
BF0F A785                             sta     b,x             ; לסריקה הבאה
BF11 A8E0                             eora    ,s+
BF13 A485                             anda    b,x             ; חדש = עכשיו וגם לא קודם
BF15 C103                             cmpb    #3
BF17 2502                             blo     3F
BF19 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF1B B703F3           3               sta     KNEW
BF1E 7D03F2                           tst     KFOUND
BF21 261A                             bne     ki_next
BF23 4D                               tsta
BF24 2717                             beq     ki_next
BF26 F703F5                           stb     KCOL
BF29 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
BF2C 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF2D 44               4               lsra
BF2E 2507                             bcs     5F
BF30 7C03F4                           inc     KROW
BF33 CB08                             addb    #8
BF35 20F6                             bra     4B
BF37 F703F2           5               stb     KFOUND
BF3A F603F5                           ldb     KCOL
BF3D 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF3F 48                               lsla
BF40 4C                               inca
BF41 5C                               incb
BF42 C108                             cmpb    #8
BF44 25BA                             blo     ki_col
BF46 F603F2                           ldb     KFOUND
BF49 2720                             beq     ki_none
BF4B 5A                               decb
BF4C A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C
BF4E 48                               lsla
BF4F 48                               lsla
BF50 8EBE9C                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF53 A685                             lda     b,x             ; התו
BF55 2714                             beq     ki_none
BF57 2413                             bcc     ki_out
BF59 C110                             cmpb    #16
BF5B 2507                             blo     1F
BF5D 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF5F 260B                             bne     ki_out
BF61 4C                               inca
BF62 2008                             bra     ki_out
BF64 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF67 A685                             lda     b,x
BF69 2001                             bra     ki_out
BF6B 4F               ki_none         clra
BF6C 4D               ki_out          tsta                    ; Z לפי התו
BF6D 3594                             puls    b,x,pc
                      
                      ; getkey: מחכה למקש, ומחזיר את התו ב-A. כמו במקור: הבהוב (עם השהיה), ואז סריקה דרך $BBE5, ושוב.
                      ; מקש: $60 בתא הסמן, ורק אז הוא חוזר (קורא 2.5, 8.1)
BF6F 3414             getkey          pshs    b,x
BF71 8D0D             gk_loop         bsr     blink
BF73 BDBBE5                           jsr     $bbe5           ; סריקת המקלדת, דרך הכניסה הקבועה (כמו במקור)
BF76 27F9             gk_r            beq     gk_loop
BF78 9E88             gk_got          ldx     CURSOR
BF7A C660                             ldb     #$60
BF7C E784                             stb     ,x
BF7E 3594                             puls    b,x,pc
                      ; blink (קורא): CBLCNT יורד; ב-0: ביט $40 בתא הסמן מתהפך, והמונה חוזר ל-50. אחר כך השהיה: 1118 סיבובים של 8 מחזורים
                      ; @nofill: לולאות מתוזמנות, לפי מחזורים. tools/islands.py לא מכניס כאן גושים
BF80 3412             blink           pshs    a,x
BF82 0A8F                             dec     CBLCNT
BF84 260C                             bne     1F
BF86 9E88                             ldx     CURSOR
BF88 A684                             lda     ,x
BF8A 8840                             eora    #$40
BF8C A784                             sta     ,x
BF8E 8632                             lda     #50
BF90 978F                             sta     CBLCNT
BF92 8E045E           1               ldx     #$045e
BF95 301F             2               leax    -1,x
BF97 26FC                             bne     2B
BF99 3592                             puls    a,x,pc
