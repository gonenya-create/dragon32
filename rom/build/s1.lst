BE84 26FB                             bne     3B
BE86 20DA                             bra     pc_adv
BE88 8C0400           pc_bs           cmpx    #SCREEN
BE8B 2706                             beq     putc_done
BE8D 8660                             lda     #$60
BE8F A782                             sta     ,-x
BE91 9F88                             stx     CURSOR
BE93 3596             putc_done       puls    a,b,x,pc
                      
                      ; puts: מחרוזת ב-X שמסתיימת ב-0
BE95 A680             puts            lda     ,x+             ; להתקן שב-DEVNUM
BE97 2705                             beq     1F
BE99 17FCA7                           lbsr    chrout
BE9C 20F7                             bra     puts
BE9E 39               1               rts
                      
                      
                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BE9F 3031323334353637 KEYMAP          fcc     "01234567"
BEA7 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BEAF 4041424344454647                 fcc     "@ABCDEFG"
BEB7 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BEBF 5051525354555657                 fcc     "PQRSTUVW"
BEC7 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BECF 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BED7 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
BEDF 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
                      ; הטבלה ($0151-$0159) שומרת את מה שנקרא מ-PIA0 כמו במקור: מקש לחוץ = 0, וביט 7 דולק (29.10). תוכנות קוראות אותה ישר:
                      ; SAS (Peaksoft) בודק PEEK(341)=223 לחץ למעלה, והטוען של Cricket כותב לשם $FF ו-$BF
BEE7 3414             keyindex        pshs    b,x
BEE9 8E0152                           ldx     #KPREV          ; KALL ($0151) צמוד לפניו: גישה דרך X חוסכת שני בתים (28.10)
BEEC 4F                               clra                    ; כל העמודות למטה, קריאה אחת. בלי שינוי מהפעם הקודמת: יוצאים מהר (קורא 2.10)
BEED B7FF02                           sta     PIA0+2          ; כתיבה בלי קריאה: CLR קורא קודם את $FF02, והקריאה מוחקת את דגל פסיקת השדה (Phantom Slayer קפא). אותם 7 מחזורים
BEF0 B6FF00                           lda     PIA0
BEF3 8A80                             ora     #$80            ; כמו במקור: מה שנקרא, וביט 7 דולק
BEF5 A11F                             cmpa    -1,x            ; KALL
BEF7 2771                             beq     ki_none
BEF9 A71F                             sta     -1,x
BEFB 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
BEFE CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BF01 B7FF02           ki_col          sta     PIA0+2
BF04 3402                             pshs    a               ; המסכה
BF06 A685                             lda     b,x             ; הקודם
BF08 3402                             pshs    a
BF0A B6FF00                           lda     PIA0
BF0D 8A80                             ora     #$80
BF0F A785                             sta     b,x             ; לסריקה הבאה, כמו במקור (לחוץ = 0)
BF11 43                               coma                    ; השורות הלחוצות עכשיו = 1 (ביט 7 = 0)
BF12 A4E0                             anda    ,s+             ; חדש = עכשיו וגם לא קודם (בקודם, לא לחוץ = 1)
BF14 C103                             cmpb    #3
BF16 2502                             blo     3F
BF18 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF1A B703F3           3               sta     KNEW
BF1D 7D03F2                           tst     KFOUND
BF20 261A                             bne     ki_next
BF22 4D                               tsta
BF23 2717                             beq     ki_next
BF25 F703F5                           stb     KCOL
BF28 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
BF2B 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF2C 44               4               lsra
BF2D 2507                             bcs     5F
BF2F 7C03F4                           inc     KROW
BF32 CB08                             addb    #8
BF34 20F6                             bra     4B
BF36 F703F2           5               stb     KFOUND
BF39 F603F5                           ldb     KCOL
BF3C 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF3E 48                               lsla
BF3F 4C                               inca
BF40 5C                               incb
BF41 C108                             cmpb    #8
BF43 25BC                             blo     ki_col
BF45 F603F2                           ldb     KFOUND
BF48 2720                             beq     ki_none
BF4A 5A                               decb
BF4B A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C = 0 כשהוא לחוץ (לחוץ = 0 בטבלה)
BF4D 48                               lsla
BF4E 48                               lsla
BF4F 8EBE9F                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF52 A685                             lda     b,x             ; התו
BF54 2714                             beq     ki_none
BF56 2513                             bcs     ki_out          ; בלי SHIFT
BF58 C110                             cmpb    #16
BF5A 2507                             blo     1F
BF5C 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF5E 260B                             bne     ki_out
BF60 4C                               inca
BF61 2008                             bra     ki_out
BF63 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF66 A685                             lda     b,x
BF68 2001                             bra     ki_out
BF6A 4F               ki_none         clra
BF6B 4D               ki_out          tsta                    ; Z לפי התו
BF6C 3594                             puls    b,x,pc
                      
                      ; getkey: מחכה למקש, ומחזיר את התו ב-A. כמו במקור: הבהוב (עם השהיה), ואז סריקה דרך $BBE5, ושוב.
                      ; מקש: $60 בתא הסמן, ורק אז הוא חוזר (קורא 2.5, 8.1)
BF6E 3414             getkey          pshs    b,x
BF70 8D0D             gk_loop         bsr     blink
BF72 BDBBE5                           jsr     $bbe5           ; סריקת המקלדת, דרך הכניסה הקבועה (כמו במקור)
BF75 27F9             gk_r            beq     gk_loop
BF77 9E88             gk_got          ldx     CURSOR
BF79 C660                             ldb     #$60
BF7B E784                             stb     ,x
BF7D 3594                             puls    b,x,pc
                      ; blink (קורא): CBLCNT יורד; ב-0: ביט $40 בתא הסמן מתהפך, והמונה חוזר ל-50. אחר כך השהיה: 1118 סיבובים של 8 מחזורים
                      ; @nofill: לולאות מתוזמנות, לפי מחזורים. tools/islands.py לא מכניס כאן גושים
BF7F 3412             blink           pshs    a,x
BF81 0A8F                             dec     CBLCNT
BF83 260C                             bne     1F
BF85 9E88                             ldx     CURSOR
BF87 A684                             lda     ,x
BF89 8840                             eora    #$40
BF8B A784                             sta     ,x
BF8D 8632                             lda     #50
BF8F 978F                             sta     CBLCNT
BF91 8E045E           1               ldx     #$045e
BF94 301F             2               leax    -1,x
BF96 26FC                             bne     2B
BF98 3592                             puls    a,x,pc
                      ; @endnofill
                      
                      ; פסיקת השדה (קורא: צליל 4, 9.5): רק כשהדגל ב-$FF03 דולק. TIMER, ואחריו התו של PLAY, ורק אם אין תו: SOUND
BF9A B6FF03           irq             lda     PIA0+3
