                      ; Dragon 1982 BASIC — שלב 3, חלק 4: צליל (SOUND, AUDIO, PLAY).
                      ; הכול לפי הקורא: docs/DRAGON-SPEC-SOUND.md (עובדות בלבד, בלי קוד). נכתב מאפס.
                      
008C                  SNDFRQ          equ     $8c             ; SOUND: הטון האחרון (קורא 0.1)
008D                  SNDTMR          equ     $8d             ; 2 בתים: כמה שדות נשארו (השעון מוריד)
00D5                  PSTEP           equ     $d5             ; PLAY: 2 בתים, כמה להוריד בכל שדה (אורך × קצב)
00DE                  OCTAVE          equ     $de             ; PLAY: האוקטבה פחות 1 (0-4)
00DF                  VOLHI           equ     $df             ; PLAY: הערך הגבוה ל-DAC
00E0                  VOLLO           equ     $e0             ; PLAY: הערך הנמוך
00E1                  NOTELN          equ     $e1             ; PLAY: L
00E2                  TEMPO           equ     $e2             ; PLAY: T
00E3                  PLYTMR          equ     $e3             ; PLAY: 2 בתים, הספירה של התו (0 = אין תו)
00E5                  DOTVAL          equ     $e5             ; PLAY: מספר הנקודות אחרי L
                      
