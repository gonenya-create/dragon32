B69A                                  include "mittape.s"
                      ; Dragon 1982 BASIC — שלב 3, חלק 5: קלטת. צעד 1: הבסיס (מנוע, כתיבה וקריאה של ביט, בית ובלוק).
                      ; הכול לפי הקורא: docs/DRAGON-SPEC-TAPE.md (עובדות בלבד, בלי קוד). נכתב מאפס.
                      ; התזמון חשוב כאן: כל קפיצה בקוד המתוזמן קצרה (bsr/bra) או jsr מפורש, כדי שהכלים לא ישנו אותה.
                      
007C                  BLKTYP          equ     $7c             ; סוג הבלוק
007D                  BLKLEN          equ     $7d             ; אורך הבלוק
007E                  BLKADR          equ     $7e             ; 2 בתים: כתובת הנתונים
0080                  CSUM            equ     $80             ; סכום הביקורת
0081                  BLKRES          equ     $81             ; ספירת הבתים בבלוק, ואחר כך התוצאה: 0 תקין, 1 ביקורת, 2 זיכרון
0082                  POLLS           equ     $82             ; מונה הדגימות
0083                  SYNCNT          equ     $83             ; מונה הביטים בבית, ומונה הסנכרון (עם סימן)
0084                  PHASE           equ     $84             ; 0 = מזמנים מעלייה לעלייה, אחרת מירידה לירידה
0085                  HELD            equ     $85             ; הערך שנשמר מהביט הקודם ל-DAC
0090                  LDRCNT          equ     $90             ; 2 בתים: אורך המבוא
0092                  BITLIM          equ     $92             ; סף הביט, בדגימות
0093                  HALFLIM         equ     $93             ; סף חצי גל קצר/ארוך (רק בסנכרון)
0094                  HALFMAX         equ     $94             ; חצי גל מקסימלי (רק בסנכרון)
0095                  MOTDLY          equ     $95             ; 2 בתים: השהיית המנוע (8 מחזורים לספירה)
                      
                      ; ---------- מנוע (קורא 1.1) ----------
                      ; (tmoton עבר ל-exp.s, לפני $A000, כדי לפנות מקום לכניסה $B5C9: 30.10)
                      ; motoff: המנוע כבוי, והפסיקות פתוחות. A משתנה
B69A B6FF21           motoff          lda     PIA1+1
B69D 84F7                             anda    #$f7
B69F B7FF21                           sta     PIA1+1
B6A2 1CAF                             andcc   #$af
B6A4 39                               rts
                      
