                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BE91 3031323334353637 KEYMAP          fcc     "01234567"
BE99 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BEA1 4041424344454647                 fcc     "@ABCDEFG"
BEA9 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BEB1 5051525354555657                 fcc     "PQRSTUVW"
BEB9 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BEC1 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BEC9 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
BED1 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
BED9 3414             keyindex        pshs    b,x
BEDB 7FFF02                           clr     PIA0+2          ; כל העמודות למטה, קריאה אחת. בלי שינוי מהפעם הקודמת: יוצאים מהר (קורא 2.10)
BEDE B6FF00                           lda     PIA0
BEE1 43                               coma
BEE2 847F                             anda    #$7f
BEE4 B10151                           cmpa    KALL
BEE7 2777                             beq     ki_none
BEE9 B70151                           sta     KALL
BEEC 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
BEEF 8E0152                           ldx     #KPREV
BEF2 CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BEF5 B7FF02           ki_col          sta     PIA0+2
BEF8 3402                             pshs    a               ; המסכה
