                      ; mulcur: CURTOL = CURTOL * D, וגם D = התוצאה (16 ביט, גלישה: ?OM). X, Y, U לא משתנים
                      ; אחד הבתים הגבוהים חייב להיות 0, ואז יש רק מכפלה "צולבת" אחת
978D 3406             mulcur          pshs    d               ; [0] = גבוה, [1] = נמוך
978F 96F4                             lda     CURTOL
9791 2708                             beq     1F
