                      ; ---------- שגיאות (mit: ERROR; קורא: מדפסת, טבלת השגיאות) ----------
                      ; כל שגיאה: B = הקוד (ההיסט בטבלה, 2 לכל שגיאה), ונופלים דרך ה-cmpx עד error
81D0 C600             err_nf          ldb     #0
