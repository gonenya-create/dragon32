B6A5 7EBA27                           jmp     csavp   ;@isl
                      ; motoff: המנוע כבוי, והפסיקות פתוחות. A משתנה
B6A8 B6FF21           motoff          lda     PIA1+1
B6AB 84F7                             anda    #$f7
B6AD B7FF21                           sta     PIA1+1
B6B0 1CAF                             andcc   #$af
B6B2 39                               rts
                      
