                      ; Dragon 1982 BASIC — שלב 3, חלק 2: PRINT USING. לפי הקורא: docs/DRAGON-SPEC-USING.md. נכתב מאפס.
                      ; המשתנים באזור העבודה המשותף $CF-$DD, כמו במקור (USSCNT $D3, USDPTR $D5, USFLG $D7...). לא ב-$DE-$E9: שם ההגדרות של PLAY ו-DRAW
                      
00D5                  USDSC           equ     $d5             ; 2 בתים: מתאר התבנית (קוראים ממנו כל פעם: איסוף מחרוזות יכול להזיז אותה)
00D3                  USPOS           equ     $d3             ; המקום בתבנית
00DA                  USANY           equ     $da             ; במחזור הזה נצרך ערך?
00DB                  USEND           equ     $db             ; 0: יש עוד ערכים. 1: הרשימה נגמרה בלי מפריד. 2: עם ; או ,
00D9                  USL             equ     $d9             ; השדה המספרי: המקומות לפני הנקודה (כולל + מוביל, ** $$ **$ ופסיקים)
00D8                  USD             equ     $d8             ; ספרות אחרי הנקודה ($FF: אין נקודה)
00D7                  USFLG           equ     $d7             ; 1 פסיקים, 2 כוכביות, 4 דולר, 8 + מוביל, $10 + נגרר, $20 - נגרר, $40 מעריך
00DC                  USW             equ     $dc             ; רוחב שדה מחרוזת (! = 1)
00CF                  USEPT           equ     $cf             ; 2 בתים, רק בזמן הסריקה: סוף התבנית (חופף ל-USSG/USP, שמשמשים אחר כך)
                      
