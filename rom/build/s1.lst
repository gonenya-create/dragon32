BF83 8632                             lda     #50
BF85 978F                             sta     CBLCNT
BF87 8E045E           1               ldx     #$045e
BF8A 301F             2               leax    -1,x
BF8C 26FC                             bne     2B
BF8E 3592                             puls    a,x,pc
                      ; @endnofill
                      
