BEFC 3402                             pshs    a
BEFE B6FF00                           lda     PIA0
BF01 43                               coma
BF02 847F                             anda    #$7f            ; השורות הלחוצות עכשיו
BF04 A785                             sta     b,x             ; לסריקה הבאה
BF06 A8E0                             eora    ,s+
BF08 A485                             anda    b,x             ; חדש = עכשיו וגם לא קודם
BF0A C103                             cmpb    #3
BF0C 2502                             blo     3F
BF0E 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF10 B703F3           3               sta     KNEW
BF13 7D03F2                           tst     KFOUND
BF16 261A                             bne     ki_next
BF18 4D                               tsta
BF19 2717                             beq     ki_next
BF1B F703F5                           stb     KCOL
BF1E 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
BF21 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF22 44               4               lsra
BF23 2507                             bcs     5F
BF25 7C03F4                           inc     KROW
BF28 CB08                             addb    #8
BF2A 20F6                             bra     4B
BF2C F703F2           5               stb     KFOUND
BF2F F603F5                           ldb     KCOL
BF32 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF34 48                               lsla
BF35 4C                               inca
BF36 5C                               incb
BF37 C108                             cmpb    #8
BF39 25BA                             blo     ki_col
BF3B F603F2                           ldb     KFOUND
BF3E 2720                             beq     ki_none
BF40 5A                               decb
BF41 A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C
BF43 48                               lsla
BF44 48                               lsla
BF45 8EBE91                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF48 A685                             lda     b,x             ; התו
BF4A 2714                             beq     ki_none
BF4C 2413                             bcc     ki_out
BF4E C110                             cmpb    #16
BF50 2507                             blo     1F
BF52 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF54 260B                             bne     ki_out
BF56 4C                               inca
BF57 2008                             bra     ki_out
BF59 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF5C A685                             lda     b,x
BF5E 2001                             bra     ki_out
BF60 4F               ki_none         clra
BF61 4D               ki_out          tsta                    ; Z לפי התו
BF62 3594                             puls    b,x,pc
                      
                      ; getkey: מחכה למקש, ומחזיר את התו ב-A. כמו במקור: הבהוב (עם השהיה), ואז סריקה דרך $BBE5, ושוב.
                      ; מקש: $60 בתא הסמן, ורק אז הוא חוזר (קורא 2.5, 8.1)
BF64 3414             getkey          pshs    b,x
