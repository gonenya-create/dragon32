                      ; getfnm: FN ושם → DEFPNT (נוצר אם אין)
98B3 86BE             getfnm          lda     #$be
98B5 17F49C                           lbsr    synchk
98B8 86C0                             lda     #$c0
98BA 8D07                             bsr     ptrsub
98BC DC39                             ldd     VARPNT
