973F 26EC                             bne     4B
                                      ; סוף הרשומה = Y + CURTOL. חייב להשאיר מקום למחסנית (mit: REASON)
9741 1F20                             tfr     y,d
9743 D3F4                             addd    CURTOL
9745 2543                             bcs     ary_om
9747 3406                             pshs    d
