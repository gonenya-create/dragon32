9728 2705                             beq     1F
972A 86BF                             lda     #$bf            ; THEN
972C 17F5A2                           lbsr    synchk
972F 0D4F             1               tst     FACEXP          ; 0 = שקר, כל השאר אמת
9731 2709                             beq     if_no
9733 9DA5             if_do           jsr     <chrgot
9735 1025F6D8                         lbcs    goto1           ; מספר: GOTO
