8F2D 170FE6                           lbsr    runstk          ; ומחסנית חדשה, עם סמן תחתית ל-FOR (mit: STKINI)
8F30 9DA5                             jsr     <chrgot
8F32 2704                             beq     1F
8F34 2410                             bcc     gosn            ; RUN "שם": עם הקלטת, בהמשך (Z=0 כאן, אז ה-lbne שם קופץ)
