                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BE9A 3031323334353637 KEYMAP          fcc     "01234567"
BEA2 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BEAA 4041424344454647                 fcc     "@ABCDEFG"
BEB2 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BEBA 5051525354555657                 fcc     "PQRSTUVW"
BEC2 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BECA 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BED2 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
BEDA 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
BEE2 3414             keyindex        pshs    b,x
BEE4 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
BEE7 8E03EA                           ldx     #KPREV
BEEA CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BEED B7FF02           ki_col          sta     PIA0+2
BEF0 3402                             pshs    a               ; המסכה
BEF2 A685                             lda     b,x             ; הקודם
BEF4 3402                             pshs    a
BEF6 B6FF00                           lda     PIA0
BEF9 43                               coma
BEFA 847F                             anda    #$7f            ; השורות הלחוצות עכשיו
BEFC A785                             sta     b,x             ; לסריקה הבאה
BEFE A8E0                             eora    ,s+
BF00 A485                             anda    b,x             ; חדש = עכשיו וגם לא קודם
BF02 C103                             cmpb    #3
BF04 2502                             blo     3F
BF06 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF08 B703F3           3               sta     KNEW
BF0B 7D03F2                           tst     KFOUND
BF0E 261A                             bne     ki_next
BF10 4D                               tsta
BF11 2717                             beq     ki_next
BF13 F703F5                           stb     KCOL
BF16 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
BF19 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF1A 44               4               lsra
BF1B 2507                             bcs     5F
BF1D 7C03F4                           inc     KROW
BF20 CB08                             addb    #8
BF22 20F6                             bra     4B
BF24 F703F2           5               stb     KFOUND
BF27 F603F5                           ldb     KCOL
BF2A 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF2C 48                               lsla
BF2D 4C                               inca
BF2E 5C                               incb
BF2F C108                             cmpb    #8
BF31 25BA                             blo     ki_col
BF33 F603F2                           ldb     KFOUND
BF36 2720                             beq     ki_none
BF38 5A                               decb
BF39 A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C
BF3B 48                               lsla
BF3C 48                               lsla
BF3D 8EBE9A                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF40 A685                             lda     b,x             ; התו
BF42 2714                             beq     ki_none
BF44 2413                             bcc     ki_out
BF46 C110                             cmpb    #16
BF48 2507                             blo     1F
BF4A 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF4C 260B                             bne     ki_out
BF4E 4C                               inca
BF4F 2008                             bra     ki_out
BF51 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF54 A685                             lda     b,x
BF56 2001                             bra     ki_out
BF58 4F               ki_none         clra
BF59 4D               ki_out          tsta                    ; Z לפי התו
BF5A 3594                             puls    b,x,pc
                      
                      ; inkey: מקש בלי לחכות (INKEY$): מהתור, או מקש שנלחץ עכשיו. אין: A=0
BF5C DCFA             inkey           ldd     KQCNT
BF5E 260C                             bne     gk_pop
BF60 2080                             bra     keyindex
                      
                      ; getkey: מחכה למקש, מחזיר את התו ב-A. קודם תור הבדיקות (KEYQ), אחר כך המקלדת
BF62 3414             getkey          pshs    b,x
