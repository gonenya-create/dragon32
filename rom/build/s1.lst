                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BEA0 3031323334353637 KEYMAP          fcc     "01234567"
BEA8 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BEB0 4041424344454647                 fcc     "@ABCDEFG"
BEB8 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BEC0 5051525354555657                 fcc     "PQRSTUVW"
BEC8 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BED0 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BED8 00               SHIFTED         fcb     0                       ; SHIFT+0: אין תו, הנעילה מתהפכת (למטה)
BED9 21222324252627                   fcc     "!\"#$%&'"              ; SHIFT על 1-7
BEE0 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
                      ; הטבלה ($0151-$0159) שומרת את מה שנקרא מ-PIA0 כמו במקור: מקש לחוץ = 0, וביט 7 דולק (29.10). תוכנות קוראות אותה ישר:
                      ; SAS (Peaksoft) בודק PEEK(341)=223 לחץ למעלה, והטוען של Cricket כותב לשם $FF ו-$BF
BEE8 3414             keyindex        pshs    b,x
BEEA 8E0152                           ldx     #KPREV          ; KALL ($0151) צמוד לפניו: גישה דרך X חוסכת שני בתים (28.10)
                      ; כפתור ג'ויסטיק לחוץ: אין מקש, כמו במקור (DRAGON-SPEC-ENTRIES, $BBE5). בלי אף עמודה, שורה נמוכה היא כפתור, לא מקש.
                      ; Starman Jones (Blaby) עוצר את המשחק כש-$BBE5 מחזיר מקש, אז הירי עצר אותו מיד (8.11)
BEED 86FF                             lda     #$ff
BEEF B7FF02                           sta     PIA0+2
BEF2 B6FF00                           lda     PIA0
BEF5 8A80                             ora     #$80
BEF7 4C                               inca                    ; $FF (אין כפתור) → 0, וכך A כבר 0 לשורה הבאה
BEF8 2671                             bne     ki_none
                                                              ; כל העמודות למטה, קריאה אחת. בלי שינוי מהפעם הקודמת: יוצאים מהר (קורא 2.10)
BEFA B7FF02                           sta     PIA0+2          ; כתיבה בלי קריאה: CLR קורא קודם את $FF02, והקריאה מוחקת את דגל פסיקת השדה (Phantom Slayer קפא). אותם 7 מחזורים
BEFD B6FF00                           lda     PIA0
BF00 8A80                             ora     #$80            ; כמו במקור: מה שנקרא, וביט 7 דולק
BF02 A11F                             cmpa    -1,x            ; KALL
BF04 2765                             beq     ki_none
BF06 A71F                             sta     -1,x
BF08 6FE2                             clr     ,-s             ; KFOUND, במחסנית: 0 = אין; אחרת האינדקס בטבלה + 1
                      ; (1.11: המשתנים הזמניים עברו מ-$03F2-$03F5 למחסנית. הטוען של Donkey King (Microdeal) שומר שם נתונים,
                      ; והסריקה שלנו דרסה אותם: המקשים נקלטו רק לפעמים. סימן שהמקור לא משתמש בכתובות האלה)
BF0A CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BF0D B7FF02           ki_col          sta     PIA0+2
BF10 3402                             pshs    a               ; המסכה
BF12 A685                             lda     b,x             ; הקודם
BF14 3402                             pshs    a
BF16 B6FF00                           lda     PIA0
BF19 8A80                             ora     #$80
BF1B A785                             sta     b,x             ; לסריקה הבאה, כמו במקור (לחוץ = 0)
BF1D 43                               coma                    ; השורות הלחוצות עכשיו = 1 (ביט 7 = 0)
BF1E A4E0                             anda    ,s+             ; חדש = עכשיו וגם לא קודם (בקודם, לא לחוץ = 1)
BF20 C103                             cmpb    #3
BF22 2502                             blo     3F
BF24 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF26 6D61             3               tst     1,s             ; KFOUND (מעליו במחסנית: המסכה)
BF28 2611                             bne     ki_next
BF2A 4D                               tsta
BF2B 270E                             beq     ki_next
BF2D 3404                             pshs    b               ; העמודה
BF2F 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF30 44               4               lsra
BF31 2504                             bcs     5F
BF33 CB08                             addb    #8
BF35 20F9                             bra     4B
BF37 E762             5               stb     2,s             ; KFOUND
BF39 3504                             puls    b
BF3B 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF3D 48                               lsla
BF3E 4C                               inca
BF3F 5C                               incb
BF40 C108                             cmpb    #8
BF42 25C9                             blo     ki_col
BF44 E6E0                             ldb     ,s+             ; KFOUND
BF46 2723                             beq     ki_none
BF48 5A                               decb
BF49 A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C = 0 כשהוא לחוץ (לחוץ = 0 בטבלה)
BF4B 48                               lsla
BF4C 48                               lsla
BF4D 8EBEA0                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF50 A685                             lda     b,x             ; התו
BF52 2717                             beq     ki_none
BF54 2519                             bcs     ki_low          ; בלי SHIFT
BF56 C110                             cmpb    #16
BF58 2507                             blo     1F
BF5A 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF5C 260E                             bne     ki_out
BF5E 4C                               inca
BF5F 200B                             bra     ki_out
BF61 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF64 A685                             lda     b,x
