                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
BDBA                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
BDBA 8EFF00                           ldx     #PIA0
BDBD C634                             ldb     #$34            ; CR: גישה לנתונים; CA2/CB2 פלט נמוך — בוררי הצליל, הצליל והמנוע כבויים (קורא: צליל 0.3)
BDBF 4F                               clra
BDC0 8D17                             bsr     piaddr          ; DDRA: הכול קלט
BDC2 86FF                             lda     #$ff
BDC4 8D11                             bsr     piaddr2         ; DDRB: הכול פלט
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
BDC6 30881E                           leax    PIA1-PIA0-2,x
BDC9 86FE                             lda     #$fe
BDCB 8D0C                             bsr     piaddr
BDCD 6F84                             clr     ,x              ; $FF20 = 0
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
BDCF 86F8                             lda     #$f8
BDD1 8D04                             bsr     piaddr2
BDD3 8D0B                             bsr     txtmode         ; מצב טקסט, ערכת צבעים 0; SAM: מצב 0, המסך ב-$0400
BDD5 6EA4                             jmp     ,y              ; חוזרים דרך Y (קורא: ממשקים, הכניסה ב-$8000)
                      ; piaddr: CR (1,x) לגישה ל-DDR, DDR (,x) = A, ו-CR = B. piaddr2: אותו דבר לצד B (X עולה ב-2)
BDD7 3002             piaddr2         leax    2,x
BDD9 6F01             piaddr          clr     1,x
BDDB A784                             sta     ,x
BDDD E701                             stb     1,x
BDDF 39                               rts
                      ; txtmode: מצב טקסט (קורא: SAMALP). ב-$FF22 נשארים 3 הביטים התחתונים; SAM: מצב 0, המסך ב-$0400
BDE0 3412             txtmode         pshs    a,x
BDE2 B6FF22                           lda     PIA1+2
