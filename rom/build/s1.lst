9856 9DA5                             jsr     <chrgot
9858 812C                             cmpa    #',
985A 27E6                             beq     2B
985C 3586                             puls    d,pc            ; אין כזה ברשימה (או 0): ממשיכים אחרי הפקודה
                      
                      ; ---------- RETURN (mit: RETURN) ----------
