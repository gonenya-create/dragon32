                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
BEDB 3414             keyindex        pshs    b,x
BEDD 7F03F2                           clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
BEE0 8E03EA                           ldx     #KPREV
BEE3 CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BEE6 B7FF02           ki_col          sta     PIA0+2
BEE9 3402                             pshs    a               ; המסכה
BEEB A685                             lda     b,x             ; הקודם
BEED 3402                             pshs    a
BEEF B6FF00                           lda     PIA0
BEF2 43                               coma
BEF3 847F                             anda    #$7f            ; השורות הלחוצות עכשיו
BEF5 A785                             sta     b,x             ; לסריקה הבאה
BEF7 A8E0                             eora    ,s+
BEF9 A485                             anda    b,x             ; חדש = עכשיו וגם לא קודם
BEFB C103                             cmpb    #3
BEFD 2502                             blo     3F
BEFF 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF01 B703F3           3               sta     KNEW
BF04 7D03F2                           tst     KFOUND
BF07 261A                             bne     ki_next
BF09 4D                               tsta
BF0A 2717                             beq     ki_next
BF0C F703F5                           stb     KCOL
BF0F 7F03F4                           clr     KROW            ; השורה הנמוכה שנלחצה
BF12 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF13 44               4               lsra
BF14 2507                             bcs     5F
BF16 7C03F4                           inc     KROW
BF19 CB08                             addb    #8
BF1B 20F6                             bra     4B
BF1D F703F2           5               stb     KFOUND
BF20 F603F5                           ldb     KCOL
BF23 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF25 48                               lsla
BF26 4C                               inca
BF27 5C                               incb
BF28 C108                             cmpb    #8
BF2A 25BA                             blo     ki_col
BF2C F603F2                           ldb     KFOUND
BF2F 2720                             beq     ki_none
BF31 5A                               decb
BF32 A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C
BF34 48                               lsla
BF35 48                               lsla
BF36 8EBE93                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF39 A685                             lda     b,x             ; התו
BF3B 2714                             beq     ki_none
BF3D 2413                             bcc     ki_out
BF3F C110                             cmpb    #16
BF41 2507                             blo     1F
BF43 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF45 260B                             bne     ki_out
BF47 4C                               inca
BF48 2008                             bra     ki_out
BF4A 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF4D A685                             lda     b,x
BF4F 2001                             bra     ki_out
BF51 4F               ki_none         clra
BF52 4D               ki_out          tsta                    ; Z לפי התו
BF53 3594                             puls    b,x,pc
                      
                      ; inkey: מקש בלי לחכות (INKEY$): מהתור, או מקש שנלחץ עכשיו. אין: A=0
BF55 DCFA             inkey           ldd     KQCNT
BF57 260C                             bne     gk_pop
BF59 2080                             bra     keyindex
                      
                      ; getkey: מחכה למקש, מחזיר את התו ב-A. קודם תור הבדיקות (KEYQ), אחר כך המקלדת
BF5B 3414             getkey          pshs    b,x
BF5D DCFA             gk_loop         ldd     KQCNT
BF5F 2714                             beq     gk_scan
BF61 8D02                             bsr     gk_pop
BF63 2017                             bra     gk_got
                      ; gk_pop: התו הבא בתור
BF65 3414             gk_pop          pshs    b,x
BF67 9EFA                             ldx     KQCNT
BF69 301F                             leax    -1,x
BF6B 9FFA                             stx     KQCNT
BF6D 9EF8                             ldx     KQPTR
BF6F A680                             lda     ,x+
BF71 9FF8                             stx     KQPTR
BF73 3594                             puls    b,x,pc
                      ; לולאת ההמתנה (קורא): הבהוב (עם השהיה), סריקה, ושוב. מקש: $60 בתא הסמן, ורק אז הוא חוזר
BF75 8D0D             gk_scan         bsr     blink
BF77 17FF61                           lbsr    keyindex        ; Z לפי A
BF7A 27E1                             beq     gk_loop
BF7C 9E88             gk_got          ldx     CURSOR
BF7E C660                             ldb     #$60
BF80 E784                             stb     ,x
BF82 3594                             puls    b,x,pc
                      ; blink (קורא): CBLCNT יורד; ב-0: ביט $40 בתא הסמן מתהפך, והמונה חוזר ל-50. אחר כך השהיה: 1118 סיבובים של 8 מחזורים
                      ; @nofill: לולאות מתוזמנות, לפי מחזורים. tools/islands.py לא מכניס כאן גושים
BF84 3412             blink           pshs    a,x
BF86 0A8F                             dec     CBLCNT
BF88 260C                             bne     1F
BF8A 9E88                             ldx     CURSOR
BF8C A684                             lda     ,x
BF8E 8840                             eora    #$40
BF90 A784                             sta     ,x
BF92 8632                             lda     #50
BF94 978F                             sta     CBLCNT
BF96 8E045E           1               ldx     #$045e
BF99 301F             2               leax    -1,x
BF9B 26FC                             bne     2B
BF9D 3592                             puls    a,x,pc
                      ; @endnofill
BF9F                                  include "testq.s"
BF9F 00000000         testq           fdb     0,0             ; תור הבדיקות: ריק (הכלים כותבים כאן אורך וכתובת $C000)
                      
                      ; פסיקת השדה (קורא: צליל 4, 9.5): רק כשהדגל ב-$FF03 דולק. TIMER, ואחריו התו של PLAY, ורק אם אין תו: SOUND
BFA3 B6FF03           irq             lda     PIA0+3
