8D4C 8629             chkrp           lda     #')
8D4E 8C                               fcb     $8c             ; cmpx #: מדלג על ה-lda הבא (בית אחד במקום bra)
8D4F 862C             chkcom          lda     #',
8D51 8C                               fcb     $8c
