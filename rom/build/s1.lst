9760 2025                             bra     ary_x           ; DIM: מוציאים את האינדקסים ואת הבלוק, וזהו
                      ; getdef: X = הרשומה. ההיסט לפי האינדקסים שבמחסנית: האחרון ראשון (mit: GETDEF/INLPNM)
9762 0FF4             getdef          clr     CURTOL
9764 0FF5                             clr     CURTOL+1
9766 3105                             leay    5,x             ; הגדלים, באותו סדר
9768 30E4                             leax    ,s              ; X = האינדקסים
976A EC81             1               ldd     ,x++            ; האינדקס
976C 10A3A4                           cmpd    ,y
