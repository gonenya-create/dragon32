97E6 0D4F             1               tst     FACEXP          ; 0 = שקר, כל השאר אמת
97E8 2709                             beq     if_no
97EA 9DA5             if_do           jsr     <chrgot
97EC 1025F71C                         lbcs    goto1           ; מספר: GOTO
97F0 16F676                           lbra    gone3           ; פקודה
                      ; שקר: מחפשים ELSE באותה רמה — כל IF בדרך מוסיף רמה, וכל ELSE סוגר אחת. אין: מדלגים על השורה
97F3 0F04             if_no           clr     IFCNT
97F5 9EA6                             ldx     TXTPTR
