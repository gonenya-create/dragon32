                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
BE9F 3031323334353637 KEYMAP          fcc     "01234567"
BEA7 38393A3B2C2D2E2F                 fcc     "89:;,-./"
BEAF 4041424344454647                 fcc     "@ABCDEFG"
BEB7 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
BEBF 5051525354555657                 fcc     "PQRSTUVW"
BEC7 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
BECF 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
BED7 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
BEDF 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
                      ; הטבלה ($0151-$0159) שומרת את מה שנקרא מ-PIA0 כמו במקור: מקש לחוץ = 0, וביט 7 דולק (29.10). תוכנות קוראות אותה ישר:
                      ; SAS (Peaksoft) בודק PEEK(341)=223 לחץ למעלה, והטוען של Cricket כותב לשם $FF ו-$BF
BEE7 3414             keyindex        pshs    b,x
BEE9 8E0152                           ldx     #KPREV          ; KALL ($0151) צמוד לפניו: גישה דרך X חוסכת שני בתים (28.10)
BEEC 4F                               clra                    ; כל העמודות למטה, קריאה אחת. בלי שינוי מהפעם הקודמת: יוצאים מהר (קורא 2.10)
BEED B7FF02                           sta     PIA0+2          ; כתיבה בלי קריאה: CLR קורא קודם את $FF02, והקריאה מוחקת את דגל פסיקת השדה (Phantom Slayer קפא). אותם 7 מחזורים
BEF0 B6FF00                           lda     PIA0
BEF3 8A80                             ora     #$80            ; כמו במקור: מה שנקרא, וביט 7 דולק
BEF5 A11F                             cmpa    -1,x            ; KALL
BEF7 2762                             beq     ki_none
BEF9 A71F                             sta     -1,x
BEFB 6FE2                             clr     ,-s             ; KFOUND, במחסנית: 0 = אין; אחרת האינדקס בטבלה + 1
                      ; (1.11: המשתנים הזמניים עברו מ-$03F2-$03F5 למחסנית. הטוען של Donkey King (Microdeal) שומר שם נתונים,
                      ; והסריקה שלנו דרסה אותם: המקשים נקלטו רק לפעמים. סימן שהמקור לא משתמש בכתובות האלה)
BEFD CCFE00                           ldd     #$fe00          ; A = מסכת העמודה (0 = נסרקת), B = העמודה
BF00 B7FF02           ki_col          sta     PIA0+2
BF03 3402                             pshs    a               ; המסכה
BF05 A685                             lda     b,x             ; הקודם
BF07 3402                             pshs    a
BF09 B6FF00                           lda     PIA0
BF0C 8A80                             ora     #$80
BF0E A785                             sta     b,x             ; לסריקה הבאה, כמו במקור (לחוץ = 0)
BF10 43                               coma                    ; השורות הלחוצות עכשיו = 1 (ביט 7 = 0)
BF11 A4E0                             anda    ,s+             ; חדש = עכשיו וגם לא קודם (בקודם, לא לחוץ = 1)
BF13 C103                             cmpb    #3
BF15 2502                             blo     3F
BF17 843F                             anda    #$3f            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
BF19 6D61             3               tst     1,s             ; KFOUND (מעליו במחסנית: המסכה)
BF1B 2611                             bne     ki_next
BF1D 4D                               tsta
BF1E 270E                             beq     ki_next
BF20 3404                             pshs    b               ; העמודה
BF22 5C                               incb                    ; האינדקס + 1 = 8*שורה + עמודה + 1
BF23 44               4               lsra
BF24 2504                             bcs     5F
BF26 CB08                             addb    #8
BF28 20F9                             bra     4B
BF2A E762             5               stb     2,s             ; KFOUND
BF2C 3504                             puls    b
BF2E 3502             ki_next         puls    a               ; המסכה של העמודה הבאה
BF30 48                               lsla
BF31 4C                               inca
BF32 5C                               incb
BF33 C108                             cmpb    #8
BF35 25C9                             blo     ki_col
BF37 E6E0                             ldb     ,s+             ; KFOUND
BF39 2720                             beq     ki_none
BF3B 5A                               decb
BF3C A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C = 0 כשהוא לחוץ (לחוץ = 0 בטבלה)
BF3E 48                               lsla
BF3F 48                               lsla
BF40 8EBE9F                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF43 A685                             lda     b,x             ; התו
BF45 2714                             beq     ki_none
BF47 2516                             bcs     ki_low          ; בלי SHIFT
BF49 C110                             cmpb    #16
BF4B 2507                             blo     1F
BF4D 815E                             cmpa    #$5e            ; SHIFT+↑ = $5F (ב-EDIT: יציאה ממצב הוספה)
BF4F 260B                             bne     ki_out
BF51 4C                               inca
BF52 2008                             bra     ki_out
BF54 308838           1               leax    SHIFTED-KEYMAP,x        ; b < 16
BF57 A685                             lda     b,x
BF59 2001                             bra     ki_out
BF5B 4F               ki_none         clra
BF5C 4D               ki_out          tsta                    ; Z לפי התו
BF5D 3594                             puls    b,x,pc
                      ; אות בלי SHIFT כשהנעילה ($0149, ALLOCK) כבויה = 0: אות קטנה, כמו במקור (מפרט המסך 3א). בהדלקה $FF: אותיות גדולות.
                      ; ‏Donkey King (Microdeal) כותב 0 ל-$0149 ומחכה ל-'y' או 'n' קטנות (1.11)
BF5F 8141             ki_low          cmpa    #'A
BF61 25F9                             blo     ki_out
BF63 815A                             cmpa    #'Z
BF65 22F5                             bhi     ki_out
BF67 7D0149                           tst     $0149
BF6A 26F0                             bne     ki_out
BF6C 8A20                             ora     #$20
BF6E 20EC                             bra     ki_out
                      
                      ; getkey: מחכה למקש, ומחזיר את התו ב-A. כמו במקור: הבהוב (עם השהיה), ואז סריקה דרך $BBE5, ושוב.
                      ; מקש: $60 בתא הסמן, ורק אז הוא חוזר (קורא 2.5, 8.1)
BF70 3414             getkey          pshs    b,x
