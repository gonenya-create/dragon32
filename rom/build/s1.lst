BF66 25BA                             blo     ki_col
BF68 F603F2                           ldb     KFOUND
BF6B 2720                             beq     ki_none
BF6D 5A                               decb
BF6E A607                             lda     7,x             ; SHIFT לחוץ? (KPREV+7, שורה 6) → C
BF70 48                               lsla
BF71 48                               lsla
BF72 8EBEBF                           ldx     #KEYMAP         ; (LD לא משנה את C)
BF75 A685                             lda     b,x             ; התו
BF77 2714                             beq     ki_none
BF79 2413                             bcc     ki_out
BF7B C110                             cmpb    #16
BF7D 2507                             blo     1F
