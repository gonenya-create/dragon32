0003                  ARYCNT          equ     $03             ; מספר הממדים (קורא: COUNT)
00F2                  IDXTMP          equ     $f2             ; פנימי
00F4                  CURTOL          equ     $f4             ; פנימי: ההיסט המצטבר
00F6                  ARYREC          equ     $f6             ; פנימי: הרשומה
                      
                      ; ary: נקרא מ-ptrget כש-TXTPTR על '('. VARNAM ו-VALTYP כבר מוכנים. B: 0 = רגיל, 2 = DIM
96BE C402             ary             andb    #2              ; רק DIM (2) נחשב "DIM"; 0 ו-1: קריאה רגילה יוצרת מערך אוטומטי
96C0 9606                             lda     VALTYP
