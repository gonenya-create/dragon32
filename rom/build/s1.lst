                      ; Dragon 1982 BASIC — ניסוי שלב 1: חומרה, מסך ומקלדת.
                      ; מועתק מ-rom/src/boot.s (קוד שלנו, נכתב מאפס), בלי חלקי המפרש. משתני העבודה הוזזו לאזור $03EA-$03FC,
                      ; שהספרים מסמנים כפנוי, כדי לא לדרוך על הכתובות הקבועות של ה-Dragon.
BDA1                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
BDA1 8EFF00                           ldx     #PIA0
BDA4 C634                             ldb     #$34            ; CR: גישה לנתונים; CA2/CB2 פלט נמוך — בוררי הצליל, הצליל והמנוע כבויים (קורא: צליל 0.3)
BDA6 4F                               clra
BDA7 8D17                             bsr     piaddr          ; DDRA: הכול קלט
BDA9 86FF                             lda     #$ff
BDAB 8D11                             bsr     piaddr2         ; DDRB: הכול פלט
                                      ; PIA1: A = ה-DAC בביטים 2-7, ומדפסת בביט 1 (פלט); ביט 0 קלט הקלטת
BDAD 30881E                           leax    PIA1-PIA0-2,x
BDB0 86FE                             lda     #$fe
BDB2 8D0C                             bsr     piaddr
BDB4 6F84                             clr     ,x              ; $FF20 = 0
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
BDB6 86F8                             lda     #$f8
BDB8 8D04                             bsr     piaddr2
BDBA 8D0B                             bsr     txtmode         ; מצב טקסט, ערכת צבעים 0; SAM: מצב 0, המסך ב-$0400
BDBC 6EA4                             jmp     ,y              ; חוזרים דרך Y (קורא: ממשקים, הכניסה ב-$8000)
                      ; piaddr: CR (1,x) לגישה ל-DDR, DDR (,x) = A, ו-CR = B. piaddr2: אותו דבר לצד B (X עולה ב-2)
BDBE 3002             piaddr2         leax    2,x
BDC0 6F01             piaddr          clr     1,x
BDC2 A784                             sta     ,x
BDC4 E701                             stb     1,x
BDC6 39                               rts
                      ; txtmode: מצב טקסט (קורא: SAMALP). ב-$FF22 נשארים 3 הביטים התחתונים; SAM: מצב 0, המסך ב-$0400
BDC7 3412             txtmode         pshs    a,x
