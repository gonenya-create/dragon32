8195 10DE21                           lds     STKTOP          ; עריכה מנקה את המחסנית (mit: CLEARC/STKINI)
8198 6FE2                             clr     ,-s
819A 20E4                             bra     main
819C 1701FD           1               lbsr    crunch          ; פקודה ישירה: מכווצים ומבצעים (mit: MAIN, CRDONE)
819F 4F                               clra                    ; אחרי השורה: קישור 0000, כמו סוף תוכנית
81A0 5F                               clrb
