                      ; Dragon 1982 BASIC — ניסוי שלב 1 (20.10.2026)
                      ;
                      ; מה נבדק: האם הלב של BASIC-M6502 של Microsoft (רישיון MIT, ראו rom/mit/LICENSE) עובר טוב לשבב 6809,
                      ; ואיך הוא מתאים לסידור הזיכרון של ה-Dragon 32: שמירת שורה מכווצת, המצביעים בכתובות הקבועות, LIST ו-NEW.
                      ;
                      ; יומן מקור (שלב 1):
                      ;   mit  = תרגום ל-6809 של שגרה מ-rom/mit/m6502.asm (מצוין מספר השורה שם)
                      ;   ספר  = עובדה מהספרים, דרך docs/DRAGON-SPEC-*.md (מפת הזיכרון, טבלת המילים, כללי הכיווץ)
                      ;   קורא = עובדה מהדוח של "הקורא" (Codex) שגונן בדק, בלי קוד
                      ;   שלנו = נכתב כאן
                      ; הכותב (שיחת Dragon) לא ראה את הקוד של ה-Dragon.
                      ;
                      ; Portions of this file are translated from Microsoft BASIC-M6502 (m6502.asm),
                      ; Copyright (c) Microsoft Corporation, licensed under the MIT License (rom/mit/LICENSE).
                      
8000                                  org     $8000
8000                                  setdp   0
                      
0400                  SCREEN          equ     $0400
0600                  SCREND          equ     $0600
FF00                  PIA0            equ     $ff00
FF20                  PIA1            equ     $ff20
FFC0                  SAM             equ     $ffc0
                      
                      ; ---------- כתובות קבועות של ה-Dragon (ספר: Companion, PRG) ----------
0019                  TXTTAB          equ     $19             ; תחילת התוכנית
001B                  VARTAB          equ     $1b             ; תחילת המשתנים
001D                  ARYTAB          equ     $1d             ; תחילת המערכים
001F                  STREND          equ     $1f             ; סוף המערכים
0021                  STKTOP          equ     $21             ; גבול המחסנית והמחרוזות
0023                  FRETOP          equ     $23
0027                  MEMSIZ          equ     $27
002B                  LINNUM          equ     $2b             ; מספר שורה (קורא: שימוש במקור)
0088                  CURSOR          equ     $88             ; כתובת הסמן (ספר)
008F                  CBLCNT          equ     $8f             ; מונה ההבהוב של הסמן (קורא: 50 בהדלקה)
0112                  TICKS           equ     $0112           ; TIMER (ספר: Inside)
                      
                      ; ---------- משתני הניסוי, באזור שהספרים מסמנים כפנוי ----------
03EA                  KPREV           equ     $03ea           ; 8 בתים
03F2                  KFOUND          equ     $03f2
03F3                  KNEW            equ     $03f3
03F4                  KROW            equ     $03f4
03F5                  KCOL            equ     $03f5
03F6                  LOWTR           equ     $03f6           ; 2 בתים (השם מ-mit)
03F8                  CRMODE          equ     $03f8           ; כיווץ: 0 רגיל, 1 אחרי DATA
03F9                  KPRE            equ     $03f9           ; קידומת המילה שנמצאה: 0 פקודה, $FF פונקציה
03FA                  LEND            equ     $03fa           ; 2 בתים: סוף טווח LIST
03FC                  LASTKEY         equ     $03fc
                      
00F8                  KQPTR           equ     $f8             ; רק לבדיקות: המקש הבא בתור המוקלד (התור עצמו ב-ROM, testq)
00FA                  KQCNT           equ     $fa             ; כמה מקשים נשארו, 2 בתים (באזור הפנוי $EA-$FF, קורא)
02DD                  LINBUF          equ     $02dd           ; מאגר השורה (קורא: BUF ב-$02DD)
00F9                  LINMAX          equ     249
02DC                  CRB             equ     $02dc           ; השורה המכווצת: במקום, בתוך מאגר השורה, בית אחד לפני הקלט (קורא: קלטת 11).
                                                              ; הגרש (1 → 2 בתים) קורה פעם אחת לכל היותר, ובית הפתיחה מספיק
7F36                  STACKINI        equ     $7f36
0071                  RSTFLG          equ     $71             ; $55: ‏RESET חוזר ל-BASIC (קורא: מדפסת 3.5)
0072                  RSTVEC          equ     $72             ; לאן חוזרים ב-RESET
015E                  HOOKS           equ     $015e           ; 25 נקודות חיבור, 3 בתים כל אחת (קורא: מדפסת 3.6)
012A                  DESC1           equ     $012a           ; מתאר הפקודות השני (קורא 3.2)
                      ; נקודות החיבור לפי הסדר (קורא: מדפסת 3.6). כל אחת נקראת ב-JSR, ובהדלקה חוזרת מיד
015E                  HK_OPEN         equ     $015e           ; 1 OPEN
0161                  HK_DEVN         equ     $0161           ; 2 בדיקת מספר ההתקן (Z=1 מקבל)
0164                  HK_DEVP         equ     $0164           ; 3 פרמטרי ההתקן
0167                  HK_COUT         equ     $0167           ; 4 פלט תו
016A                  HK_CIN          equ     $016a           ; 5 קלט תו
016D                  HK_CKIN         equ     $016d           ; 6 פתוח לקריאה?
0170                  HK_CKOUT        equ     $0170           ; 7 פתוח לכתיבה?
0173                  HK_CLALL        equ     $0173           ; 8 סגירת הכול
0176                  HK_CLONE        equ     $0176           ; 9 סגירת התקן
0179                  HK_STMT         equ     $0179           ; 10 משגר הפקודות
017C                  HK_INPQ         equ     $017c           ; 11 INPUT לפני "??"
017F                  HK_LBRK         equ     $017f           ; 12 BREAK ב-LIST
0182                  HK_LINE         equ     $0182           ; 13 קלט שורה
0185                  HK_AEOF         equ     $0185           ; 14 סוף קובץ בטעינת ASCII
0188                  HK_EOF          equ     $0188           ; 15 EOF(
018B                  HK_OPND         equ     $018b           ; 16 ערך בביטוי
018E                  HK_ERR1         equ     $018e           ; 17 שגיאה (B = הקוד)
0191                  HK_ERR2         equ     $0191           ; 18 שגיאה, השנייה
0194                  HK_RUN          equ     $0194           ; 19 RUN
0197                  HK_STR          equ     $0197           ; 20 מחרוזת קבועה / ניקוי המשתנים
019A                  HK_NEWS         equ     $019a           ; 21 לפני כל פקודה
019D                  HK_SASG         equ     $019d           ; 22 השמת מחרוזת
01A0                  HK_MISC         equ     $01a0           ; 23 CLS, RENUM, GET/PUT, השמה לפונקציה
01A3                  HK_CRUN         equ     $01a3           ; 24 כיווץ
01A6                  HK_DECR         equ     $01a6           ; 25 פתיחת שורה (LIST, EDIT)           ; ספר: STKTOP אחרי ההדלקה
                      
                      ; ---------- הכניסות הקבועות ב-$8000 (docs/DRAGON-SPEC-INTERFACES.md 3ג, DRAGON-SPEC-TAPE.md 1.10) ----------
8000 7EBDA1                           jmp     hw_init         ; $8000 אתחול חומרה (חוזר דרך Y)
8003 7E805A                           jmp     swinit          ; $8003 אתחול תוכנה
8006 7EBF1B                           jmp     inkey           ; $8006 מקלדת
8009 7EBF4A                           jmp     blink           ; $8009 הבהוב הסמן
800C 7EBDF8                           jmp     putc            ; $800C פלט למסך
800F 7EBB90                           jmp     prtout          ; $800F פלט למדפסת
8012 7E9D0E                           jmp     joyrd           ; $8012 ג'ויסטיקים
8015 7EB6B5                           jmp     tmoton          ; $8015 מנוע דולק
8018 7EB6C4                           jmp     motoff          ; $8018 מנוע כבוי
801B 7EB730                           jmp     tleader         ; $801B מבוא קלטת
801E 7EB6CF           twslot          jmp     twbyte          ; $801E בית לקלטת
8021 7EB80B                           jmp     tsync           ; $8021 סנכרון קריאה
8024 7EB7A4                           jmp     trbyte          ; $8024 בית מהקלטת
8027 7EB78E                           jmp     trbit           ; $8027 ביט מהקלטת
802A 7EBDE7                           jmp     noserv          ; $802A-$8030 תקשורת: אין ב-Dragon 32
802D 7EBDE7                           jmp     noserv
8030 7EBDE7                           jmp     noserv
                      
                      ; ---------- הפעלה ----------
8033 1A50             reset           orcc    #$50
8035 B7FFDA                           sta     SAM+26
8038 B7FFDD                           sta     SAM+29
803B 10CE7F36                         lds     #STACKINI
803F 318C03                           leay    rst2,pcr
8042 163D5C                           lbra    hw_init
                      ; rst2: אחרי אתחול החומרה, בכל הדלקה ואיפוס: פסיקת המחסנית דולקת ($FF23 = $37). אחר כך התחלה חמה, אם
                      ; RSTFLG = $55 והבית בכתובת שב-RSTVEC הוא NOP ($12); אחרת התחלה קרה (קורא: מדפסת 3.5, 7.3, 7.4)
8045 8637             rst2            lda     #$37
8047 B7FF23                           sta     PIA1+3
804A 9671                             lda     RSTFLG
804C 8155                             cmpa    #$55
804E 260A                             bne     swinit
8050 9E72                             ldx     RSTVEC
8052 A684                             lda     ,x
8054 8112                             cmpa    #$12
8056 2602                             bne     swinit
8058 6E84                             jmp     ,x
805A 1A50             swinit          orcc    #$50
805C 10CE7F36                         lds     #STACKINI
8060 8E0400                           ldx     #$0400          ; ניקוי ראשון של $0000-$03FF (קורא: "הניקוי הראשוני")
8063 6F82             1               clr     ,-x
8065 3084                             leax    ,x
8067 26FA                             bne     1B
8069 6FE2                             clr     ,-s             ; סמן תחתית למחסנית ה-FOR/GOSUB (קורא: ב-STKTOP-1)
806B 8639                             lda     #$39            ; קורא (קלטת 11): $02D9 לא אפס, קישור דמה לפני מספר השורה
806D B702D9                           sta     $02d9
8070 318D008D                         leay    initab,pcr      ; טבלת ההעתקות: קריאת התו, הסמן והקלטת, זרע ה-RND
8074 E6A0             1               ldb     ,y+             ; כמה (0 = סוף)
8076 270D                             beq     3F
8078 AEA1                             ldx     ,y++            ; מאיפה
807A EEA1                             ldu     ,y++            ; לאן
807C A680             2               lda     ,x+
807E A7C0                             sta     ,u+
8080 5A                               decb
8081 26F9                             bne     2B
8083 20EF                             bra     1B
8085 8E015E           3               ldx     #HOOKS          ; 25 נקודות החיבור: RTS RTS RTS (קורא: מדפסת 3.6)
8088 8639                             lda     #$39
808A A780             4               sta     ,x+
808C 8C01A9                           cmpx    #HOOKS+75
808F 26F9                             bne     4B
8091 308D013E                         leax    err_sn,pcr      ; מתאר הפקודות השני: בלי מילים, והקפיצות שלו ל-?SN (קורא 3.2)
8095 BF012D                           stx     DESC1+3
8098 BF0132                           stx     DESC1+8
809B B6FF02                           lda     PIA0+2
809E 8635                             lda     #$35            ; פסיקת השדה; CB2 (SEL2) נשאר פלט נמוך (קורא: צליל 0.3)
80A0 B7FF03                           sta     PIA0+3
80A3 173D42                           lbsr    cls
80A6 308D3EBB                         leax    testq,pcr       ; תור הבדיקות: אורך וכתובת. ב-ROM האמיתי 0; בבדיקות התור במחסנית ב-$C000
80AA EC84                             ldd     ,x
80AC DDFA                             std     KQCNT
80AE AE02                             ldx     2,x
80B0 9FF8                             stx     KQPTR
                                      ; מצב ההדלקה (ספר): תוכנית ב-$1E01, אפס ב-$1E00, גבולות הזיכרון והמחרוזות
                                      ; (FRETOP ו-TEMPPT: נקבעים ב-scrtch/runc)
80B2 8E1E01                           ldx     #$1e01
80B5 9F19                             stx     TXTTAB
80B7 6F1F                             clr     -1,x
80B9 CC7FFE                           ldd     #$7ffe          ; קורא: גבול ה-RAM
80BC DD27                             std     MEMSIZ
80BE DD74                             std     ENDMEM
80C0 C636                             ldb     #$36            ; $7F36
80C2 DD21                             std     STKTOP
80C4 860C                             lda     #$0c            ; קורא: מצב הגרפיקה בהדלקה — PMODE 0, דף 1, דפים מ-$0600
80C6 97B7                             sta     SCTOP           ; $0C00 (הבית התחתון כבר 0)
80C8 44                               lsra
80C9 97BC                             sta     SCRBAS          ; $06
80CB 97BA                             sta     GSTART          ; הדף הנוכחי: $0600 (קורא 0.2)
80CD CC0310                           ldd     #$0310          ; כתיבה 3, 16 בתים בשורה (הרקע 0: ה-RAM נוקה)
80D0 97B2                             sta     GFORE
80D2 D7B9                             stb     GROWB
80D4 1729B5                           lbsr    gfxrun
80D7 8E0134                           ldx     #USRTAB         ; קורא: טבלת USR, עשר כתובות שמובילות ל-?FC
80DA 9FB0                             stx     USTBAD
80DC 338D00FC                         leau    err_fc,pcr
80E0 C60A                             ldb     #10
80E2 EF81             1               stu     ,x++
80E4 5A                               decb
80E5 26FB                             bne     1B
80E7 308D197D                         leax    execrts,pcr     ; EXEC בלי כתובת אחרי ההדלקה: אצלנו חוזר מיד (ב-Dragon: פתוח)
80EB 9F9D                             stx     EXECJP
80ED 17026B                           lbsr    scrtch
80F0 8655                             lda     #$55            ; מעכשיו RESET חוזר ל-OK והתוכנית נשמרת
80F2 9771                             sta     RSTFLG
80F4 308C46                           leax    warm,pcr
80F7 9F72                             stx     RSTVEC
80F9 1CAF                             andcc   #$af            ; IRQ ו-FIRQ פתוחות, ממש לפני הכותרת (קורא 7.3)
80FB 308D04FF                         leax    banner,pcr      ; הכותרת ומיד אחריה OK (אחרי 13 אין שורה חדשה נוספת)
80FF 207C                             bra     mo_puts
                      ; initab: [כמה][מאיפה][לאן], 0 בסוף. אזורי ה-RAM האלה לא נוגעים זה בזה ולא בפסיקה, אז הסדר לא משנה
8101 0C               initab          fcb     12              ; קריאת התו ל-RAM ($9F-$AA)
8102 8CBD009F                         fdb     chrtpl,chrget
8106 0D                               fcb     13              ; הסמן, הקלטת, המקלדת והמדפסת: ל-$8F-$9B (קורא: קלטת 0.3, מדפסת 1.5, 7.1)
8107 B863008F                         fdb     tdefs,CBLCNT
810B 1E                               fcb     30              ; $010C-$0129: הפסיקות, TIMER, זרע ה-RND, מתאר הפקודות (קורא: מדפסת 3.2)
810C 8116010C                         fdb     lowtab,$010c
8110 09                               fcb     9               ; $0148-$0150: שורה חדשה אוטומטית, נעילה, ורצף סוף השורה למדפסת (קורא 1.5)
8111 81340148                         fdb     lptab,$0148
8115 00                               fcb     0
8116 7EBF69           lowtab          jmp     irq             ; $010C IRQ
8119 7E815B                           jmp     firq            ; $010F FIRQ
811C 000000                           fcb     0,0,0           ; $0112 TIMER
811F 804FC75259                       fcb     $80,$4f,$c7,$52,$59     ; $0115 זרע ה-RND
8124 0000000000                       fcb     0,0,0,0,0       ; $011A-$011E
8129 00                               fcb     0               ; $011F: ב-Dragon 64 ‏5 (קצב חזרת מקש); ב-32 פתוח, כנראה 0 (קורא 3.2)
812A 4E                               fcb     78              ; $0120 מתאר 0: מילות הפקודה ($80-$CD)
812B 862E8D5F                         fdb     stmtab,stmtbl
812F 22                               fcb     34              ; מילות הפונקציה ($FF $80-$A1)
8130 87509286                         fdb     fntab,fntbl
8134 FFFF010D0A000000 lptab           fcb     $ff,$ff,1,13,10,0,0,0,0
     00
                      ; warm: ההתחלה החמה (קורא 7.4): התוכנית, המשתנים, TRON, הקבצים, המדפסת ו-$0100-$01FF נשמרים
813D 12               warm            nop                     ; ה-NOP שהאיפוס בודק
813E 4F                               clra
813F 5F                               clrb
