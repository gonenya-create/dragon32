                      ; Dragon 1982 BASIC: שלד ה-ROM (ניסוי שלב 0, 17.10.2026)
                      ; נטען במקום ה-ROM המקורי של ה-Dragon 32 ($8000-$BFFF, 16K). כל הקוד כאן נכתב מאפס.
                      ; כרגע: אתחול החומרה, מסך טקסט, הודעת פתיחה, ושורת קלט פשוטה.
                      
8000                                  org     $8000
8000                                  setdp   0
                      
0400                  SCREEN          equ     $0400           ; מסך הטקסט: 32 על 16
0600                  SCREND          equ     $0600
FF00                  PIA0            equ     $ff00           ; מקלדת
FF20                  PIA1            equ     $ff20           ; מצב תצוגה, צליל
FFC0                  SAM             equ     $ffc0
7F00                  STACK           equ     $7f00           ; מחסנית המעבד יורדת מכאן (עד $7E00)
                      
                      ; משתנים בזיכרון (עמוד אפס של ה-DP=0)
0088                  CURSOR          equ     $0088           ; כתובת הסמן במסך (2 בתים)
008A                  LASTKEY         equ     $008a           ; (לא בשימוש)
00B0                  KFOUND          equ     $b0
00B1                  KNEW            equ     $b1
00B2                  KROW            equ     $b2
00B3                  KCOL            equ     $b3
00D2                  TICKS           equ     $d2             ; שעון: עולה ב-1 בכל תמונה (50 בשנייה), בפסיקה. TIMER קורא אותו
00B8                  KPREV           equ     $b8             ; מצב המקלדת בסריקה הקודמת: 8 עמודות ($B8-$BF)
0100                  KEYQ            equ     $0100           ; תור קלט לבדיקות: [אורך][תווים]. כלי הבדיקה כותב לכאן במקום ללחוץ מקשים
0200                  LINBUF          equ     $0200           ; השורה שהוקלדה (עד 249 תווים + 0)
00F9                  LINMAX          equ     249
                      
8000 1A50             reset           orcc    #$50            ; בלי פסיקות
                                      ; קודם גודל הזיכרון: אחרי איפוס ה-SAM במצב 4K, והמחסנית לא הייתה עובדת (M0=0, M1=1: שבבי 64K)
8002 B7FFDA                           sta     SAM+26          ; M0=0
8005 B7FFDD                           sta     SAM+29          ; M1=1
8008 10CE7F00                         lds     #STACK
800C 4F                               clra
800D 1F8B                             tfr     a,dp
800F 17006C                           lbsr    hw_init
8012 CC0000                           ldd     #0
8015 DDD2                             std     TICKS
                                      ; פסיקה בכל תמונה (קצה ה-FS של ה-VDG, דרך PIA0 CB1), ומאפשרים פסיקות
8017 B6FF02                           lda     PIA0+2          ; מנקים דגל ישן
801A 8605                             lda     #$05            ; CRB: פסיקה מ-CB1 + גישה לנתונים
801C B7FF03                           sta     PIA0+3
801F 1CEF                             andcc   #$ef
8021 1700A1                           lbsr    cls
                                      ; תור הקלט: מתחיל ממה שבטבלה testq (ריקה ב-ROM הרגיל; כלי הבדיקה בונה עותק עם שורות מוקלדות)
8024 308D3D0A                         leax    testq,pcr
8028 CE0100                           ldu     #KEYQ
802B E684                             ldb     ,x
802D 5C                               incb
802E A680             1               lda     ,x+
8030 A7C0                             sta     ,u+
8032 5A                               decb
8033 26F9                             bne     1B
8035 170B6D                           lbsr    newprog
8038 CC0000                           ldd     #0
803B DDDA                             std     AUTON           ; AUTO כבוי
803D 0FDE                             clr     TRONF
803F 7F0340                           clr     $0340           ; מצב הגרפיקה (gfx.s) יאותחל בפעם הראשונה
8042 0F8A                             clr     LASTKEY
8044 CC0000                           ldd     #0
8047 DDB8                             std     KPREV
8049 DDBA                             std     KPREV+2
804B DDBC                             std     KPREV+4
804D DDBE                             std     KPREV+6
804F 308D00EA                         leax    banner,pcr
8053 1700DE                           lbsr    puts
8056 200C                             bra     main_ok
                      ; הלולאה הראשית: קוראים שורה ומבצעים אותה
8058 173574           main            lbsr    auto_line       ; AUTO: מספר השורה כבר כתוב (B = כמה תווים)
805B 170217                           lbsr    getline_b
805E 17359A                           lbsr    auto_after
8061 170B62                           lbsr    execute
8064 171353           main_ok         lbsr    gfx_text        ; ההודעה OK תמיד על מסך הטקסט
8067 9689                             lda     CURSOR+1        ; אם הסמן לא בתחילת שורה (PRINT שנגמר ב-;), קודם שורה חדשה
8069 841F                             anda    #$1f
806B 2705                             beq     1F
806D 860D                             lda     #13
806F 170066                           lbsr    putc
8072 308C05           1               leax    ok,pcr
8075 1700BC                           lbsr    puts
8078 20DE                             bra     main
807A 4F4B             ok              fcc     "OK"
807C 0D00                             fcb     13,0
                      
                      ; ---------- חומרה ----------
807E                  hw_init
                                      ; PIA0: A = שורות המקלדת (קלט), B = עמודות (פלט)
807E 7FFF01                           clr     PIA0+1          ; CRA: גישה ל-DDR
8081 7FFF00                           clr     PIA0            ; DDRA: הכול קלט
8084 8604                             lda     #$04
8086 B7FF01                           sta     PIA0+1          ; CRA: חזרה לנתונים
8089 7FFF03                           clr     PIA0+3
808C 86FF                             lda     #$ff
808E B7FF02                           sta     PIA0+2          ; DDRB: הכול פלט
8091 8604                             lda     #$04
8093 B7FF03                           sta     PIA0+3
                                      ; PIA1: B = מצב ה-VDG (ביטים 3-7 פלט)
8096 7FFF23                           clr     PIA1+3
8099 86F8                             lda     #$f8
809B B7FF22                           sta     PIA1+2
809E 8604                             lda     #$04
80A0 B7FF23                           sta     PIA1+3
80A3 7FFF22                           clr     PIA1+2          ; מצב טקסט, ערכת צבעים 0
                                      ; SAM: מצב תצוגה טקסט (V0-V2=0), תחילת המסך ב-$0400 (F1=1)
80A6 B7FFC0                           sta     SAM+0           ; V0=0
80A9 B7FFC2                           sta     SAM+2           ; V1=0
80AC B7FFC4                           sta     SAM+4           ; V2=0
80AF B7FFC6                           sta     SAM+6           ; F0=0
80B2 B7FFC9                           sta     SAM+9           ; F1=1
80B5 B7FFCA                           sta     SAM+10          ; F2=0
80B8 B7FFCC                           sta     SAM+12          ; F3=0
80BB B7FFCE                           sta     SAM+14          ; F4=0
80BE B7FFD0                           sta     SAM+16          ; F5=0
80C1 B7FFD2                           sta     SAM+18          ; F6=0
80C4 39                               rts
                      
                      ; ---------- מסך ----------
80C5 8E0400           cls             ldx     #SCREEN
80C8 CC6060                           ldd     #$6060          ; רווח (ירוק)
80CB ED81             1               std     ,x++
80CD 8C0600                           cmpx    #SCREND
80D0 25F9                             blo     1B
80D2 8E0400                           ldx     #SCREEN
80D5 9F88                             stx     CURSOR
80D7 39                               rts
                      
                      ; putc: התו ב-A (ASCII) למסך במקום הסמן. 13 = שורה חדשה
80D8 3416             putc            pshs    a,b,x
80DA 810D                             cmpa    #13
80DC 2722                             beq     newline
80DE 8140                             cmpa    #$40
80E0 2404                             bhs     1F
80E2 8B40                             adda    #$40            ; ASCII $20-$3F → קוד VDG $60-$7F
80E4 200A                             bra     2F
80E6 8160             1               cmpa    #$60
80E8 2506                             blo     2F
80EA 8180                             cmpa    #$80
80EC 2402                             bhs     2F
80EE 8020                             suba    #$20            ; אותיות קטנות → גדולות
80F0 9E88             2               ldx     CURSOR
80F2 A780                             sta     ,x+
80F4 9F88                             stx     CURSOR
80F6 8C0600                           cmpx    #SCREND
80F9 2517                             blo     putc_done
80FB 170016                           lbsr    scroll
80FE 2012                             bra     putc_done
8100 DC88             newline         ldd     CURSOR
8102 C30020                           addd    #32
8105 C4E0                             andb    #$e0
8107 DD88                             std     CURSOR
8109 10830600                         cmpd    #SCREND
810D 2503                             blo     putc_done
810F 170002                           lbsr    scroll
8112 3596             putc_done       puls    a,b,x,pc
                      
                      ; scroll: כל השורות עולות אחת, והאחרונה מתנקה
8114 3416             scroll          pshs    d,x
8116 8E0400                           ldx     #SCREEN
8119 EC8820           1               ldd     32,x
811C ED81                             std     ,x++
811E 8C05E0                           cmpx    #SCREND-32
8121 25F6                             blo     1B
8123 CC6060                           ldd     #$6060
8126 ED81             2               std     ,x++
8128 8C0600                           cmpx    #SCREND
812B 25F9                             blo     2B
812D 8E05E0                           ldx     #SCREND-32
8130 9F88                             stx     CURSOR
8132 3596                             puls    d,x,pc
                      
                      ; puts: מחרוזת ב-X שמסתיימת ב-0
8134 A680             puts            lda     ,x+
8136 2704                             beq     1F
8138 8D9E                             bsr     putc
813A 20F8                             bra     puts
813C 39               1               rts
                      
813D 445241474F4E2031 banner          fcc     "DRAGON 1982 BASIC 1.0"
     3938322042415349
     4320312E30
8152 0D                               fcb     13
8153 2843292032303236                 fcc     "(C) 2026 GONEN YAROM"
     20474F4E454E2059
     41524F4D
8167 0D0D00                           fcb     13,13,0
                      
                      ; ---------- מקלדת ----------
                      ; מטריצת המקלדת של ה-Dragon: עמודה = ביט ב-PIA0 B (פלט, 0 = נסרקת), שורה = ביט ב-PIA0 A (קלט, 0 = לחוץ)
                      ; שורה 0: 0-7, שורה 1: 8 9 : ; , - . /, שורה 2: @ A-G, שורה 3: H-O, שורה 4: P-W,
                      ; שורה 5: X Y Z ↑ ↓ ← → רווח, שורה 6: ENTER CLEAR BREAK, ו-SHIFT בעמודה 7
816A 3031323334353637 KEYMAP          fcc     "01234567"
8172 38393A3B2C2D2E2F                 fcc     "89:;,-./"
817A 4041424344454647                 fcc     "@ABCDEFG"
8182 48494A4B4C4D4E4F                 fcc     "HIJKLMNO"
818A 5051525354555657                 fcc     "PQRSTUVW"
8192 58595A5E0A080920                 fcb     'X,'Y,'Z,$5e,$0a,$08,$09,$20
819A 0D0C030000000000                 fcb     13,12,3,0,0,0,0,0
81A2 3021222324252627 SHIFTED         fcc     "0!\"#$%&'"             ; SHIFT על 0-7
81AA 28292A2B3C3D3E3F                 fcc     "()*+<=>?"                      ; SHIFT על השורה השנייה
                      
                      ; keyindex: סריקה מלאה. מחזיר ב-A את התו של מקש שנלחץ עכשיו (לא היה לחוץ בסריקה הקודמת), או 0.
                      ; משווים כל עמודה לסריקה הקודמת (KPREV), כך שמקש חדש נקלט גם כשהקודם עדיין לחוץ (הקלדה מהירה)
81B2 3434             keyindex        pshs    b,x,y
81B4 108E816A                         ldy     #KEYMAP
81B8 0FB0                             clr     KFOUND          ; 0 = אין; אחרת האינדקס בטבלה + 1
81BA 5F                               clrb                    ; עמודה
81BB 8601             ki_col          lda     #1
81BD 3404                             pshs    b
81BF 5D                               tstb
81C0 2704                             beq     2F
81C2 48               1               lsla
81C3 5A                               decb
81C4 26FC                             bne     1B
81C6 43               2               coma
81C7 B7FF02                           sta     PIA0+2
81CA 3504                             puls    b
81CC B6FF00                           lda     PIA0
81CF 43                               coma
81D0 847F                             anda    #$7f            ; השורות הלחוצות עכשיו
81D2 8E00B8                           ldx     #KPREV
81D5 3402                             pshs    a
81D7 A685                             lda     b,x
81D9 43                               coma
81DA A4E4                             anda    ,s              ; חדש = עכשיו וגם לא קודם
81DC 97B1                             sta     KNEW
81DE 3502                             puls    a
81E0 A785                             sta     b,x             ; לסריקה הבאה
81E2 C103                             cmpb    #3
81E4 2506                             blo     3F
81E6 96B1                             lda     KNEW            ; שורה 6 היא תו רק בעמודות 0-2 (ENTER, CLEAR, BREAK). SHIFT לא
81E8 843F                             anda    #$3f
81EA 97B1                             sta     KNEW
81EC 0DB0             3               tst     KFOUND
81EE 261B                             bne     ki_next
81F0 96B1                             lda     KNEW
81F2 2717                             beq     ki_next
81F4 0FB2                             clr     KROW            ; השורה הנמוכה שנלחצה
81F6 44               4               lsra
81F7 2504                             bcs     5F
81F9 0CB2                             inc     KROW
81FB 20F9                             bra     4B
81FD D7B3             5               stb     KCOL
81FF 96B2                             lda     KROW
8201 C608                             ldb     #8
8203 3D                               mul
8204 DBB3                             addb    KCOL
8206 5C                               incb
8207 D7B0                             stb     KFOUND
8209 D6B3                             ldb     KCOL
820B 5C               ki_next         incb
820C C108                             cmpb    #8
820E 25AB                             blo     ki_col
8210 D6B0                             ldb     KFOUND
8212 271A                             beq     ki_none
8214 5A                               decb
8215 A6A5                             lda     b,y             ; התו
8217 2715                             beq     ki_none
8219 3402                             pshs    a
821B 96BF                             lda     KPREV+7         ; SHIFT לחוץ? (עמודה 7, שורה 6)
821D 8540                             bita    #$40
821F 3502                             puls    a
8221 270C                             beq     ki_out
8223 C110                             cmpb    #16
8225 2408                             bhs     ki_out
8227 8E81A2                           ldx     #SHIFTED
822A A685                             lda     b,x
822C 2001                             bra     ki_out
822E 4F               ki_none         clra
822F 35B4             ki_out          puls    b,x,y,pc
                      
                      ; inkey: מקש בלי לחכות (INKEY$): מהתור, או מקש שנלחץ עכשיו. אין: A=0
8231 F60100           inkey           ldb     KEYQ
8234 260E                             bne     gk_pop
8236 16FF79                           lbra    keyindex
                      
                      ; getkey: מחכה למקש, מחזיר את התו ב-A. קודם תור הבדיקות (KEYQ), אחר כך המקלדת
8239 3414             getkey          pshs    b,x
823B F60100           gk_loop         ldb     KEYQ
823E 271A                             beq     gk_scan
8240 8D02                             bsr     gk_pop
