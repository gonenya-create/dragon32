8281 170056                           lbsr    cursor_off
8284 810D                             cmpa    #13
8286 273D                             beq     gl_done
8288 8108                             cmpa    #8
828A 2714                             beq     gl_back
828C 8103                             cmpa    #3
828E 2724                             beq     gl_brk
8290 8120                             cmpa    #$20
