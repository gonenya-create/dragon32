                      ; gk_pop: התו הראשון בתור, ומזיזים את השאר
8244 3414             gk_pop          pshs    b,x
8246 B60101                           lda     KEYQ+1          ; התו הראשון בתור, ומזיזים את השאר
8249 8E0101                           ldx     #KEYQ+1
824C E601             1               ldb     1,x
824E E780                             stb     ,x+
8250 8C01FA                           cmpx    #KEYQ+250
8253 25F7                             blo     1B
8255 7A0100                           dec     KEYQ
8258 3594                             puls    b,x,pc
825A 17FF55           gk_scan         lbsr    keyindex
825D 4D                               tsta
825E 2612                             bne     1F
                                      ; הסמן מהבהב: ריבוע שחור ורווח, בערך פעמיים בשנייה (לפי השעון)
8260 9E88                             ldx     CURSOR
8262 96D3                             lda     TICKS+1
8264 8410                             anda    #$10
8266 2704                             beq     2F
8268 8660                             lda     #$60
826A 2002                             bra     3F
826C 8680             2               lda     #$80
826E A784             3               sta     ,x
8270 20C9                             bra     gk_loop
8272                  1
8272 3594                             puls    b,x,pc
                      
                      ; getline: קורא שורה למאגר LINBUF (מסתיים ב-0). ← מוחק, ENTER מסיים. BREAK: שורה ריקה ו-C=1
8274 5F               getline         clrb
                      ; getline_b: כמו getline, אבל B תווים כבר נמצאים ב-LINBUF (ומוצגים)
8275 3414             getline_b       pshs    b,x
8277 8E0200                           ldx     #LINBUF
827A E6E4                             ldb     ,s
827C 170051           gl_key          lbsr    cursor_on
