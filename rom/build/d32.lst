                      ; ---------- PRINT USING ----------
                      ; PRINT USING "תבנית"; ביטוי [; ביטוי]...  שדות בתבנית:
                      ;   מספרים: # ספרה, . נקודה, , פסיקים בין אלפים, ** מילוי בכוכביות, $$ דולר צמוד, + בהתחלה או בסוף (סימן),
                      ;   - בסוף (מינוס אחרי המספר). מחרוזות: ! התו הראשון, % % רוחב קבוע. כל השאר נכתב כמו שהוא.
                      ;   התבנית חוזרת מההתחלה אם יש יותר ביטויים משדות. מספר שלא נכנס: % ואז המספר.
03F0                  PU_P            equ     $03f0           ; המקום בתבנית
03F2                  PU_E            equ     $03f2           ; סוף התבנית
03F4                  PU_W            equ     $03f4           ; כמה מקומות לפני הנקודה
03F5                  PU_D            equ     $03f5           ; ספרות אחרי הנקודה ($FF = בלי נקודה)
03F6                  PU_F            equ     $03f6           ; 1 פסיקים, 2 כוכביות, 4 דולר, 8 + בהתחלה, 16 + בסוף, 32 - בסוף
03F7                  PU_N            equ     $03f7           ; כמה ספרות
03F8                  PU_SG           equ     $03f8           ; המספר שלילי
03F9                  PU_WR           equ     $03f9           ; כבר חזרנו להתחלת התבנית
03FA                  PU_IP           equ     $03fa           ; ספרות לפני הנקודה
03EA                  PU_FAC          equ     $03ea           ; עותק של המספר (6 בתים)
03FB                  PU_S            equ     $03fb           ; תחילת התבנית
                      
