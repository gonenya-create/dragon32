82AA 8660                             lda     #$60
82AC A784                             sta     ,x
82AE 9F88                             stx     CURSOR
82B0 3510                             puls    x
82B2 20C8                             bra     gl_key
82B4                  gl_brk          ; BREAK בזמן הקלדה: השורה מתבטלת, וגם AUTO
82B4 CC0000                           ldd     #0
82B7 DDDA                             std     AUTON
82B9 5F                               clrb
82BA 860D                             lda     #13
82BC 17FE19                           lbsr    putc
82BF 6F84                             clr     ,x
82C1 3594                             puls    b,x,pc
82C3 6F85             gl_done         clr     b,x
82C5 860D                             lda     #13
82C7 17FE0E                           lbsr    putc
82CA 3594                             puls    b,x,pc
                      
                      ; הסמן: ריבוע מלא במקום הבא במסך
82CC 3412             cursor_on       pshs    a,x
82CE 9E88                             ldx     CURSOR
82D0 8680                             lda     #$80            ; ריבוע שחור
82D2 A784                             sta     ,x
82D4 3592                             puls    a,x,pc
82D6 3412             cursor_off      pshs    a,x
82D8 9E88                             ldx     CURSOR
82DA 8660                             lda     #$60
82DC A784                             sta     ,x
82DE 3592                             puls    a,x,pc
                      
82E0                                  include "fp.s"
                      ; Dragon 1982 BASIC: חבילת המספרים (נקודה צפה)
                      ; הפורמט והאלגוריתמים לפי BASIC-M6502 של Microsoft (רישיון MIT, ראו rom/LICENSE-MSBASIC):
                      ; מעריך עם היסט 128 (0 = אפס), מנטיסה של 32 ביט שהביט העליון שלה תמיד 1, והסימן בנפרד.
                      ; זה אותו פורמט של 5 בתים שבו ה-Dragon שומר מספרים. הקוד עצמו נכתב מחדש ל-6809.
                      ;
                      ; שני "אוגרים" בזיכרון: FAC (הצובר) ו-ARG (הארגומנט). כל אחד: מעריך, 4 בתי מנטיסה, סימן (0 או $FF), ובית עיגול.
                      ; פעולה על שני מספרים: ARG <פעולה> FAC, והתוצאה ב-FAC. השגרות שומרות על X (מצביע הטקסט).
                      
0040                  FACEXP          equ     $40
0041                  FACM            equ     $41             ; 4 בתים, $41-$44
0045                  FACSGN          equ     $45
0046                  FACOV           equ     $46             ; בית העיגול (מתחת למנטיסה)
0048                  ARGEXP          equ     $48
0049                  ARGM            equ     $49
004D                  ARGSGN          equ     $4d
004E                  ARGOV           equ     $4e
0050                  FPT             equ     $50             ; 16 בתים זמניים ($50-$5F)
0060                  DEXP            equ     $60             ; מעריך עשרוני (FOUT, FIN)
0061                  DPT             equ     $61             ; FIN: ספרות אחרי הנקודה / יש נקודה
0062                  QN              equ     $62             ; מספר שלם של 32 ביט ($62-$65)
                      
                      ; ---------- העתקות ----------
                      ; fac2arg: ARG = FAC
82E0 3406             fac2arg         pshs    d
82E2 DC40                             ldd     FACEXP
82E4 DD48                             std     ARGEXP
82E6 DC42                             ldd     FACEXP+2
82E8 DD4A                             std     ARGEXP+2
82EA DC44                             ldd     FACEXP+4
82EC DD4C                             std     ARGEXP+4
82EE 3586                             puls    d,pc
                      ; arg2fac: FAC = ARG
82F0 3406             arg2fac         pshs    d
82F2 DC48                             ldd     ARGEXP
82F4 DD40                             std     FACEXP
