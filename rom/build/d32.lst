826E A784             3               sta     ,x
8270 20C9                             bra     gk_loop
8272                  1
8272 3594                             puls    b,x,pc
                      
                      ; getline: קורא שורה למאגר LINBUF (מסתיים ב-0). ← מוחק, ENTER מסיים
8274 5F               getline         clrb
                      ; getline_b: כמו getline, אבל B תווים כבר נמצאים ב-LINBUF (ומוצגים)
8275 3414             getline_b       pshs    b,x
8277 8E0200                           ldx     #LINBUF
827A E6E4                             ldb     ,s
827C 17004D           gl_key          lbsr    cursor_on
827F 8DB8                             bsr     getkey
8281 170052                           lbsr    cursor_off
8284 810D                             cmpa    #13
8286 273B                             beq     gl_done
