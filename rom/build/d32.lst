82B4 CC0000                           ldd     #0
82B7 DDDA                             std     AUTON
82B9 5F                               clrb
82BA 860D                             lda     #13
82BC 17FE19                           lbsr    putc
82BF 6F84                             clr     ,x
82C1 3594                             puls    b,x,pc
