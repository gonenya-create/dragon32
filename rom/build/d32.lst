82C5 860D                             lda     #13
82C7 17FE0E                           lbsr    putc
82CA 3594                             puls    b,x,pc
                      
                      ; הסמן: ריבוע מלא במקום הבא במסך
82CC 3412             cursor_on       pshs    a,x
82CE 9E88                             ldx     CURSOR
82D0 8680                             lda     #$80            ; ריבוע שחור
82D2 A784                             sta     ,x
82D4 3592                             puls    a,x,pc
